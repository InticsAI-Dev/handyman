process "paragraph.extraction.processor"
{
	try{

	        assign as "paragraph_timesStamp" source "intics_zio_db_conn"
	        using{"
	                SELECT now() as consumed_on_ts;
	        "} on-condition if "true"=="true"

	        assign as "pipeline_train_mode" source "intics_zio_db_conn" using
            {"
                    select  (case when '${paragraph.extraction.start.action}'='true' AND '${pipeline.train.mode}'='true' then 'true' else 'false' end) as paragraph_extraction;
            "}on-condition if "true"=="true"

	         transform as "Update to inprogress in payload queue" on "intics_zio_db_conn"
            using {"

                UPDATE paragraph_extraction.paragraph_extraction_payload_queue
                SET status='IN_PROGRESS', consumed_on_ts = '${paragraph_timesStamp.consumed_on_ts}', consumer_process_id = '${process-id}'
                WHERE group_id='${group_id}' AND status='STAGED' AND stage='PARAGRAPH_EXTRACTION' AND tenant_id = ${tenant_id}  and batch_id ='${batch_id}';

                update ingestion.pipeline_queue_status_audit as a
                set status = 'IN_PROGRESS' , consumed_on_ts=now(), consumer_process_id = '${process-id}'
                where  a.group_id=${group_id}
                and a.batch_id='${batch_id}' and a.tenant_id =${tenant_id} and a.stage ='PARAGRAPH_EXTRACTION' ;

                UPDATE batching.sub_batching_process_payload_queue a
                SET status='IN_PROGRESS',  stage='PARAGRAPH_EXTRACTION'
                WHERE a.group_id='${group_id}'  and a.tenant_id='${tenant_id}'
                and a.batch_id ='${batch_id}';

                INSERT INTO paragraph_extraction.paragraph_extraction_pipeline_audit
                (process_id, origin_id, group_id, created_on, status, stage, message,root_pipeline_id,tenant_id, batch_id)
                select producer_process_id,origin_id,group_id, now(),
                'STARTED', 'PARAGRAPH_EXTRACTION','PARAGRAPH EXTRACTION process STARTED for group_id ${group_id}','${gen_id.root_pipeline_id}', ${tenant_id}, '${batch_id}'
                FROM paragraph_extraction.paragraph_extraction_payload_queue
                WHERE group_id='${group_id}' AND status='IN_PROGRESS' AND stage='PARAGRAPH_EXTRACTION' AND tenant_id = ${tenant_id} and batch_id ='${batch_id}';

            "}on-condition if "true"=="true"


            coproStart as "Calling paragraph_extraction copro start action" for "PARAGRAPH_EXTRACTION"
            copro-server-url "${copro.paragraph.extraction.admin.start.url}"
            export-command "${copro.paragraph.extraction.export}"
            process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
            using
            {"
                ${paragraphExtractionStartCommand}

            "}on-condition if "${pipeline_train_mode.paragraph_extraction}"=="true"

            assign as "gen_directory" source "intics_zio_db_conn" using
            {"
                SELECT concat ('${target_directory_path}','/','${group_id}','/paragraph_extraction/') as paragraph_extraction_dest_path;

            "} on-condition if "true"=="true"

            createDirectory as "creating_directory" using
            {"
                ${gen_directory.paragraph_extraction_dest_path}
            "} on-condition if "true"=="true"


            transform as "insert into temporary table page wise input for the paragraph extraction" on "intics_zio_db_conn"
            using {"

                     INSERT INTO ${temp_schema_name}.paragraph_extraction_input_table_${process-id}
                    (origin_id, paper_no, group_id, file_path, tenant_id, output_dir, root_pipeline_id, process, synonym_id,prompt,section_header, batch_id)
                    select a.origin_id, b.paper_no, b.group_id, c.file_path, b.tenant_id, '${gen_directory.paragraph_extraction_dest_path}' as output_dir, a.root_pipeline_id, 'PARAGRAPH_EXTRACTION' as process,st.synonym_id ,sq.question,st.synonym, a.batch_id
                    from paragraph_extraction.paragraph_extraction_payload_queue a
                    join ${temp_schema_name}.source_of_truth_${init_process_id.process_id} b on a.origin_id=b.origin_id
                    join info.asset c on b.asset_id  =c.asset_id
                    join sor_meta.asset_info ai on b.document_type =ai.document_type and b.template_name =ai.template_name and b.tenant_id =ai.tenant_id
                    join sor_meta.truth_entity te on ai.asset_id =te.asset_id and te.sip_type ='PARAGRAPH_SIP'
                    join sor_meta.sor_tsynonym st on te.truth_entity_id =st.truth_entity_id
                    join sor_meta.sor_question sq on sq.synonym_id = st.synonym_id
                    where a.tenant_id=${tenant_id} and a.group_id=${group_id}
                    and ai.status='ACTIVE' and te.status='ACTIVE' and st.status='ACTIVE' and sq.status='ACTIVE' and a.batch_id ='${batch_id}'
                    and ai.document_type='${document_type}';

            "} on-condition if "${paragraph.extraction.paper.mode.input}"=="true"

            transform as "insert into temporary table pdf file input for the paragraph extraction" on "intics_zio_db_conn"
            using {"

                     INSERT INTO ${temp_schema_name}.paragraph_extraction_input_table_${process-id}
                    (origin_id, group_id, file_path, tenant_id, output_dir, root_pipeline_id, process, synonym_id,prompt,section_header, batch_id)
                     select a.origin_id, b.group_id, c.file_path, b.tenant_id, '${gen_directory.paragraph_extraction_dest_path}' as output_dir, a.root_pipeline_id, 'PARAGRAPH_EXTRACTION' as process,st.synonym_id ,sq.question,st.synonym, a.batch_id
                    from paragraph_extraction.paragraph_extraction_payload_queue a
                    join info.source_of_origin b on a.origin_id=b.origin_id
                    join info.source_of_truth sot on a.origin_id = sot.origin_id
                    join info.asset c on b.asset_id  =c.asset_id
                    join sor_meta.asset_info ai on ai.document_type='${document_type}' and sot.template_name =ai.template_name and b.tenant_id =ai.tenant_id
                    join sor_meta.truth_entity te on ai.asset_id =te.asset_id and te.sip_type ='PARAGRAPH_SIP'
                    join sor_meta.sor_tsynonym st on te.truth_entity_id =st.truth_entity_id
                    join sor_meta.sor_question sq on sq.synonym_id = st.synonym_id
                    where a.tenant_id=${tenant_id} and a.group_id=${group_id}   and ai.document_type='${document_type}'
                    and ai.status='ACTIVE' and te.status='ACTIVE' and st.status='ACTIVE' and sq.status='ACTIVE' and a.batch_id ='${batch_id}'
                    group by a.origin_id ,b.group_id, c.file_path, b.tenant_id,a.root_pipeline_id,st.synonym_id ,sq.question,st.synonym;
                "} on-condition if "${paragraph.extraction.paper.mode.input}"=="false"

            paragraph-extraction as "paragraph extraction macro"
            on-resource-conn "intics_zio_db_conn"
            outputDir "${gen_directory.paragraph_extraction_dest_path}"
            copro-url "${copro.paragraph-extraction.url}"
            output-table "paragraph_extraction.paragraph_extraction_result"
            using {"
                     SELECT origin_id, paper_no, group_id, file_path, tenant_id, process_id, output_dir, root_pipeline_id, process, synonym_id, prompt, section_header, batch_id
                    FROM ${temp_schema_name}.paragraph_extraction_input_table_${process-id}
                    where batch_id='${batch_id}';
            "} on-condition if "true"=="true"

				coproStop as "Calling paragraph_extraction copro stop action" for "PARAGRAPH_EXTRACTION"
				copro-server-url "${copro.paragraph.extraction.admin.stop.url}"
				process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
				using
				{"
						gunicorn

				"}on-condition if "${paragraph.extraction.stop.action}"=="true"


            transform as "insert into audit table for paragraph extraction" on "intics_zio_db_conn" using
            {"
                    insert into audit.process_audit_output
                    (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint, paper_no, batch_id)
                    select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint, ai.paper_no, '${batch_id}'
                    from paragraph_extraction.paragraph_extraction_result ai
                    where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id} and batch_id='${batch_id}'
                    group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage, ai.paper_no
            "}  on-condition if "true"=="true"



            transform as "Update to completed in payload queue" on "intics_zio_db_conn"
            using {"

                UPDATE paragraph_extraction.paragraph_extraction_payload_queue a
                SET status=b.status,stage=b.stage, consumed_on_ts = '${paragraph_timesStamp.consumed_on_ts}', consumer_process_id = '${init_process_id.process_id}'
                from paragraph_extraction.paragraph_extraction_result b
                WHERE a.origin_id=b.origin_id and a.status='IN_PROGRESS' and b.status='FAILED' and b.tenant_id = ${tenant_id} and b.batch_id ='${batch_id}';

                UPDATE paragraph_extraction.paragraph_extraction_payload_queue a
	                SET status=b.status, consumed_on_ts = '${paragraph_timesStamp.consumed_on_ts}', consumer_process_id = '${init_process_id.process_id}'
                from paragraph_extraction.paragraph_extraction_result b
                WHERE a.origin_id=b.origin_id and a.status='IN_PROGRESS' and b.status='COMPLETED' and b.tenant_id = ${tenant_id} and b.batch_id ='${batch_id}';


                UPDATE batching.sub_batching_process_payload_queue a
                SET status='COMPLETED',  stage='PARAGRAPH_EXTRACTION'
                WHERE a.group_id='${group_id}'  and a.tenant_id='${tenant_id}'
                and a.batch_id ='${batch_id}';

                INSERT INTO paragraph_extraction.paragraph_extraction_pipeline_audit
                (process_id, origin_id, group_id, created_on, status, stage, message, root_pipeline_id, tenant_id,batch_id)
                select producer_process_id,origin_id,group_id, now(),
                'COMPLETED', 'PARAGRAPH_EXTRACTION','hw classification process COMPLETED for group_id ${group_id}','${gen_id.root_pipeline_id}', ${tenant_id},batch_id
                 FROM paragraph_extraction.paragraph_extraction_payload_queue
                 WHERE group_id='${group_id}' AND status='COMPLETED' AND stage='PARAGRAPH_EXTRACTION' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';

            "}on-condition if "true"=="true"
	}
	catch{
	            transform as "Update to failed in payload queue" on "intics_zio_db_conn"
                using {"


                    UPDATE paragraph_extraction.paragraph_extraction_payload_queue
                    SET status='FAILED', consumed_on_ts = '${time_stamp_preprocess.consumed_on_ts}', consumer_process_id = '${init_process_id.process_id}'
                    WHERE group_id='${group_id}' AND status='IN_PROGRESS' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';

                    INSERT INTO paragraph_extraction.paragraph_extraction_pipeline_audit
                    (process_id, origin_id, group_id, created_on, status, stage, message,root_pipeline_id, tenant_id, batch_id)
                    select producer_process_id,origin_id,group_id, now(),
                    'FAILED', 'PARAGRAPH_EXTRACTION','paragraph_extraction FAILED for group_id ${group_id}','${gen_id.root_pipeline_id}', ${tenant_id}, '${batch_id}';


                    UPDATE batching.sub_batching_process_payload_queue a
                    SET status='FAILED',  stage='PARAGRAPH_EXTRACTION'
                    WHERE a.group_id='${group_id}'  and a.tenant_id='${tenant_id}'
                    and a.batch_id ='${batch_id}';

                "}on-condition if "true"=="true"
	}
	finally{
	            transform as "insert into pipeline summary audit paragraph_extraction" on "intics_zio_db_conn" using {"
					INSERT INTO ${temp_schema_name}.summary_audit_papers_${process-id}
                    (process_id ,module_name,macro_process,completed_count,failed_count,min_created_on,max_created_on,time_taken,root_pipeline_id, tenant_id, batch_id)
                    SELECT ${process-id} , 'PARAGRAPH_EXTRACTION' ,'HW_DETECTION',coalesce (sum(CASE WHEN status='COMPLETED' THEN 1 ELSE 0 END),0) ,coalesce (sum(CASE WHEN status='FAILED' THEN 1 ELSE 0 END),0),min(created_on),max(created_on), EXTRACT(epoch FROM (max(created_on)-min(created_on))),'${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                    FROM paragraph_extraction.paragraph_extraction_result WHERE group_id='${group_id}' and tenant_id = ${tenant_id}  and batch_id ='${batch_id}'
                    group by batch_id;

					INSERT INTO ${temp_schema_name}.summary_audit_files_${process-id}
                    (process_id ,module_name,macro_process,completed_count,failed_count,min_created_on,max_created_on,time_taken,root_pipeline_id, tenant_id, batch_id)
                    SELECT ${process-id} , 'PARAGRAPH_EXTRACTION' ,'HW_DETECTION',sum(CASE WHEN status='COMPLETED' THEN 1 ELSE 0 END) ,sum(CASE WHEN status='FAILED' THEN 1 ELSE 0 END),min(created_on),max(created_on), EXTRACT(epoch FROM (max(created_on)-min(created_on))),'${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                    FROM paragraph_extraction.paragraph_extraction_payload_queue WHERE group_id='${group_id}' and tenant_id = ${tenant_id} and batch_id ='${batch_id}'
                    group by batch_id;

					INSERT INTO audit.pipeline_summary_audit
                    (process_id, created_on, module_name, macro_process, files_processed_count,papers_processed_count,files_failed_count,papers_failed_count,start_time,end_time, time_taken, group_id, root_pipeline_id, created_user_id, template_id, tenant_id,average_time)
                    SELECT msaf.process_id ,now(),msaf.module_name ,msaf.macro_process ,msaf.completed_count,msap.completed_count,msaf.failed_count,msap.failed_count,msap.min_created_on,msap.max_created_on, EXTRACT(epoch FROM (msap.max_created_on-msap.min_created_on)),
                    '${group_id}','${root-ref-id}','${created_user_id}','${document_id}',${tenant_id},(CASE WHEN (msaf.completed_count+msaf.failed_count)=0 THEN msaf.time_taken WHEN (msaf.time_taken/(msaf.completed_count+msaf.failed_count))=0 THEN msaf.time_taken ELSE (msaf.time_taken/(msaf.completed_count+msaf.failed_count)) END)
                    FROM ${temp_schema_name}.summary_audit_files_${process-id} msaf,
                    ${temp_schema_name}.summary_audit_papers_${process-id} msap
                    WHERE msaf.module_name=msap.module_name AND msaf.macro_process=msap.macro_process AND
                    msaf.module_name='PARAGRAPH_EXTRACTION' AND msaf.macro_process='HW_DETECTION' AND msaf.tenant_id = ${tenant_id} and
                    msaf.batch_id='${batch_id}';

	             "} on-condition if "true"=="true"

                transform as "insert into noise model payload queue after completed" on "intics_zio_db_conn" using
                {"
                    INSERT INTO noise_model.noise_model_payload_queue
                    (producer_process_id ,
                    group_id,origin_id ,created_on, status,stage,last_updated_on ,root_pipeline_id,batch_id)
                    SELECT  producer_process_id ,group_id,origin_id, now(),'STAGED','NOISE_MODEL',now() ,'${gen_id.root_pipeline_id}', batch_id
                    FROM paragraph_extraction.paragraph_extraction_payload_queue
                    WHERE status = 'COMPLETED' and group_id=${group_id} and tenant_id = ${tenant_id} and batch_id ='${batch_id}';
                "}on-condition if "true"=="true"

	            transform as "moving to payload queue archive" on "intics_zio_db_conn"
                using {"


                        update ingestion.pipeline_queue_status_audit as a
                        set status = 'COMPLETED' , consumed_on_ts=now(), consumer_process_id = '${process-id}'
                        where  a.group_id=${group_id}
                        and a.batch_id='${batch_id}' and a.tenant_id =${tenant_id} and a.stage ='PARAGRAPH_EXTRACTION' ;

                        INSERT into paragraph_extraction.paragraph_extraction_payload_queue_archive(producer_process_id, consumer_process_id, origin_id,group_id, created_on,status, stage, consumed_on_ts, root_pipeline_id, tenant_id, batch_id)
                        SELECT producer_process_id, consumer_process_id, origin_id, group_id,created_on, status, stage,consumed_on_ts, root_pipeline_id, ${tenant_id}, batch_id
                        FROM paragraph_extraction.paragraph_extraction_payload_queue
                        where status='COMPLETED' and stage='PARAGRAPH_EXTRACTION' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';

                        Delete from paragraph_extraction.paragraph_extraction_payload_queue
                        where status='COMPLETED' and stage='PARAGRAPH_EXTRACTION' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';
                "}on-condition if "true"=="true"


                transform as "moving to payload error" on "intics_zio_db_conn"
                using {"
                        INSERT into paragraph_extraction.paragraph_extraction_payload_error_queue(producer_process_id, consumer_process_id, origin_id,group_id, created_on,status, stage, consumed_on_ts, root_pipeline_id, tenant_id, batch_id)
                        SELECT producer_process_id, consumer_process_id, origin_id, group_id,created_on, status, stage,consumed_on_ts, root_pipeline_id, ${tenant_id}, batch_id
                        FROM paragraph_extraction.paragraph_extraction_payload_queue
                        where status='FAILED' and stage='PARAGRAPH_EXTRACTION' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';

                        Delete from paragraph_extraction.paragraph_extraction_payload_queue
                        where status='FAILED' and stage='PARAGRAPH_EXTRACTION' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';
                "}on-condition if "true"=="true"



	}
}