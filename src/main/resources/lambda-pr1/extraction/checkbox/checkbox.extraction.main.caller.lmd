process "checkbox.extraction.main.caller"
{
try{
        assign as "time_stamp_checkbox_extraction" source "intics_zio_db_conn" using
        {"
                SELECT now() as consumed_on_ts;
        "} on-condition if "true"=="true"


        callprocess as "calling KVP extraction processor"
        with-target "checkbox.extraction.processor"
        from-file "${basepath}/extraction/checkbox/checkbox.extraction.processor.lmd"
        using "intics_zio_db_conn"
        for-every
        {"
               SELECT DISTINCT group_id, batch_id
               FROM checkbox_extraction.checkbox_extraction_payload_queue
               WHERE batch_id ='${batch_id}' and status='STAGED' AND stage='CHECKBOX_EXTRACTION'
                 and tenant_id = ${tenant_id} and group_id = '${gen_group_id.group_id}';
        "} on-condition if "true"=="true"



}
catch{
        transform as "failed in checkbox_extraction main caller" on "intics_zio_db_conn" using
        {"
                INSERT INTO checkbox_extraction.checkbox_extraction_pipeline_audit
                (process_id, group_id, created_on, status, stage, message,root_pipeline_id, tenant_id, batch_id )
                VALUES('${init_process_id.process_id}', '${gen_group_id.group_id}', now(), 'FAILED', 'CHECKBOX_EXTRACTION_MAIN_CALLER', 'failed in checkbox_extraction main caller','${gen_id.root_pipeline_id}', ${tenant_id}, '${batch_id}');
        "}on-condition if "true"=="true"

}
finally{
        transform as "completed in checkbox_extraction main caller" on "intics_zio_db_conn" using
        {"
                INSERT INTO checkbox_extraction.checkbox_extraction_pipeline_audit
                (process_id, group_id, created_on, status, stage, message,root_pipeline_id, tenant_id, batch_id)
                VALUES('${init_process_id.process_id}', '${gen_group_id.group_id}', now(), 'COMPLETED', 'CHECKBOX_EXTRACTION_MAIN_CALLER', 'completed in checkbox_extraction main caller','${gen_id.root_pipeline_id}', ${tenant_id}, '${batch_id}');
        "}on-condition if "true"=="true"

       transform as "Move to archive after completed" on "intics_zio_db_conn" using {"


                update ingestion.pipeline_queue_status_audit as a
                set status = 'IN_PROGRESS' , consumed_on_ts=now(), consumer_process_id = '${process-id}'
                where  a.group_id=${group_id}
                and a.batch_id='${batch_id}' and a.tenant_id =${tenant_id} and a.stage ='FACE_DETECTION' ;

           INSERT INTO checkbox_extraction.checkbox_extraction_payload_queue_archive
           (producer_process_id, consumer_process_id, origin_id,group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, batch_id)
           SELECT producer_process_id, consumer_process_id, origin_id, group_id, created_on, status, stage,consumed_on_ts, root_pipeline_id, ${tenant_id}, batch_id
           FROM checkbox_extraction.checkbox_extraction_payload_queue
           where status='COMPLETED' and stage='CHECKBOX_EXTRACTION'
           AND group_id='${group_id}' and tenant_id = ${tenant_id}
           and batch_id = '${batch_id}';

           Delete from checkbox_extraction.checkbox_extraction_payload_queue
        where status='COMPLETED' and stage='CHECKBOX_EXTRACTION' AND group_id='${group_id}' and tenant_id = ${tenant_id} and batch_id = '${batch_id}';
       "} on-condition if "true"=="true"

       transform as "Move to archive after failed" on "intics_zio_db_conn" using {"
               INSERT INTO checkbox_extraction.checkbox_extraction_payload_error_queue
               (producer_process_id, consumer_process_id, origin_id,group_id, created_on, status, stage, message, consumed_on_ts, root_pipeline_id, tenant_id, batch_id)
               SELECT producer_process_id, consumer_process_id,origin_id, group_id, created_on, status, stage, 'checkbox_extraction Processor failed for group_id ${group_id}',consumed_on_ts, root_pipeline_id, ${tenant_id}, batch_id
               FROM checkbox_extraction.checkbox_extraction_payload_queue
               where status='FAILED' AND group_id='${group_id}' AND tenant_id = ${tenant_id} and batch_id = '${batch_id}';

               Delete from checkbox_extraction.checkbox_extraction_payload_queue
               where status='FAILED' and stage='CHECKBOX_EXTRACTION' AND group_id='${group_id}' and tenant_id = ${tenant_id} and batch_id = '${batch_id}';
       "} on-condition if "true"=="true"
}
}