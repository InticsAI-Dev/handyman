process "outbound.builder.ddl"
{
     try{
            transform as "create outbound asis ddl" on "intics_zio_db_conn" using
            {"


                    CREATE TABLE if not exists outbound_asis.outbound_asis_payload_queue_archive
                    (
                    producer_process_id int8 NOT NULL,
                    consumer_process_id int8 NULL,
                    batch_id varchar NOT NULL,
                    group_id int4 NOT NULL,
                    origin_id varchar NOT NULL,
                    created_on timestamp NOT NULL,
                    status varchar NOT NULL,
                    stage  varchar NOT NULL,
                    consumed_on_ts timestamp NULL,
                    root_pipeline_id int8 NULL,
                    tenant_id int8 NULL,
                    CONSTRAINT outbound_asis_payload_queue_archive_pk PRIMARY KEY (group_id,origin_id,tenant_id)
                    );

                    CREATE TABLE if not exists outbound_asis.outbound_asis_payload_error_queue
                    (
                    producer_process_id int8 NOT NULL,
                    consumer_process_id int8 NULL,
                    batch_id varchar NOT NULL,
                    origin_id varchar NOT NULL,
                    group_id int4 NULL,
                    created_on timestamp NOT NULL,
                    status varchar NOT NULL,
                    stage  varchar NOT NULL,
                    message varchar NULL,
                    consumed_on_ts timestamp NULL,
                    root_pipeline_id int8 NULL,
                    tenant_id int8 NULL,
                    CONSTRAINT outbound_asis_payload_error_queue_pk PRIMARY KEY (producer_process_id, origin_id,tenant_id)
                    );


                    create table if not exists outbound_asis.outbound_asis_result(
                    transaction_id bigserial NOT NULL,
                    created_on timestamp NOT NULL,
                    created_user_id varchar NOT NULL,
                    last_updated_on timestamp NULL,
                    last_updated_user_id varchar NULL,
                    tenant_id int8 NULL,
                    confidence_score numeric(10, 2) NULL,
                    origin_id varchar NOT NULL,
                    paper_no int4 NOT NULL,
                    template_id varchar NOT NULL,
                    model_id int8 NULL,
                    document_type varchar NULL,
                    status varchar NULL,
                    stage varchar NULL,
                    message varchar NULL,
                    group_id int4 NULL,
                    root_pipeline_id int8 NULL,
                    model_name varchar NULL,
                    model_version varchar NULL,
                    batch_id varchar NOT NULL,
                 request text null,
                 response text null,
                 endpoint varchar null,
                    CONSTRAINT outbound_asis_result_pk PRIMARY KEY (transaction_id)
                    );

                    CREATE TABLE IF NOT EXISTS outbound_asis.outbound_asis_pipeline_audit (
                    id bigserial NOT NULL,
                    batch_id varchar NULL,
                    process_id bigint NULL,
                    origin_id varchar NULL,
                    group_id varchar NULL,
                    created_on varchar NULL,
                    status varchar NULL,
                    stage varchar NULL,
                    message varchar NULL,
                    root_pipeline_id int8 NULL,
                    tenant_id int8 NULL
                    );

                    CREATE TABLE IF NOT EXISTS outbound_asis.outbound_alchemy_asis_response (
                                    id bigserial NOT NULL,
                                    batch_id varchar NULL,
                                    process_id int8 NULL,
                                    group_id int4 NULL,
                                    product_response varchar NULL,
                                    file_name varchar NULL,
                                    created_on timestamp NULL DEFAULT now(),
                                    last_updated_on timestamp NULL DEFAULT now(),
                                    tenant_id int8 NULL,
                                    root_pipeline_id int8 NULL,
                                    origin_id varchar NULL,
                                    status varchar NULL,
                                    stage varchar NULL,
                                    message varchar NULL,
                                    feature varchar NULL,
                                    triggered_url varchar NULL,
                                    request text NULL,
                                    response text NULL,
                                    endpoint text NULL,
                                    inbound_transaction_id varchar NULL,
                                    CONSTRAINT outbound_alchemy_asis_response_pk PRIMARY KEY (id)
                                );
            "} on-condition if "true"=="true"
     }

     catch{
     }

     finally{
     }
}