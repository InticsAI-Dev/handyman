process "coverage.processor"
{
    try {


             coproStart as "Calling cos similarity copro start action" for "MASTER-DATA&COVERAGE_REPORT"
            copro-server-url "${copro.similarity.admin.start.url}"
            export-command "${copro.similarity.export}"
            process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
            using
            {"
                  ${similarityStartCommand}
            "}on-condition if "${similarity.start.action}"=="true"

            callprocess as "calling transposed table"
            with-target "eval.transposed.table"
            from-file "${basepath}/coverageReport/eval.transposed.table.lmd"
            using "intics_zio_db_conn"
            for-every {"
                SELECT 1;
            "} on-condition if "true"=="true"

            callprocess as "calling member eval match"
            with-target "eval.member.match"
            from-file "${basepath}/coverageReport/eval.member.match.lmd"
            using "intics_zio_db_conn"
            for-every {"
            SELECT 1;
            "} on-condition if "${member.eval.match}"=="true" on-parallel-fielding "${coverage-report-thread-count}"

            callprocess as "calling prescriber eval match"
            with-target "eval.prescriber.match"
            from-file "${basepath}/coverageReport/eval.prescriber.match.lmd"
            using "intics_zio_db_conn"
            for-every {"
            SELECT 1;
            "} on-condition if "${prescriber.eval.match}"=="true" on-parallel-fielding "${coverage-report-thread-count}"

            callprocess as "calling provider eval match"
            with-target "eval.provider.match"
            from-file "${basepath}/coverageReport/eval.provider.match.lmd"
            using "intics_zio_db_conn"
            for-every {"
            SELECT 1;
            "} on-condition if "${provider.eval.match}"=="true" on-parallel-fielding "${coverage-report-thread-count}"

            callprocess as "calling drug eval match"
            with-target "eval.drug.match"
            from-file "${basepath}/coverageReport/eval.drug.match.lmd"
            using "intics_zio_db_conn"
            for-every {"
            SELECT 1;
            "} on-condition if "${drug.eval.match}"=="true" on-parallel-fielding "${coverage-report-thread-count}"


           coproStop as "Calling cos similarity copro stop action" for "MASTERDATA&COVERAGE_REPORT"
            copro-server-url "${copro.similarity.admin.stop.url}"
            process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
            using
            {"
                      gunicorn
            "}on-condition if "${similarity.stop.action}"=="true"

            transform as "insert into audit table for IntelliMatch Comparison" on "intics_zio_db_conn" using
            {"
                    insert into audit.process_audit_output
                         (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                         select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                         from control_data_macro.eval_member_name ai
                         where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                         group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                          (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                          select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                          from control_data_macro.eval_member_id ai
                          where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                          group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                       (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                       select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                       from control_data_macro.eval_member_dob ai
                       where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                       group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                       (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                       select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                       from control_data_macro.eval_patient_address ai
                       where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                       group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                       (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                       select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                       from control_data_macro.eval_member_groupnumber ai
                       where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                       group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                       (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                       select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                       from control_data_macro.eval_patient_city ai
                       where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                       group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                       (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                       select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                       from control_data_macro.eval_patient_city_state_zip ai
                       where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                       group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                       (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                       select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                       from control_data_macro.eval_patient_state ai
                       where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                       group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                       (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                        select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                        from control_data_macro.eval_patient_zip ai
                        where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                        group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                         (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                         select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                         from control_data_macro.eval_patient_phone ai
                         where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                         group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                        (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                        select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                        from control_data_macro.eval_prescriber_name ai
                        where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                        group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                         (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                         select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                         from control_data_macro.eval_prescriber_npi ai
                         where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
                        group by ai.origin_id,ai.tenant_id, ai.root_pipeline_id, ai.request, ai.response, ai.status, ai.message, ai.endpoint, ai.stage;

                    insert into audit.process_audit_output
                       (tenant_id,root_pipeline_id,origin_id,request,response,status,stage, message,created_on,endpoint)
                       select ai.tenant_id, ai.root_pipeline_id, ai.origin_id, ai.request, ai.response, ai.status,ai.stage, ai.message, now(), ai.endpoint
                       from control_data_macro.eval_prescriber_address ai
                       where root_pipeline_id = '${gen_id.root_pipeline_id}' and tenant_id = ${tenant_id} and group_id= ${group_id}
