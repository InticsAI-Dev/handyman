                FROM control_data_macro.eval_prescriber_state a
                JOIN control_data.control_data_payload_queue b on a.origin_id=b.origin_id
                WHERE a.group_id='${gen_group_id.group_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';



                INSERT INTO control_data.prescriber_zip_similarity
               (actual_value, origin_id, created_on, group_id, root_pipeline_id, extracted_value,
               confidence_score, file_name, similarity, levenshtein_score,intellimatch_score, tenant_id,batch_id)
               select
                       a.actual_value as actual_value,
                       a.origin_id,
                       a.created_on,
                       a.group_id,
                       a.root_pipeline_id,
                       a.extracted_value  as extracted_value,
                       a.confidence_score,
                       a.file_name,
                       (case
                           when a.actual_value='' and a.extracted_value='' then 1
                           when replace(lower(concat(a.actual_value)),' ','') like concat('%',replace(lower(a.extracted_value),' ',''),'%') then 1
                           else similarity(replace(lower(concat(a.actual_value)),' ',''),replace(lower(a.extracted_value),' ',''))
                           end) as similarity,
                       (case
                           when a.actual_value='' and a.extracted_value='' then 1
                           when replace(lower(concat(a.actual_value)),' ','') like concat('%',replace(lower(a.extracted_value),' ',''),'%') then 1
                           else levenshtein(replace(lower(concat(a.actual_value)),' ',''),replace(lower(a.extracted_value),' ',''))
                           end) as levenshtein_score,
                       a.intelli_match,
                       ${tenant_id},
                       a.batch_id
               FROM control_data_macro.eval_prescriber_zip a
               JOIN control_data.control_data_payload_queue b on a.origin_id=b.origin_id
               WHERE a.group_id='${gen_group_id.group_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';

                INSERT INTO control_data.prescriber_phone_similarity
                (actual_value, origin_id, created_on, group_id, root_pipeline_id, extracted_value,
                confidence_score, file_name, similarity, levenshtein_score,intellimatch_score, tenant_id,batch_id)
                select
                        a.actual_value as actual_value,
                        a.origin_id,
                        a.created_on,
                        a.group_id,
                        a.root_pipeline_id,
                        a.extracted_value  as extracted_value,
                        a.confidence_score,
                        a.file_name,
                        (case
                            when a.actual_value='' and a.extracted_value='' then 1
                            when replace(lower(concat(a.actual_value)),' ','') like concat('%',replace(lower(a.extracted_value),' ',''),'%') then 1
                            else similarity(replace(lower(concat(a.actual_value)),' ',''),replace(lower(a.extracted_value),' ',''))
                            end) as similarity,
                        (case
                            when a.actual_value='' and a.extracted_value='' then 1
                            when replace(lower(concat(a.actual_value)),' ','') like concat('%',replace(lower(a.extracted_value),' ',''),'%') then 1
                            else levenshtein(replace(lower(concat(a.actual_value)),' ',''),replace(lower(a.extracted_value),' ',''))
                            end) as levenshtein_score,
                        a.intelli_match,
