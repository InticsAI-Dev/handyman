process "error.queue.main.ddl"
{
try{
        transform as "error queue DDl creation for the main tables" on "intics_zio_db_conn" using {"

                CREATE TABLE IF NOT EXISTS error_queue.error_queue_payload_error_queue (
                     producer_process_id int8 NOT NULL,
                     consumer_process_id int8 NULL,
                     group_id int4 NOT NULL,
                     origin_id varchar NOT NULL,
                     created_on timestamp NOT NULL,
                     status varchar NOT NULL,
                     stage  varchar NOT NULL,
                     message varchar NULL,
                     consumed_on_ts timestamp NULL,
                     root_pipeline_id int8 NULL,
                     tenant_id int8 NULL,
                     CONSTRAINT error_queue_payload_error_queue_pk PRIMARY KEY (tenant_id, origin_id)
                );

                CREATE TABLE IF NOT EXISTS error_queue.error_queue_payload_queue (
                     producer_process_id int8 NOT NULL,
                     consumer_process_id int8 NULL,
                     group_id int4 NOT NULL,
                     origin_id varchar NOT NULL,
                     created_on timestamp NOT NULL,
                     status varchar NOT NULL,
                     stage  varchar NOT NULL,
                     message varchar NULL,
                     consumed_on_ts timestamp NULL,
                     root_pipeline_id int8 NULL,
                     tenant_id int8 NULL,
                     CONSTRAINT error_queue_payload_payload_queue_pk PRIMARY KEY (tenant_id, origin_id)
                );


                CREATE TABLE IF NOT EXISTS error_queue.error_queue_payload_queue_archive (
