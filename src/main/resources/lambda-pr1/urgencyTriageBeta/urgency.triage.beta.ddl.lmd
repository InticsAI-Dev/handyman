process "urgency.triage.beta.ddl"
{

    try{

        transform as "create audit table for urgency triage config" on "intics_zio_db_conn" using {"
            CREATE TABLE IF NOT EXISTS config.urgency_triage_config (
                id BIGINT NOT NULL,
                base_line_confidence_score NUMERIC(5,2) NULL,
                checkbox_triage_result VARCHAR NULL,
                checkbox_reduction_score NUMERIC(10,2) NULL,
                handwritten_triage_result VARCHAR NULL,
                handwritten_reduction_score NUMERIC(10,2) NULL,
                binary_triage_result VARCHAR NULL,
                binary_reduction_score NUMERIC(10,2) NULL,
                urgency_triage_threshold NUMERIC(10,2) NULL,
                total_score_reductions NUMERIC(10,2) NULL,
                urgency_final_score NUMERIC(5,2) NULL,
                urgency_final_result VARCHAR NULL,
                urgency_triage_id VARCHAR NULL,
                urgency_final_bbox VARCHAR NULL,
                voted_model VARCHAR NULL
            );
        "} on-condition if "true"=="true"

        transform as "create audit table for urgency triage model" on "intics_zio_db_conn" using {"
            CREATE TABLE IF NOT EXISTS urgency_triage.ut_model_pipeline_audit (
                id BIGSERIAL NOT NULL,
                process_id bigint NULL,
                origin_id VARCHAR NULL,
                group_id VARCHAR NULL,
                created_on VARCHAR NULL,
                status VARCHAR NULL,
                stage VARCHAR NULL,
                message VARCHAR NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL,
                batch_id varchar NULL
            );
        "} on-condition if "true"=="true"

        transform as "create ddl for ut model output table and ut beta model output table" on "intics_zio_db_conn" using
        {"
            CREATE TABLE IF NOT EXISTS urgency_triage_beta.urgency_triage_beta_pipeline_result (
                transaction_id BIGSERIAL NOT NULL,
                created_user_id VARCHAR NOT NULL,
                last_updated_user_id VARCHAR NULL,
                process_id int8 NULL,
                group_id int4 NULL,
                tenant_id int8 NOT NULL,
                origin_id VARCHAR NOT NULL,
                paper_no int4 NULL,
                template_id VARCHAR NULL,
                model_id int8 NULL,
                status VARCHAR NULL,
                stage VARCHAR NULL,
                message text NULL,
                root_pipeline_id int8 NULL,
                model_version VARCHAR NULL,
                batch_id VARCHAR NULL,
                checkbox_result VARCHAR NULL,
                hw_result VARCHAR NULL,
                binary_result VARCHAR NULL,
                checkbox_score NUMERIC(10, 2) NULL,
                hw_score NUMERIC(10, 2) NULL,
                binary_score NUMERIC(10, 2) NULL,
                checkbox_bbox VARCHAR NULL,
                hw_bbox VARCHAR NULL,
                binary_bbox VARCHAR NULL,
                created_on timestamp DEFAULT CURRENT_TIMESTAMP NOT NULL,
                model_name VARCHAR NULL,
                last_updated_on timestamp DEFAULT CURRENT_TIMESTAMP NULL,
                CONSTRAINT urgency_triage_beta_result_pkey PRIMARY KEY (transaction_id, origin_id, tenant_id)
            );

            CREATE TABLE IF NOT EXISTS urgency_triage_beta.urgency_triage_beta_pipeline_result_final (
            	transaction_id BIGSERIAL NOT NULL,
            	created_user_id VARCHAR NOT NULL,
            	last_updated_user_id VARCHAR NULL,
            	process_id int8 NULL,
            	group_id int4 NULL,
            	tenant_id int8 NOT NULL,
            	origin_id VARCHAR NOT NULL,
            	paper_no int4 NULL,
            	template_id VARCHAR NULL,
            	model_id int8 NULL,
            	status VARCHAR NULL,
            	stage VARCHAR NULL,
            	message text NULL,
            	root_pipeline_id int8 NULL,
            	model_version VARCHAR NULL,
            	batch_id VARCHAR NULL,
            	checkbox_result VARCHAR NULL,
            	hw_result VARCHAR NULL,
            	binary_result VARCHAR NULL,
            	checkbox_score NUMERIC(10, 2) NULL,
            	hw_score NUMERIC(10, 2) NULL,
            	binary_score NUMERIC(10, 2) NULL,
            	checkbox_bbox VARCHAR NULL,
            	hw_bbox VARCHAR NULL,
            	binary_bbox VARCHAR NULL,
            	created_on timestamp DEFAULT CURRENT_TIMESTAMP NOT NULL,
            	last_updated_on timestamp DEFAULT CURRENT_TIMESTAMP NULL,
            	model_name VARCHAR NULL,
            	CONSTRAINT urgency_triage_beta_result_final_pkey PRIMARY KEY (transaction_id, origin_id, tenant_id)
            );

            CREATE TABLE IF NOT EXISTS urgency_triage_beta.urgency_triage_beta_consolidate_result (
            	base_line_confidence_score int8 NULL,
            	total_score_reductions NUMERIC(10, 2) NULL,
            	urgency_final_score NUMERIC(5, 2) NULL,
            	urgency_final_result VARCHAR NULL,
            	urgency_triage_id VARCHAR NULL,
            	urgency_final_bbox VARCHAR NULL,
            	transaction_id int8 NULL,
            	created_user_id VARCHAR NULL,
            	last_updated_user_id VARCHAR NULL,
            	process_id int8 NULL,
            	group_id int4 NULL,
            	tenant_id int8 NULL,
            	origin_id VARCHAR NULL,
            	paper_no int4 NULL,
            	template_id VARCHAR NULL,
            	model_id int8 NULL,
            	status VARCHAR NULL,
            	stage VARCHAR NULL,
            	message text NULL,
            	root_pipeline_id int8 NULL,
            	model_version VARCHAR NULL,
            	batch_id VARCHAR NULL,
            	created_on timestamp NULL,
            	last_updated_on timestamp NULL,
            	checkbox_bbox VARCHAR NULL,
            	hw_bbox VARCHAR NULL,
            	binary_bbox VARCHAR NULL,
            	id BIGSERIAL NOT NULL,
            	voted_model VARCHAR NULL,
            	model_name VARCHAR NULL
            );

            CREATE TABLE IF NOT EXISTS urgency_triage.ut_model_result (
                transaction_id BIGSERIAL NOT NULL,
                created_on timestamp NOT NULL,
                created_user_id VARCHAR NOT NULL,
                last_updated_on timestamp NULL,
                last_updated_user_id VARCHAR NULL,
                process_id int8 NULL,
                batch_id varchar NOT NULL,
                group_id int4 NULL,
                tenant_id int8 NULL,
                confidence_score NUMERIC(10, 2) NULL,
                origin_id VARCHAR NOT NULL,
                paper_no int4 NOT NULL,
                template_id VARCHAR NOT NULL,
                model_id int8 NULL,
                paper_type VARCHAR NULL,
                bboxes VARCHAR NULL,
                status VARCHAR NOT NULL,
                stage VARCHAR NOT NULL,
                message text NOT NULL,
                document_type VARCHAR NULL,
                root_pipeline_id int8 NULL,
                model_name VARCHAR null,
                model_version VARCHAR null,
                voted_model VARCHAR NULL,
                CONSTRAINT ut_model_result_pkey PRIMARY KEY (transaction_id, origin_id,tenant_id)
            );
        "} on-condition if "true"=="true"


        transform as "Create urgency triage payload table " on "intics_zio_db_conn" using
        {"
            CREATE TABLE IF NOT EXISTS urgency_triage.ut_model_payload_queue_archive (
                producer_process_id int8 NOT NULL,
                consumer_process_id int8 NULL,
                origin_id VARCHAR NOT NULL,
                batch_id varchar NOT NULL,
                group_id int4 NULL,
                created_on timestamp NULL,
                last_updated_on timestamp NULL,
                consumed_on_ts VARCHAR NULL,
                status VARCHAR NULL,
                stage VARCHAR NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL,
                CONSTRAINT ut_model_payload_queue_archive_pk PRIMARY KEY (producer_process_id, origin_id,tenant_id)
            );

            CREATE TABLE IF NOT EXISTS urgency_triage.ut_model_payload_error_queue (
                producer_process_id int8 NOT NULL,
                consumer_process_id int8 NULL,
                origin_id VARCHAR NOT NULL,
                batch_id varchar NOT NULL,
                created_on timestamp NOT NULL,
                last_updated_on timestamp NULL,
                group_id int4 not null,
                status VARCHAR NOT NULL,
                stage  VARCHAR NOT NULL,
                message VARCHAR NULL,
                consumed_on_ts timestamp NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL,
                CONSTRAINT ut_model_payload_error_queue_pk PRIMARY KEY (producer_process_id, origin_id,tenant_id)
            );

            create table IF not exists ${temp_schema_name}.ut_payload_input_table_${init_process_id.process_id}(
                origin_id VARCHAR null,
                preprocessed_file_id VARCHAR null,
                paper_no int8 null,
                input_file_path VARCHAR null,
                batch_id varchar NOT NULL,
                created_user_id VARCHAR NULL,
                last_updated_user_id VARCHAR NULL,
                tenant_id int8 NULL,
                template_id VARCHAR NULL,
                process_id int8 null,
                model_registry_id int8 null,
                group_id int8 null,
                root_pipeline_id int8 null
            );

            create table IF not exists macro.ut_payload_input_table_audit(
                id BIGSERIAL not null,
                origin_id VARCHAR null,
                preprocessed_file_id VARCHAR null,
                paper_no int null,
                input_file_path VARCHAR null,
                batch_id varchar NOT NULL,
                created_user_id VARCHAR NOT NULL,
                last_updated_user_id VARCHAR NULL,
                tenant_id int8 NULL,
                template_id VARCHAR NOT NULL,
                process_id int null,
                model_registry_id int null,
                group_id int null,
                root_pipeline_id int null
            );

            CREATE TABLE IF NOT EXISTS ${temp_schema_name}.summary_audit_papers_${process-id} (
                module_name text NULL,
                macro_process text NULL,
                completed_count int8 NULL,
                failed_count int8 NULL,
                min_created_on timestamp NULL,
                max_created_on timestamp NULL,
                time_taken int8 NULL,
                process_id int8 NOT NULL,
                batch_id varchar NOT NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL
            );

            CREATE TABLE IF NOT EXISTS  ${temp_schema_name}.summary_audit_files_${process-id} (
                module_name text NULL,
                macro_process text NULL,
                completed_count int8 NULL,
                failed_count int8 NULL,
                min_created_on timestamp NULL,
                max_created_on timestamp NULL,
                time_taken int8 NULL,
                process_id int8 NOT NULL,
                batch_id varchar NOT NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL
            );
        "} on-condition if "true"=="true"

        transform as "completed urgency triage DDL process " on "intics_zio_db_conn" using {"
            INSERT INTO urgency_triage.ut_model_pipeline_audit
            (process_id,group_id, created_on, status, stage, message,root_pipeline_id, tenant_id)
            values( ${init_process_id.process_id},'${gen_group_id.group_id}', now(),
            'COMPLETED', 'UT_DDL',' urgency triage ddl creation FAILED for process_id ${init_process_id.process_id}',
            '${gen_id.root_pipeline_id}', ${tenant_id});
        "} on-condition if "true"=="true"
    }
    catch{
        transform as "failed in urgency triage DDL caller " on "intics_zio_db_conn" using {"
            INSERT INTO urgency_triage.ut_model_pipeline_audit
            (process_id,group_id, created_on, status, stage, message, root_pipeline_id, tenant_id)
            values( ${init_process_id.process_id},'${gen_group_id.group_id}', now(),
            'FAILED', 'UT_DDL',' urgency triage ddl creation FAILED for process_id ${init_process_id.process_id}',
            '${gen_id.root_pipeline_id}', ${tenant_id});
        "} on-condition if "true"=="true"
    }
    finally{

    }
}