						CREATE TABLE IF NOT EXISTS ${temp_schema_name}.b1_scalar_max_score_multi_occur_${init_process_id.process_id} (
						origin_id varchar NULL,
						batch_id varchar not NULL,
						paper_no int4 NULL,
