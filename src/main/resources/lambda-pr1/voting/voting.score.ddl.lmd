						CREATE TABLE IF NOT EXISTS ${temp_schema_name}.b2_scalar_max_score_multi_occur_freq_${init_process_id.process_id} (
                        origin_id varchar NULL,
                        paper_no int4 NULL,
                        sor_item_name varchar NULL,
                        occur_count int8 NULL,
                        vqa_score float8 NULL,
                        tenant_id int8 NULL,
                        batch_id varchar not NULL
                        );

                        CREATE TABLE IF NOT EXISTS macro.b2_scalar_max_score_multi_occur_freq_audit (
                        origin_id varchar NULL,
                        paper_no int4 NULL,
                        sor_item_name varchar NULL,
                        occur_count int8 NULL,
                        vqa_score float8 NULL,
                        tenant_id int8 NULL,
                        batch_id varchar not NULL,
                        root_pipeline_id int8 null
                        );

                        CREATE TABLE IF NOT EXISTS ${temp_schema_name}.b_max_occur_item_${init_process_id.process_id} (
