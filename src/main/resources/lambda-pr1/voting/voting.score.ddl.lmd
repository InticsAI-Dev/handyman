process"voting.score.ddl"
{
		try
		{

            assign as "voting" source "intics_zio_db_conn" using
            {"
                SELECT (CASE WHEN '${voting.activator}' = 'true' AND '${voting.multi.value.line.item.activator}' = 'true' then 'true' else 'false' end) as multi_value_sor_item;
            "}on-condition if "true"=="true"

            transform as "voting precedence principle" on "intics_zio_db_conn" using
            {"

                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.temp_aggregation_evaluator_${init_process_id.process_id} (
                        aggregation_evaluator_id bigserial NOT NULL,
                        created_on timestamp NOT NULL,
                        created_user_id varchar NOT NULL,
                        last_updated_on timestamp NULL,
                        last_updated_user_id varchar NULL,
                        tenant_id int8 NULL,
                        aggregated_score float8 NULL,
                        masked_score float8 NULL,
                        group_id int8 NULL,
                        origin_id varchar NOT NULL,
                        paper_no int4 NOT NULL,
                        predicted_value text NULL,
                        vqa_score float8 NULL,
                        rank int4 NULL,
                        sor_item_attribution_id int4 NOT NULL,
                        sor_item_name varchar NOT NULL,
                        document_id varchar NOT NULL,
                        acc_transaction_id int8 NULL,
                        b_box varchar NULL,
                        root_pipeline_id int8 NULL,
                        frequency int8 NULL,
                        question_id int8 NULL,
                        synonym_id int8 NULL,
                        model_registry varchar NULL,
                        status varchar NULL,
                        version int4 NULL,
                        acc_transcation_id int8 NULL,
                        model_registry_id varchar NULL,
                        batch_id varchar NULL,
                        category varchar NULL
                    );

                    -- DDL for Step 1: Sor Item counts per file
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.sor_item_name_counts_per_file_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        sor_item_name varchar NULL,
                        sor_item_count INT4 NULL,
                        vqa_score float8 NULL,
                        model_registry varchar NULL
                    );


                    -- DDL for Step 2: Final cumulative results
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.final_cumulative_results_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        root_pipeline_id INT8 NULL,
                        paper_no INT4 NULL,
                        sor_item_attribution_id VARCHAR NULL,
                        sor_item_name varchar NULL,
                        question_id VARCHAR NULL,
                        synonym_id VARCHAR NULL,
                        b_box VARCHAR NULL,
                        predicted_value VARCHAR NULL,
                        vqa_score float8 NULL,
                        model_registry varchar NULL
                    );

                    -- DDL for Step 3: Multi SOR items to evaluate
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.multi_sor_items_to_evaluate_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        root_pipeline_id INT8 NULL,
                        paper_no INT4 NULL,
                        sor_item_attribution_id VARCHAR NULL,
                        sor_item_name varchar NULL,
                        question_id VARCHAR NULL,
                        synonym_id VARCHAR NULL,
                        b_box VARCHAR NULL,
                        predicted_value VARCHAR NULL,
                        vqa_score float8 NULL,
                        model_registry varchar NULL
                    );

                    -- DDL for Step 4: Non-empty predicted values
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.non_empty_predicted_values_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        root_pipeline_id INT8 NULL,
                        paper_no INT4 NULL,
                        sor_item_attribution_id VARCHAR NULL,
                        sor_item_name varchar NULL,
                        question_id VARCHAR NULL,
                        synonym_id VARCHAR NULL,
                        b_box VARCHAR NULL,
                        predicted_value VARCHAR NULL,
                        vqa_score float8 NULL,
                        model_registry varchar NULL
                    );

                    -- DDL for Step 5: Predicted value occurrence counts
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.predicted_value_occurrence_counts_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        sor_item_name varchar NULL,
                        predicted_value VARCHAR NULL,
                        predicted_value_count INT4 NULL,
                        vqa_score float8 NULL,
                        model_registry varchar NULL
                    );

                    -- DDL for Step 6a: Single predicted value items
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.single_predicted_value_items_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        sor_item_name varchar NULL,
                        vqa_score float8 NULL,
                        model_registry varchar NULL
                    );

                    -- DDL for Step 6c: Tied SOR items
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.tied_sor_items_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        sor_item_name varchar NULL,
                        sor_container_id INT8 NULL,
                        sor_container_name varchar NULL,
                        vqa_score float8 NULL,
                        model_registry varchar NULL
                    );

                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.predicted_values_joined_${init_process_id.process_id} (
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        root_pipeline_id VARCHAR NULL,
                        paper_no INT8 NULL,
                        sor_item_name varchar NULL,
                        predicted_value VARCHAR NULL,
                        sor_container_id INT8 NULL,
                        sor_container_name varchar NULL,
                        vqa_score float8 NULL,
                        model_registry varchar NULL
                    );

                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.white_listed_entries_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        root_pipeline_id INT8 NULL,
                        paper_no INT4 NULL,
                        sor_item_attribution_id VARCHAR NULL,
                        sor_item_name varchar NULL,
                        question_id VARCHAR NULL,
                        synonym_id VARCHAR NULL,
                        b_box VARCHAR NULL,
                        predicted_value VARCHAR NULL,
                        whitelist_key VARCHAR NULL,
                        vqa_score float8 NULL,
                        model_registry varchar NULL
                    );


                    -- DDL for Step 7: SOR item name global counts
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.predicted_value_global_counts_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        paper_no INT4 NULL,
                        predicted_value_count INT4 NULL
                    );

                    -- DDL for Step 8: Most common SOR items in ties
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.most_common_sor_items_in_ties_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        paper_no INT4 NULL,
                        sor_container_id INT8 NULL,
                        sor_container_name varchar NULL,
                        vqa_score float8 NULL,
                        model_registry varchar NULL
                    );

                    -- DDL for Step 9: Remaining tied candidates
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.remaining_tied_candidates_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        root_pipeline_id INT8 NULL,
                        paper_no INT4 NULL,
                        sor_item_attribution_id VARCHAR NULL,
                        sor_item_name varchar NULL,
                        question_id VARCHAR NULL,
                        synonym_id VARCHAR NULL,
                        b_box VARCHAR NULL,
                        predicted_value VARCHAR NULL
                    );

                    -- DDL for Step 9a: Tie break by min paper number
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.tie_break_by_min_paper_no_${init_process_id.process_id}(
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        sor_item_name varchar NULL
                    );

                    -- DDL: Create table for storing min paper_no per empty predicted_value
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.empty_predicted_min_paper_${init_process_id.process_id} (
                        id bigserial NOT NULL,
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        sor_item_name varchar,
                        origin_id VARCHAR NULL,
                        min_paper_no INT
                    );

                    -- DDL: Create table for storing min paper_no per sor_item_name with non-empty predicted_value
                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.non_empty_min_paper_${init_process_id.process_id} (
                        id bigserial NOT NULL,
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        origin_id VARCHAR NULL,
                        group_id INT8 NULL,
                        sor_item_name varchar,
                        min_paper_no INT
                    );

                    -- DDL: Create table to hold the earliest paper_no for each final result key
                    CREATE TABLE IF NOT EXISTS  ${temp_schema_name}.min_final_cumulative_papers_${init_process_id.process_id} (
                        id bigserial NOT NULL,
                        tenant_id INT,
                        batch_id VARCHAR,
                        group_id BIGINT,
                        origin_id VARCHAR NULL,
                        sor_item_name varchar,
                        min_paper_no INT
                    );



            "}on-condition if "true"=="true"


            transform as "VOTING DDL Audit tables" on "intics_zio_db_conn" using
            {"

            CREATE TABLE IF NOT EXISTS macro.temp_aggregation_evaluator_audit (
                aggregation_evaluator_id bigserial NOT NULL,
                created_on timestamp NOT NULL,
                created_user_id varchar NOT NULL,
                last_updated_on timestamp NULL,
                last_updated_user_id varchar NULL,
                tenant_id int8 NULL,
                aggregated_score float8 NULL,
                masked_score float8 NULL,
                group_id int8 NULL,
                origin_id varchar NOT NULL,
                paper_no int4 NOT NULL,
                predicted_value text NULL,
                vqa_score float8 NULL,
                rank int4 NULL,
                sor_item_attribution_id int4 NOT NULL,
                sor_item_name varchar NOT NULL,
                document_id varchar NOT NULL,
                acc_transaction_id int8 NULL,
                b_box varchar NULL,
                root_pipeline_id int8 NULL,
                frequency int8 NULL,
                question_id int8 NULL,
                synonym_id int8 NULL,
                model_registry varchar NULL,
                status varchar NULL,
                version int4 NULL,
                acc_transcation_id int8 NULL,
                model_registry_id varchar NULL,
                batch_id varchar NULL,
                category varchar NULL
            );
            CREATE TABLE IF NOT EXISTS macro.sor_item_name_counts_per_file_audit(
                        id bigserial NOT NULL,
                        tenant_id INT8 NULL,
                        batch_id VARCHAR NULL,
                        group_id INT8 NULL,
                        origin_id VARCHAR NULL,
                        sor_item_name varchar NULL,
                        sor_item_count INT4 NULL
                    );
                CREATE TABLE IF NOT EXISTS macro.final_cumulative_results_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    root_pipeline_id INT8 NULL,
                    paper_no INT4 NULL,
                    sor_item_attribution_id VARCHAR NULL,
                    sor_item_name varchar NULL,
                    question_id VARCHAR NULL,
                    synonym_id VARCHAR NULL,
                    b_box VARCHAR NULL,
                    predicted_value VARCHAR NULL
                );

                CREATE TABLE IF NOT EXISTS macro.white_listed_entries_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    root_pipeline_id INT8 NULL,
                    paper_no INT4 NULL,
                    sor_item_attribution_id VARCHAR NULL,
                    sor_item_name varchar NULL,
                    question_id VARCHAR NULL,
                    synonym_id VARCHAR NULL,
                    whitelist_key VARCHAR NULL,
                    b_box VARCHAR NULL,
                    predicted_value VARCHAR NULL
                );

                CREATE TABLE IF NOT EXISTS macro.multi_sor_items_to_evaluate_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    root_pipeline_id INT8 NULL,
                    paper_no INT4 NULL,
                    sor_item_attribution_id VARCHAR NULL,
                    sor_item_name varchar NULL,
                    question_id VARCHAR NULL,
                    synonym_id VARCHAR NULL,
                    b_box VARCHAR NULL,
                    predicted_value VARCHAR NULL
                );
                CREATE TABLE IF NOT EXISTS macro.non_empty_predicted_values_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    root_pipeline_id INT8 NULL,
                    paper_no INT4 NULL,
                    sor_item_attribution_id VARCHAR NULL,
                    sor_item_name varchar NULL,
                    question_id VARCHAR NULL,
                    synonym_id VARCHAR NULL,
                    b_box VARCHAR NULL,
                    predicted_value VARCHAR NULL
                );

                CREATE TABLE IF NOT EXISTS macro.predicted_value_occurrence_counts_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    sor_item_name varchar NULL,
                    predicted_value VARCHAR NULL,
                    predicted_value_count INT4 NULL
                );

                CREATE TABLE IF NOT EXISTS macro.single_predicted_value_items_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    sor_item_name varchar NULL
                );

                CREATE TABLE IF NOT EXISTS macro.tied_sor_items_audit(
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    sor_item_name varchar NULL,
                    sor_container_id INT8 NULL,
                    sor_container_name varchar NULL
                );
                CREATE TABLE IF NOT EXISTS macro.predicted_values_joined_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    root_pipeline_id VARCHAR NULL,
                    paper_no INT8 NULL,
                    sor_item_name varchar NULL,
                    predicted_value VARCHAR NULL,
                    sor_container_id INT8 NULL,
                    sor_container_name varchar NULL
                );
                CREATE TABLE IF NOT EXISTS macro.predicted_value_global_counts_audit(
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    paper_no INT4 NULL,
                    predicted_value_count INT4 NULL
                );

                CREATE TABLE IF NOT EXISTS macro.most_common_sor_items_in_ties_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    paper_no INT4 NULL,
                    sor_container_id INT8 NULL,
                    sor_container_name varchar NULL
                );
                CREATE TABLE IF NOT EXISTS macro.remaining_tied_candidates_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    root_pipeline_id INT8 NULL,
                    paper_no INT4 NULL,
                    sor_item_attribution_id VARCHAR NULL,
                    sor_item_name varchar NULL,
                    question_id VARCHAR NULL,
                    synonym_id VARCHAR NULL,
                    b_box VARCHAR NULL,
                    predicted_value VARCHAR NULL
                );

                CREATE TABLE IF NOT EXISTS macro.tie_break_by_min_paper_no_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    origin_id VARCHAR NULL,
                    sor_item_name varchar NULL
                );

                CREATE TABLE IF NOT EXISTS  macro.empty_predicted_min_paper_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    group_id INT8 NULL,
                    sor_item_name varchar,
                    origin_id VARCHAR NULL,
                    min_paper_no INT
                );

                CREATE TABLE IF NOT EXISTS  macro.non_empty_min_paper_audit (
                    id bigserial NOT NULL,
                    tenant_id INT8 NULL,
                    batch_id VARCHAR NULL,
                    origin_id VARCHAR NULL,
                    group_id INT8 NULL,
                    sor_item_name varchar,
                    min_paper_no INT
                );

                CREATE TABLE IF NOT EXISTS  macro.min_final_cumulative_papers_audit (
                    id bigserial NOT NULL,
                    tenant_id INT,
                    batch_id VARCHAR,
                    group_id BIGINT,
                    origin_id VARCHAR NULL,
                    sor_item_name varchar,
                    min_paper_no INT
                );

            "}on-condition if "true"=="true"

				transform as "VOTING DDL" on "intics_zio_db_conn" using
				{"
						CREATE TABLE IF NOT EXISTS voting.voting_pipeline_audit (
						id bigserial NOT NULL,
						process_id int8 NULL,
						batch_id varchar NULL,
						origin_id varchar NULL,
						group_id int8 NULL,
						created_on varchar NULL,
						status varchar NULL,
						stage varchar NULL,
						message varchar NULL,
						root_pipeline_id int8 NULL,
						tenant_id int8 NULL
						);
				"} on-condition if "true"=="true"
				
				
				transform as "create ddl for voting" on "intics_zio_db_conn" using {"

						CREATE TABLE IF NOT EXISTS ${temp_schema_name}.ranking_table_${init_process_id.process_id} (
						validation_id int8 NULL,
						group_id int8 NULL,
						batch_id varchar not NULL,
						origin_id varchar NULL,
						paper_no int4 NULL,
						sor_item_name varchar NULL,
						extracted_value text NULL,
						vqa_score float8 NULL,
						created_on timestamp NULL,
						freq int8 NULL,
						weight_score float8 NULL,
						weight_rank int8 NULL,
						ranking_id bigserial NOT NULL,
						root_pipeline_id int8 NULL,
						tenant_id int8 NULL,
						CONSTRAINT ranking_table_${init_process_id.process_id}_pk PRIMARY KEY (ranking_id)
						);

						CREATE TABLE  IF NOT EXISTS ${temp_schema_name}.weight_difference_${init_process_id.process_id} (
						validation_id int8 NULL,
						batch_id varchar not NULL,
						weight_diff_id bigserial not NULL,
						origin_id varchar NULL,
						paper_no int4 NULL,
						group_id int8 NULL,
						created_on timestamp NULL,
						sor_item_name varchar NULL,
						extracted_value text NULL,
						vqa_score float8 NULL,
						freq int8 NULL,
						weight_score1 float8 NULL,
						weight_score2 float8 NULL,
						weight_rank int8 NULL,
						difference float8 NULL,
						root_pipeline_id int8 NULL,
						tenant_id int8 NULL,
						CONSTRAINT weight_difference_${init_process_id.process_id}_pk PRIMARY KEY (weight_diff_id)
						);

						CREATE TABLE IF NOT EXISTS ${temp_schema_name}.threshold_difference_${init_process_id.process_id} (
						validation_id int8 NULL,
						origin_id varchar NULL,
						difference float8 NULL,
						sor_item_name varchar NULL,
						paper_no int4 NULL,
						batch_id varchar not NULL,
						group_id int8 NULL,
						created_on timestamp NULL,
						extracted_value text NULL,
						freq int8 NULL,
						weight_rank int8 NULL,
						threshold_id bigserial,
						root_pipeline_id int8 NULL,
						tenant_id int8 NULL,
						CONSTRAINT threshold_difference_${init_process_id.process_id}_pk primary key(threshold_id)
						);

						CREATE TABLE IF NOT EXISTS voting.ranking_table_audit (
						validation_id int8  null,
						batch_id varchar not NULL,
						group_id int8 NULL,
						origin_id varchar NULL,
						paper_no int4 NULL,
						sor_item_name varchar NULL,
						extracted_value text NULL,
						vqa_score float8 NULL,
						created_on timestamp NULL,
						freq int8 NULL,
						weight_score float8 NULL,
						weight_rank int8 NULL,
						ranking_id bigserial NOT NULL,
						root_pipeline_id int8 NULL,
						tenant_id int8 NULL
						);

						CREATE TABLE  IF NOT EXISTS voting.weight_difference_audit (
						validation_id int8 NULL,
						weight_diff_id bigserial not NULL,
						batch_id varchar not NULL,
						origin_id varchar NULL,
						paper_no int4 NULL,
						group_id int8 NULL,
						created_on timestamp NULL,
						sor_item_name varchar NULL,
						extracted_value text NULL,
						vqa_score float8 NULL,
						freq int8 NULL,
						weight_score1 float8 NULL,
						weight_score2 float8 NULL,
						weight_rank int8 NULL,
						difference float8 NULL,
						root_pipeline_id int8 NULL,
						tenant_id int8 NULL
						);

						CREATE TABLE IF NOT EXISTS voting.threshold_difference_audit (
						validation_id bigserial not NULL,
						batch_id varchar not NULL,
						origin_id varchar NULL,
						difference float8 NULL,
						sor_item_name varchar NULL,
						paper_no int4 NULL,
						group_id int8 NULL,
						created_on timestamp NULL,
						extracted_value text NULL,
						freq int8 NULL,
						weight_rank int8 NULL,
						threshold_id bigserial,
						root_pipeline_id int8 NULL,
						tenant_id int8 NULL,
						CONSTRAINT threshold_difference_pk primary key(threshold_id)
						);
						CREATE TABLE IF NOT EXISTS ${temp_schema_name}.question_weight_${init_process_id.process_id} (
						origin_id varchar NULL,
						batch_id varchar not NULL,
						paper_no int4 NULL,
						sor_item_name varchar NULL,
						question_weight int8 NULL,
						group_id int4 NULL,
						tenant_id int8 NULL,
						root_pipeline_id int8 null
						);
				"} on-condition if "true"=="false"

				transform as "creating ddl for confidence score" on "intics_zio_db_conn" using
				{"
						CREATE TABLE IF NOT EXISTS ${temp_schema_name}.voting_out_empty_entries_${init_process_id.process_id} (
						origin_id varchar NULL,
						batch_id varchar not NULL,
						sor_item_name varchar NULL,
						question varchar NULL,
						predicted_value text NULL,
						voting_out numeric NULL,
						tenant_id int8 NULL,
						root_pipeline_id int8 null
						);



						CREATE TABLE IF NOT EXISTS ${temp_schema_name}.voting_out_empty_entry_summary_${init_process_id.process_id} (
						origin_id varchar NULL,
						batch_id varchar not NULL,
						sor_item_name varchar NULL,
						empty_prediction_values int8 NULL,
						voting_out_threshold numeric NULL,
						tenant_id int8 NULL
						);


						CREATE TABLE IF NOT EXISTS ${temp_schema_name}.voting_out_agg_summary_${init_process_id.process_id} (
						origin_id varchar NULL,
						batch_id varchar not NULL,
						sor_item_name varchar NULL,
						total_questions int8 NULL,
						tenant_id int8 NULL
						);

						CREATE TABLE IF NOT EXISTS ${temp_schema_name}.voting_out_empty_summary_percentage_${init_process_id.process_id} (
						origin_id varchar NULL,
						batch_id varchar not NULL,
