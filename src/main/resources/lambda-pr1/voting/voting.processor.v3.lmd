process "voting.processor.v3"
{

		try {

		transform as "insert to completed voting audit" on "intics_zio_db_conn" using
		{"
				INSERT INTO sor_transaction.sor_transaction_pipeline_audit
				(group_id, created_on, created_by, user_id, tenant_id, status, stage, message, root_pipeline_id, batch_id)
				VALUES('${group_id}', now(), '${created_user_id}', '${created_user_id}', ${tenant_id}, 'STARTED', 'VOTING_V1', 'voting started in voting with group_id ${group_id}', '${gen_id.root_pipeline_id}', '${batch_id}');
		"} on-condition if "true"=="true"

		transform as "cummulative result for voting out phase" on "intics_zio_db_conn" using {"

				-- This table (Table 1) contains the origin_id and sor_item_name and question and predicted_value with sor container voting_out values ;

				INSERT INTO
				${temp_schema_name}.voting_out_empty_entries_${init_process_id.process_id}
				(origin_id, sor_item_name, question, predicted_value, voting_out, tenant_id, batch_id)
				SELECT sv.origin_id,
				sv.sor_item_name, sv.question,
				sv.predicted_value, round(sc.voting_out::numeric,2)*100, ${tenant_id}, sv.batch_id
				FROM ${temp_schema_name}.scalar_validation_${init_process_id.process_id} sv
				join sor_transaction.sor_transaction_payload_queue stpq on stpq.origin_id=sv.origin_id
				inner JOIN sor_meta.sor_item si on si.sor_item_name = sv.sor_item_name
				inner JOIN sor_meta.sor_container sc on sc.sor_container_id = si.sor_container_id
				WHERE sv.group_id = '${group_id}' and sv.predicted_value =''
				and sc.voting_out is not null and sv.tenant_id = ${tenant_id} and sv.batch_id = '${batch_id}';

				-- This table (Table 2) has the count of the empty values FROM the table 1 ;

				INSERT INTO
				${temp_schema_name}.voting_out_empty_entry_summary_${init_process_id.process_id}
				(origin_id, sor_item_name, empty_prediction_values, voting_out_threshold, tenant_id, batch_id)
				SELECT sv.origin_id,
				sv.sor_item_name,count(*) ,
				voting_out, ${tenant_id}, sv.batch_id
				FROM ${temp_schema_name}.voting_out_empty_entries_${init_process_id.process_id} sv
				where sv.batch_id='${batch_id}'
				GROUP BY  sv.origin_id,
				sv.sor_item_name,voting_out,sv.batch_id;

				-- This table(Table 3) contains the count of questions FROM the scalar validation table ;

				INSERT INTO
				${temp_schema_name}.voting_out_agg_summary_${init_process_id.process_id}
				(origin_id, sor_item_name, total_questions, tenant_id, batch_id)
				SELECT sv.origin_id,
				sv.sor_item_name, count(sv.question), ${tenant_id}, sv.batch_id
				FROM ${temp_schema_name}.scalar_validation_${init_process_id.process_id} sv
				inner JOIN sor_meta.sor_item si on si.sor_item_name = sv.sor_item_name
				inner JOIN sor_meta.sor_container sc on sc.sor_container_id = si.sor_container_id
				where sv.batch_id='${batch_id}'
				GROUP BY sv.origin_id,
				sv.sor_item_name, sv.batch_id;

				-- This table(Table 4) evaluate the score and compare that with the threshold value FROM the container table and validate and give out the result;

				INSERT INTO
				${temp_schema_name}.voting_out_empty_summary_percentage_${init_process_id.process_id}
				(origin_id, sor_item_name, total_questions, empty_prediction_values, empty_percentage, voting_out_threshold, voting_out_empty_flag, tenant_id, batch_id)
				SELECT vs.origin_id,
				vs.sor_item_name,vs.total_questions,
				ve.empty_prediction_values,
				(ve.empty_prediction_values/vs.total_questions::float)*100 ,
				ve.voting_out_threshold,
				case when ((ve.empty_prediction_values/vs.total_questions::float)*100) >= ve.voting_out_threshold
				then 'yes' else 'no' end, ${tenant_id}, vs.batch_id
				FROM ${temp_schema_name}.voting_out_agg_summary_${init_process_id.process_id} vs
				inner JOIN ${temp_schema_name}.voting_out_empty_entry_summary_${init_process_id.process_id} ve
				on ve.origin_id =vs.origin_id
				and ve.sor_item_name = vs.sor_item_name
				where vs.batch_id = '${batch_id}';

				-- This will UPDATE the sor item name with empty under the origin id ;

				UPDATE ${temp_schema_name}.scalar_validation_${init_process_id.process_id} set predicted_value = '' , b_box='' , score=0
				WHERE (${temp_schema_name}.scalar_validation_${init_process_id.process_id}.origin_id,${temp_schema_name}.scalar_validation_${init_process_id.process_id}.sor_item_name)
				IN(SELECT origin_id,sor_item_name FROM ${temp_schema_name}.voting_out_empty_summary_percentage_${init_process_id.process_id} WHERE
				voting_out_empty_flag='yes' and tenant_id = ${tenant_id} and batch_id = '${batch_id}');

		"} on-condition if "true"=="true"

        transform as "handling multiple values for sor item " on "intics_zio_db_conn" using {"

                insert into ${temp_schema_name}.multi_value_sor_item_${init_process_id.process_id}
                (tenant_id, question, group_id, origin_id ,paper_no ,sor_item_name, predicted_value,
                vqa_score, batch_id,question_id, synonym_id, model_registry
                ,weight, score, document_id, validation_name, b_box, root_pipeline_id)
                SELECT distinct ae.tenant_id, ae.question, ae.group_id, ae.origin_id ,ae.paper_no ,ae.sor_item_name, ae.predicted_value,
                ae.vqa_score as vqa_score, ae.batch_id as batch_id,ae.question_id, ae.synonym_id, ae.model_registry
                ,ae.weight, ae.score, ae.document_id, ae.validation_name, ae.b_box, ae.root_pipeline_id
                FROM ${temp_schema_name}.scalar_validation_${init_process_id.process_id} ae
                INNER JOIN sor_meta.sor_item si ON si.sor_item_name = ae.sor_item_name
                AND si.line_item_type = 'multi_value'
                INNER JOIN sor_meta.sor_container sc ON sc.sor_container_id = si.sor_container_id
                WHERE ae.tenant_id = ${tenant_id} and ae.group_id=${group_id}
                and ae.batch_id='${batch_id}' and ae.predicted_value!='';


                insert into ${temp_schema_name}.max_conf_table_${init_process_id.process_id}
                (origin_id ,sor_item_name, b_box, vqa_score)
                SELECT DISTINCT ON (origin_id, sor_item_name)
                origin_id, sor_item_name, b_box, vqa_score
                FROM ${temp_schema_name}.multi_value_sor_item_${init_process_id.process_id}
                WHERE  root_pipeline_id=${init_process_id.process_id} and
                batch_id='${batch_id}' and tenant_id =${tenant_id}
                ORDER BY origin_id, sor_item_name, vqa_score DESC;


                INSERT INTO ${temp_schema_name}.multi_value_sor_item_page_clean_up_${init_process_id.process_id}
                (tenant_id, question, group_id, origin_id, paper_no, sor_item_name, predicted_value,
                vqa_score, batch_id, question_id, synonym_id, model_registry, weight, score,
                document_id, validation_name, b_box, root_pipeline_id)
                SELECT sv.tenant_id,
                MIN(sv.question) AS question,
                sv.group_id,
                sv.origin_id,
                MAX(sv.paper_no) AS paper_no,
                sv.sor_item_name,
                STRING_AGG(DISTINCT sv.predicted_value, ', ') AS predicted_value,
                MAX(sv.vqa_score) AS vqa_score,
                sv.batch_id,
                MAX(sv.question_id) AS question_id,
                MAX(sv.synonym_id) AS synonym_id,
                sv.model_registry,
                MAX(sv.weight) AS weight,
                MAX(sv.score) AS score,
                sv.document_id,
                sv.validation_name,
                mc.b_box,
                sv.root_pipeline_id
                FROM ${temp_schema_name}.multi_value_sor_item_${init_process_id.process_id} sv
                JOIN sor_transaction.sor_transaction_payload_queue stpq
                ON stpq.origin_id = sv.origin_id
                INNER JOIN sor_meta.sor_item si
                ON si.sor_item_name = sv.sor_item_name
                AND si.line_item_type = 'multi_value'
                INNER JOIN sor_meta.sor_container sc
                ON sc.sor_container_id = si.sor_container_id
                LEFT JOIN ${temp_schema_name}.max_conf_table_${init_process_id.process_id} mc
                ON mc.origin_id = sv.origin_id
                AND mc.sor_item_name = sv.sor_item_name
                WHERE sv.predicted_value <> ''
                AND sc.voting_out IS NOT NULL
                AND sv.tenant_id = ${tenant_id}
                and sv.group_id=${group_id}
                and sv.batch_id='${batch_id}'
                and sv.predicted_value ~ '^[a-zA-Z0-9#$]'
                GROUP BY sv.tenant_id, sv.group_id, sv.origin_id, sv.sor_item_name, sv.batch_id,
                sv.model_registry, sv.document_id, sv.validation_name, sv.root_pipeline_id, mc.b_box
                ORDER BY sv.origin_id, sv.sor_item_name;

                insert into ${temp_schema_name}.multi_value_sor_item_page_clean_up_${init_process_id.process_id}
                (tenant_id, question, group_id, origin_id ,paper_no ,sor_item_name, predicted_value,
                vqa_score, batch_id, question_id, synonym_id, model_registry
                ,weight, score, document_id, validation_name, b_box, root_pipeline_id)
                SELECT distinct ae.tenant_id, ae.question, ae.group_id, ae.origin_id ,ae.paper_no ,ae.sor_item_name, ae.predicted_value,
                ae.vqa_score as vqa_score, ae.batch_id as batch_id,ae.question_id, ae.synonym_id, ae.model_registry
                ,ae.weight, ae.score, ae.document_id, ae.validation_name, ae.b_box, ae.root_pipeline_id
                FROM ${temp_schema_name}.scalar_validation_${init_process_id.process_id} ae
                INNER JOIN sor_meta.sor_item si ON si.sor_item_name = ae.sor_item_name
                AND si.line_item_type <> 'multi_value'
                INNER JOIN sor_meta.sor_container sc ON sc.sor_container_id = si.sor_container_id
                WHERE  ae.group_id=${group_id} and ae.predicted_value!='' and
                ae.batch_id='${batch_id}' and ae.tenant_id =${tenant_id};


                INSERT INTO ${temp_schema_name}.a1_agg_occur_count_${init_process_id.process_id}
                (group_id, origin_id, paper_no, sor_item_name, predicted_value, max_score, tenant_id, occur_count, batch_id)
                SELECT distinct ae.group_id, ae.origin_id, ae.paper_no, ae.sor_item_name, ae.predicted_value, max(ae.vqa_score), ${tenant_id} as tenant_id,
                count(*), ae.batch_id
                from ${temp_schema_name}.multi_value_sor_item_page_clean_up_${init_process_id.process_id} ae
                WHERE  ae.batch_id='${batch_id}' and ae.tenant_id =${tenant_id}
                and ae.group_id='${group_id}'
                GROUP BY ae.group_id,ae.origin_id ,ae.paper_no ,ae.sor_item_name,ae.predicted_value, ae.batch_id;


        "} on-condition if "${voting.multi.value.line.item.activator}"=="true"

            transform as "Handling false case for multiple values sor item " on "intics_zio_db_conn" using {"

                    INSERT INTO ${temp_schema_name}.a1_agg_occur_count_${init_process_id.process_id}
                    (group_id, origin_id, paper_no, sor_item_name, predicted_value, max_score, tenant_id, occur_count, batch_id)
                    SELECT ae.group_id, ae.origin_id ,ae.paper_no ,ae.sor_item_name, ae.predicted_value,
                    max(ae.vqa_score) as max_score, ${tenant_id} as tenant_id, count(*) as occur_count, ae.batch_id as batch_id
                    FROM ${temp_schema_name}.scalar_validation_${init_process_id.process_id} ae
                     INNER JOIN sor_meta.sor_container sc ON sc.sor_container_id = si.sor_container_id
                    WHERE  ae.batch_id='${batch_id}' and ae.predicted_value!=''
                    GROUP BY ae.group_id,ae.origin_id ,ae.paper_no ,ae.sor_item_name,ae.predicted_value, ae.batch_id ;
            "} on-condition if "${voting.multi.value.line.item.activator}"=="false"

            transform as "final validation result insert" on "intics_zio_db_conn" using {"

               INSERT INTO ${temp_schema_name}.a2_max_occur_item_${init_process_id.process_id}
                (group_id, origin_id, paper_no, sor_item_name, tenant_id, occur_count, batch_id)
                select group_id,origin_id,paper_no,sor_item_name,tenant_id, max(occur_count) as occur_count, aaom.batch_id as batch_id
                from ${temp_schema_name}.a1_agg_occur_count_${init_process_id.process_id} aaom
                where aaom.batch_id='${batch_id}'
                group by group_id,origin_id,paper_no,sor_item_name,tenant_id, aaom.batch_id;


                INSERT INTO ${temp_schema_name}.a3_agg_input_table_${init_process_id.process_id}
                (origin_id, paper_no, sor_item_name, predicted_value, vqa_score, tenant_id, occur_count, batch_id)
                select aaom.origin_id,aaom.paper_no,aaom.sor_item_name,aaom.predicted_value,aaom.max_score as vqa_score
                ,aaom.tenant_id,aaom.occur_count, aaom.batch_id as batch_id
                from ${temp_schema_name}.a1_agg_occur_count_${init_process_id.process_id} aaom
                join ${temp_schema_name}.a2_max_occur_item_${init_process_id.process_id} sv
                on sv.origin_id =aaom.origin_id
                and sv.paper_no =aaom.paper_no
                and sv.sor_item_name =aaom.sor_item_name
                and sv.occur_count = aaom.occur_count
                where aaom.batch_id='${batch_id}' and aaom.tenant_id ='${tenant_id}';

                INSERT INTO ${temp_schema_name}.b1_scalar_multi_line_multi_occur_${init_process_id.process_id}
                (origin_id, paper_no, sor_item_name, occur_count, tenant_id, sv_occur_count, batch_id)
                SELECT origin_id ,paper_no,sor_item_name,count(*) as occur_count,
                ${tenant_id} as tenant_id,occur_count as sv_occur_count, batch_id
                FROM ${temp_schema_name}.a3_agg_input_table_${init_process_id.process_id}
                where batch_id='${batch_id}'
                GROUP BY origin_id ,paper_no,sor_item_name,sv_occur_count,batch_id
                HAVING count(*)>1;

                INSERT INTO ${temp_schema_name}.b2_scalar_single_line_single_occur_${init_process_id.process_id}
                (origin_id, paper_no, sor_item_name, occur_count, max_vqa_score, tenant_id, sv_occur_count, batch_id)
                SELECT agg.origin_id ,agg.paper_no,agg.sor_item_name,
                count(*) as occur_count,max(vqa_score) as max_vqa_score, ${tenant_id} as tenant_id,occur_count as sv_occur_count, agg.batch_id
                FROM ${temp_schema_name}.a3_agg_input_table_${init_process_id.process_id} agg
                where occur_count=1 and agg.batch_id='${batch_id}'
                GROUP BY agg.origin_id ,agg.paper_no,agg.sor_item_name,agg.occur_count,agg.batch_id
                HAVING count(*)=1;

                INSERT INTO ${temp_schema_name}.b3_scalar_multi_line_single_occur_${init_process_id.process_id}
                (origin_id, paper_no, sor_item_name, occur_count, vqa_score, tenant_id, sv_occur_count, batch_id)
                SELECT agg.origin_id ,agg.paper_no,agg.sor_item_name,
                count(*) as occur_count,max(vqa_score) as vqa_score, ${tenant_id} as tenant_id,occur_count as sv_occur_count, agg.batch_id
                FROM ${temp_schema_name}.a3_agg_input_table_${init_process_id.process_id} agg
                where occur_count!=1 and agg.batch_id='${batch_id}'
                GROUP BY agg.origin_id ,agg.paper_no,agg.sor_item_name,agg.occur_count, agg.batch_id
                HAVING count(*)=1;


               INSERT INTO ${temp_schema_name}.c1_rank_based_valuation_result_${init_process_id.process_id}
               (origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, freq, question_id, synonym_id, tenant_id, model_registry, batch_id)
                SELECT a.origin_id,a.paper_no,a.sor_item_name
                ,sv.b_box ,
                row_number()
                over(partition by sv.origin_id, sv.paper_no,sv.sor_item_name,sv.vqa_score
                order by sv.origin_id, sv.paper_no,sv.sor_item_name) as rnk,
                sv.predicted_value,sv.vqa_score, 1 as freq,sv.question_id,sv.synonym_id, ${tenant_id} as tenant_id , sv.model_registry, a.batch_id
                FROM ${temp_schema_name}.b3_scalar_multi_line_single_occur_${init_process_id.process_id} a
                inner JOIN ${temp_schema_name}.a3_agg_input_table_${init_process_id.process_id} agg
                on a.origin_id =agg.origin_id and a.paper_no=agg.paper_no and a.sor_item_name=agg.sor_item_name and a.vqa_score =agg.vqa_score
                inner JOIN ${temp_schema_name}.scalar_validation_${init_process_id.process_id} sv on
                sv.origin_id = agg.origin_id and sv.paper_no = agg.paper_no and sv.sor_item_name = agg.sor_item_name
                and sv.vqa_score = agg.vqa_score
                WHERE a.batch_id='${batch_id}' and sv.tenant_id = ${tenant_id};

                INSERT INTO ${temp_schema_name}.c2_scalar_max_score_multi_occur_freq_${init_process_id.process_id}
                (origin_id, paper_no, sor_item_name, tenant_id, vqa_score, occur_count, batch_id)
                select aa.origin_id ,aa.paper_no ,aa.sor_item_name, ${tenant_id} as tenant_id, max(aa.vqa_score) as vqa_score
                ,mc.occur_count as occur_count, mc.batch_id
                from ${temp_schema_name}.b1_scalar_multi_line_multi_occur_${init_process_id.process_id} mc
                join ${temp_schema_name}.a3_agg_input_table_${init_process_id.process_id} aa on aa.origin_id = mc.origin_id
                and aa.paper_no = mc.paper_no and aa.sor_item_name = mc.sor_item_name
                where mc.batch_id='${batch_id}'
                group by aa.origin_id ,aa.paper_no ,aa.sor_item_name,mc.occur_count, mc.batch_id
                ;

                INSERT INTO ${temp_schema_name}.c3_scalar_max_score_multi_line_${init_process_id.process_id}
                (origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, occur_count, question_id, synonym_id, tenant_id, model_registry, batch_id)
                SELECT sv.origin_id, sv.paper_no,sv.sor_item_name, sv.b_box, row_number()
                over(partition by sv.origin_id, sv.paper_no,sv.sor_item_name
                order by sv.origin_id, sv.paper_no,sv.sor_item_name) as rnk, sv.predicted_value,
                gc.vqa_score, gc.occur_count,sv.question_id,sv.synonym_id, ${tenant_id} as tenant_id, sv.model_registry, gc.batch_id
                FROM ${temp_schema_name}.c2_scalar_max_score_multi_occur_freq_${init_process_id.process_id} gc
                inner JOIN ${temp_schema_name}.scalar_validation_${init_process_id.process_id} sv on
                sv.origin_id = gc.origin_id and sv.paper_no = gc.paper_no and sv.sor_item_name = gc.sor_item_name and sv.vqa_score = gc.vqa_score
                where gc.batch_id='${batch_id}';

               INSERT INTO ${temp_schema_name}.final_valuation_result_${init_process_id.process_id}
               (origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, freq, question_id, synonym_id, tenant_id, model_registry, batch_id)
                SELECT a.origin_id,a.paper_no,a.sor_item_name,sv.b_box , 1 as rnk, sv.predicted_value,sv.vqa_score, 1 as freq
                ,sv.question_id,sv.synonym_id, ${tenant_id} as tenant_id , sv.model_registry, a.batch_id
                FROM ${temp_schema_name}.b2_scalar_single_line_single_occur_${init_process_id.process_id} a
                inner JOIN ${temp_schema_name}.a3_agg_input_table_${init_process_id.process_id} agg
                on a.origin_id =agg.origin_id and a.paper_no=agg.paper_no and a.sor_item_name=agg.sor_item_name and a.max_vqa_score =agg.vqa_score
                inner JOIN ${temp_schema_name}.scalar_validation_${init_process_id.process_id} sv on
                sv.origin_id = agg.origin_id and sv.paper_no = agg.paper_no and sv.sor_item_name = agg.sor_item_name
                and sv.vqa_score = agg.vqa_score
                WHERE sv.batch_id='${batch_id}' and sv.tenant_id = ${tenant_id};

                INSERT INTO ${temp_schema_name}.final_valuation_result_${init_process_id.process_id}
               (origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, freq, question_id, synonym_id, tenant_id, model_registry, batch_id)
                SELECT c1.origin_id,c1.paper_no,c1.sor_item_name
                ,c1.b_box , c1.rnk , c1.predicted_value,c1.vqa_score, 1 as freq,c1.question_id,c1.synonym_id, ${tenant_id} as tenant_id , c1.model_registry, c1.batch_id
                from ${temp_schema_name}.c1_rank_based_valuation_result_${init_process_id.process_id} c1
                where rnk=1 and c1.batch_id='${batch_id}';

                INSERT INTO ${temp_schema_name}.final_valuation_result_${init_process_id.process_id}
               (origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, freq, question_id, synonym_id, tenant_id, model_registry, batch_id)
                select t.origin_id,t.paper_no,t.sor_item_name
                ,t.b_box , t.rnk , t.predicted_value,t.vqa_score, 1 as freq,t.question_id,t.synonym_id, ${tenant_id} as tenant_id , t.model_registry, t.batch_id
                FROM ${temp_schema_name}.c3_scalar_max_score_multi_line_${init_process_id.process_id} t
                WHERE t.rnk=1 and t.batch_id='${batch_id}';


		"} on-condition if "true"=="true"


		transform as "final insert into aggregator table " on "intics_zio_db_conn" using {"

				INSERT INTO ${temp_schema_name}.aggregation_evaluator_${init_process_id.process_id}
				(created_on, created_user_id, last_updated_on, last_updated_user_id, tenant_id, aggregated_score, masked_score, group_id, origin_id, paper_no, predicted_value, vqa_score, rank, sor_item_attribution_id, sor_item_name, document_id, acc_transaction_id, b_box, root_pipeline_id,frequency,question_id,synonym_id, model_registry, batch_id)
				SELECT now(),'${created_user_id}',now(),'${created_user_id}',${tenant_id},0,0,'${group_id}',a.origin_id,a.paper_no,a.predicted_value,a.vqa_score,
				'1','1',a.sor_item_name, '${document_id}',1,a.b_box,'${gen_id.root_pipeline_id}',a.freq,a.question_id,a.synonym_id, a.model_registry, a.batch_id
				FROM ${temp_schema_name}.final_valuation_result_${init_process_id.process_id} a
				where a.batch_id = '${batch_id}';

		"} on-condition if "true"=="true"


		transform as "insert to completed voting audit" on "intics_zio_db_conn" using
		{"
				INSERT INTO sor_transaction.sor_transaction_pipeline_audit
				(group_id, created_on, created_by, user_id, tenant_id, status, stage, message, root_pipeline_id, batch_id)
				VALUES('${group_id}', now(), '${created_user_id}', '${created_user_id}', ${tenant_id}, 'COMPLETED', 'VOTING', 'voting completed for voting with group_id ${group_id}', '${gen_id.root_pipeline_id}', '${batch_id}');
		"} on-condition if "true"=="true"

		}
		catch{
		transform as "insert to completed voting audit" on "intics_zio_db_conn" using
		{"
				INSERT INTO sor_transaction.sor_transaction_pipeline_audit
				(group_id, created_on, created_by, user_id, tenant_id, status, stage, message, root_pipeline_id, batch_id)
				VALUES('${group_id}', now(), '${created_user_id}', '${created_user_id}', ${tenant_id}, 'FAILED', 'VOTING', 'voting failed for voting with group_id ${group_id}', '${gen_id.root_pipeline_id}', '${batch_id}');
		"} on-condition if "true"=="true"

		}
		finally{

		}
}
