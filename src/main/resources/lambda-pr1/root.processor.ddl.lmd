                CREATE TABLE IF NOT EXISTS ${temp_schema_name}.sor_item_multivalue_filtering_output_${init_process_id.process_id} (
                    id bigserial not null,
                    sor_item_attribution_id int8,
                    root_pipeline_id VARCHAR,
