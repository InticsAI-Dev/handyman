                );


                CREATE TABLE IF NOT EXISTS entity_voting.sor_item_multivalue_filtering_input (
                transaction_id bigserial NOT NULL,
                created_on timestamp NULL,
                created_user_id int8 NULL,
                last_updated_on timestamp NULL,
                last_updated_user_id int8 NULL,
                status varchar NULL,
                version int4 NULL,
                answer varchar NULL,
                b_box varchar NULL,
                document_id varchar NOT NULL,
                extracted_image_unit varchar NULL,
                group_id int4 NULL,
                image_dpi int8 NULL,
                image_height int8 NULL,
                image_width int8 NULL,
                model_id int8 NULL,
                model_info varchar NULL,
                origin_id varchar NOT NULL,
                paper_no int4 NOT NULL,
                question_id int8 NULL,
                root_pipeline_id int8 NULL,
                score int8 NULL,
                sor_item_attribution_id int4 NULL,
                sor_item_name varchar NOT NULL,
                sor_question varchar NOT NULL,
                synonym_id int8 NULL,
                tenant_id int8 NOT NULL,
                vqa_score float8 NULL,
                weight int4 NULL,
                model_registry varchar NULL,
                category text NULL,
                model_registry_id int8 NULL,
                stage varchar NULL,
                batch_id varchar NOT NULL,
                line_item_type varchar null,
                is_encrypted bool NULL,
                encryption_policy_id int8 NULL,
                encryption_policy varchar null,
                CONSTRAINT vqa_transaction_multival_pkey PRIMARY KEY (transaction_id)
                );

                CREATE TABLE IF NOT EXISTS entity_voting.sor_single_value_filtering_input_audit (
                transaction_id bigserial NOT NULL,
                created_on timestamp NULL,
                created_user_id int8 NULL,
                last_updated_on timestamp NULL,
                last_updated_user_id int8 NULL,
                status varchar NULL,
                version int4 NULL,
                answer varchar NULL,
                b_box varchar NULL,
                document_id varchar NOT NULL,
                extracted_image_unit varchar NULL,
                group_id int4 NULL,
                image_dpi int8 NULL,
                image_height int8 NULL,
                image_width int8 NULL,
                model_id int8 NULL,
                model_info varchar NULL,
                origin_id varchar NOT NULL,
                paper_no int4 NOT NULL,
                question_id int8 NULL,
                root_pipeline_id int8 NULL,
                score int8 NULL,
                sor_item_attribution_id int4 NULL,
                sor_item_name varchar NOT NULL,
                sor_question varchar NOT NULL,
                synonym_id int8 NULL,
                tenant_id int8 NOT NULL,
                vqa_score float8 NULL,
                weight int4 NULL,
                model_registry varchar NULL,
                category text NULL,
                model_registry_id int8 NULL,
                stage varchar NULL,
                batch_id varchar NOT NULL,
                line_item_type varchar null,
                is_encrypted bool NULL,
                encryption_policy_id int8 NULL,
                encryption_policy varchar null,
                CONSTRAINT vqa_transaction_single_input_pkey PRIMARY KEY (transaction_id)
                );



                CREATE TABLE IF NOT EXISTS entity_voting.sor_item_multivalue_filtering_output_audit (
                transaction_id bigserial NOT NULL,
                created_on timestamp NULL,
                created_user_id int8 NULL,
                last_updated_on timestamp NULL,
                last_updated_user_id int8 NULL,
                status varchar NULL,
                version int4 NULL,
                answer varchar NULL,
                b_box varchar NULL,
                document_id varchar NOT NULL,
                extracted_image_unit varchar NULL,
                group_id int4 NULL,
                image_dpi int8 NULL,
                image_height int8 NULL,
                image_width int8 NULL,
                model_id int8 NULL,
                model_info varchar NULL,
                origin_id varchar NOT NULL,
                paper_no int4 NOT NULL,
                question_id int8 NULL,
                root_pipeline_id int8 NULL,
                score int8 NULL,
                sor_item_attribution_id int4 NULL,
                sor_item_name varchar NOT NULL,
                sor_question varchar NOT NULL,
                synonym_id int8 NULL,
                tenant_id int8 NOT NULL,
                vqa_score float8 NULL,
                weight int4 NULL,
                model_registry varchar NULL,
                category text NULL,
                model_registry_id int8 NULL,
                stage varchar NULL,
                batch_id varchar NOT NULL,
                line_item_type varchar null,
                is_encrypted bool NULL,
                encryption_policy_id int8 NULL,
                encryption_policy varchar null,
                CONSTRAINT multivalue_filtering_output_pkey PRIMARY KEY (transaction_id)
                );

        "} on-condition if "true"=="true"


        transform as "creating sequence for inbound_id and group id" on "intics_zio_db_conn" using
        {"
                CREATE SEQUENCE IF NOT EXISTS ingestion.ingestion_num
                AS INT8
                START WITH 1
                INCREMENT BY 1;

                CREATE SEQUENCE IF NOT EXISTS ingestion.group_number
                AS INT8
                START WITH 1
                INCREMENT BY 1;

                CREATE SEQUENCE IF NOT EXISTS ingestion.batch_id
                AS INT8
                START WITH 1
                INCREMENT BY 1;

                CREATE SEQUENCE IF NOT EXISTS ingestion.origin_num
                AS INT8
                START WITH 1
                INCREMENT BY 1;
        "} on-condition if "true"=="true"

        assign as "gen_group_id" source "intics_zio_db_conn" using {"
                SELECT nextval('ingestion.ingestion_num') AS inbound_id;
                SELECT nextval('ingestion.group_number') AS group_id;
        "} on-condition if "${ingestion.main.caller.activator}"=="true"

        assign as "gen_id" source "intics_zio_db_conn" using {"
                SELECT '${root-ref-id}' AS root_pipeline_id,TO_CHAR(NOW(), '${current.date.directory.format}') AS formatted_date;
        "} on-condition if "true"=="true"


        assign as "gen_directory" source "intics_zio_db_conn" using {"
                SELECT replace(concat('${target_directory_path}','/processed_images/','${gen_id.formatted_date}/','tenant_${tenant_id}/','group_${gen_group_id.group_id}'),'//' ,'/') AS current_directory,
                replace(concat('${target_directory_path}','/outbound_zip/','${gen_id.formatted_date}/','tenant_${tenant_id}/','group_${gen_group_id.group_id}'),'//' ,'/') AS zip_directory;
        "} on-condition if "true"=="true"

        createDirectory as "creating time based directory for current pipeline" using
        {
            "${gen_directory.current_directory}"
        } on-condition if "true"=="true"

        createDirectory as "creating time based directory for outbound pipeline" using
        {
            "${gen_directory.zip_directory}"
        } on-condition if "true"=="true"

        transform as "Insert into pipeline directory info origin" on "intics_zio_db_conn" using
        {"
        INSERT INTO ingestion.pipeline_directory_info
        (target_directory_path, tenant_id, group_id, root_pipeline_id, created_on, updated_on, created_user_id, last_updated_user_id,
         transaction_id, formatted_date, current_directory, zip_directory, process_name, status)
        select '${target_directory_path}',${tenant_id},${gen_group_id.group_id},${root-ref-id},now(),now(),'${created_user_id}','${last_updated_user_id}',
        '${transaction_id}','${gen_id.formatted_date}','${gen_directory.current_directory}','${gen_directory.zip_directory}','FILE_PROCESS','STAGED';

        "} on-condition if "true"=="true"


        transform as "Insert into sor meta consolidated table" on "intics_zio_db_conn" using
        {"

            INSERT INTO ${temp_schema_name}.sor_meta_consolidated_${init_process_id.process_id} (
              root_pipeline_id, group_id,
              tenant_id, document_type, template_name,
              sor_container_id, sor_container_name,
              container_post_process_enable,container_post_process_class,container_priority,
              sor_item_id, sor_item_name,
              is_ocr_field_comparable,allowed_adapter,
              truth_entity_id,
              truth_entity_name, synonym_id, synonym,
              question_id, question, is_encrypted,
              encryption_policy_id,encryption_policy, line_item_type,
              model_id, model_name, sor_item_attribution_id, is_multi_entity_enabled
            )
            SELECT
              '${init_process_id.process_id}' as root_pipeline_id,
              '${gen_group_id.group_id}' as group_id,
              ai.tenant_id,
              ai.document_type,
              ai.template_name,
              sc.sor_container_id,
              sc.sor_container_name,
              sc.post_processing,
              sc.post_process_class_name,
              sc.container_priority,
              si.sor_item_id,
              si.sor_item_name,
              is_ocr_field_comparable,
              allowed_adapter,
              te.truth_entity_id,
              te.truth_entity_name,
              st.synonym_id,
              st.synonym,
              sq.question_id,
              sq.question,
              si.is_encrypted,
              si.encryption_policy_id,
              ep.encryption_policy,
              si.line_item_type,
              mr.model_id,
              mr.model_name,
              mr.sor_item_attribution_id,
              sc.is_multi_entity_enabled
            FROM
              sor_meta.sor_container sc
              LEFT JOIN sor_meta.sor_item si on sc.sor_container_id = si.sor_container_id
              AND sc.tenant_id = si.tenant_id
              LEFT JOIN sor_meta.asset_info ai on ai.document_type = sc.document_type
              AND ai.tenant_id = sc.tenant_id
              AND sc.document_type = ai.document_type
              LEFT JOIN sor_meta.truth_entity te on te.asset_id = ai.asset_id
              AND te.tenant_id = ai.tenant_id
              LEFT JOIN sor_meta.sor_tsynonym st on st.truth_entity_id = te.truth_entity_id
              AND st.tenant_id = te.tenant_id
              AND si.sor_item_id = st.sor_item_id
              AND st.sor_container_id = sc.sor_container_id
              LEFT JOIN sor_meta.sor_question sq on sq.synonym_id = st.synonym_id
              AND sq.tenant_id = st.tenant_id
              LEFT JOIN sor_meta.model_registry mr on mr.model_id = sq.model_registry_id
              LEFT JOIN sor_meta.encryption_policies ep on si.encryption_policy_id = ep.encryption_policy_id
            where
              sc.status = 'ACTIVE'
              and si.status = 'ACTIVE'
              and ai.status = 'ACTIVE'
              AND te.status = 'ACTIVE'
              and st.status = 'ACTIVE'
              and sq.status = 'ACTIVE'
              and ai.template_name = 'UNIVERSE'
              and ai.document_type = '${document_type}';

        "} on-condition if "true"=="true"


        callprocess as "calling gatekeeper ddl lambda"
        with-target "root.gatekeeper.ddl"
        from-file "${basepath}/root.gatekeeper.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "true"=="true"

        callprocess as "calling ingestion main ddl lambda"
        with-target "ingestion.main.ddl"
        from-file "${basepath}/ingestion/ingestion.main.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${ingestion.main.caller.activator}"=="true"

        callprocess as "calling preprocess ddl "
        with-target "preprocess.main.ddl"
        from-file "${basepath}/preprocess/preprocess.main.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${preprocess.main.caller.activator}"=="true"

        callprocess as "calling ddl lambda deep sift extraction table"
        with-target "deep.sift.ddl"
        from-file "${basepath}/deepSiftExtraction/deep.sift.ddl.lmd"
        using "intics_zio_db_conn"
        for-every
        {"
            SELECT 1;
        "} on-condition if "${deep.sift.extraction.activator}" == "true"

        callprocess as "calling table extraction ddl lambda"
        with-target "table.extraction.ddl"
        from-file "${basepath}/tableExtraction/table.extraction.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                    SELECT 1;
        "} on-condition if "${table.extraction.activator}"=="true"

        callprocess as "calling invoice validator ddl lambda"
        with-target "invoice.validator.ddl"
        from-file "${basepath}/invoiceValidator/invoice.validator.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                    SELECT 1;
        "} on-condition if "${invoice.validator.activator}"=="true"


        callprocess as "calling filtering ddl lambda"
        with-target "potential.filtering.ddl"
        from-file "${basepath}/filter/potential.filtering.ddl.lmd"
        using "intics_zio_db_conn"
        for-every
        {"
             SELECT ${init_process_id.process_id} as process_id;
        "} on-condition if "${root.filter.activator}"=="true"


        callprocess as "calling Agentic paper filter ddl lamba"
        with-target "agentic.paper.filter.ddl"
        from-file "${basepath}/agenticPaperFilter/agentic.paper.filter.ddl.lmd"
        using "intics_zio_db_conn"
        for-every
            {"
            SELECT 1;
            "} on-condition if "${agentic.paper.filter.activator}"=="true"

        callprocess as "calling paperWiseAgenticFilter Agentic paper filter ddl lambda"
        with-target "paperWiseAgenticFilter.agentic.paper.filter.ddl"
        from-file "${basepath}/agenticPaperFilter/paperRangeFilter/paper.range.filter.ddl.lmd"
        using "intics_zio_db_conn"
        for-every
            {"
            SELECT 1;
            "} on-condition if "${paper.range.filter.activator}"=="true"


        callprocess as "calling paper classification ddl lambda"
        with-target "paper.classification.ddl"
        from-file "${basepath}/paperClassification/paper.classification.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${paper.classification.activator}"=="true"

        callprocess as "calling noise model ddl"
        with-target "noise.detection.ddl"
        from-file "${basepath}/noiseDetection/noise.detection.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${noise.model.caller.activator}"=="true"

        callprocess as "calling doc_eyecue ddl"
            with-target "doc.eyecue.ddl"
            from-file "${basepath}/docEyeCue/doc.eyecue.ddl.lmd"
            using "intics_zio_db_conn"
            for-every {"
                SELECT 1;
            "}
            on-condition if "${doc.eyecue.activator}" == "true"

        callprocess as "calling qr extraction ddl lambda"
        with-target "qr.extraction.ddl"
        from-file "${basepath}/sorGrouping/qrExtraction/qr.extraction.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${qr.extraction.processor.activator}"=="true"

        callprocess as "calling urgency triage model ddl"
        with-target "ut.model.ddl"
        from-file "${basepath}/utModel/ut.model.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${ut.model.activator}"=="true"

         callprocess as "calling urgency triage beta model ddl"
          with-target "urgency.triage.beta.ddl"
          from-file "${basepath}/urgencyTriageBeta/urgency.triage.beta.ddl.lmd"
          using "intics_zio_db_conn"
          for-every {"
              SELECT 1;
          "} on-condition if "${ut.model.beta.activator}"=="true"

		 callprocess as "calling urgency triage ddl"
         with-target "urgency.triage.ddl"
         from-file "${basepath}/urgencyTriage/urgency.triage.ddl.lmd"
         using "intics_zio_db_conn"
         for-every {"
             SELECT 1;
         "} on-condition if "${urgency.triage.activator}"=="true"

        callprocess as "calling sor_transaction ddl "
        with-target "sor.transaction.ddl"
        from-file "${basepath}/sorTransaction/legacy/sor.transaction.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${sor.transaction.activator}"=="true"

        callprocess as "calling sor_transaction nextgen ddl "
        with-target "sor.transaction.ddl"
        from-file "${basepath}/sorTransaction/nextgen/sor.transaction.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${sor.transaction.nextgen.activator}"=="true"

     callprocess as "calling sor_validation ddl "
        with-target "sor.validation.ddl"
        from-file "${basepath}/sorValidation/legacy/sor.validation.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${sor.validation.main.activator}"=="true"



        callprocess as "calling sor grouping ddl lambda"
        with-target "sor.grouping.ddl"
        from-file "${basepath}/sorGrouping/sor.grouping.ddl.lmd"
        using "intics_zio_db_conn"
        for-every
        {"
                SELECT 1;
        "} on-condition if "${eoc.splitting.main.activator}"=="true"


        callprocess as "Init response ddl caller"
        with-target "response.ddl"
        from-file "${basepath}/responsebuilder/response.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${response.builder.activator}"=="true"

        callprocess as "calling eoc doc detail ddl"
        with-target "eocdoc.detail.ddl"
        from-file "${basepath}/responsebuilder/outboundTransformer/eocdoc.detail.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${eoc.transform.activator}"=="true"


        callprocess as "calling ddl"
        with-target "voting.score.ddl"
        from-file "${basepath}/voting/voting.score.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${eoc.splitting.main.activator}"=="true"

        callprocess as "calling masterdata ddl"
        with-target "master.data.ddl"
        from-file "${basepath}/masterDataLookup/master.data.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${masterdata.processor.activator}"=="true"

        callprocess as "calling control_data ddl"
        with-target "control.data.ddl"
        from-file "${basepath}/coverageReport/control.data.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${coveragereport.processor.activator}"=="none"


        callprocess as "calling alchemy migration ddl"
        with-target "alchemy.migration.ddl"
        from-file "${basepath}/alchemy_migration/alchemy.migration.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${alchemy.migration.activator}"=="true"


        callprocess as "calling product outbound ddl"
        with-target "product.outbound.ddl"
        from-file "${basepath}/productOutbound/product.outbound.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${product.response.builder.activator}"=="true"


        callprocess as "calling text extraction ddl"
        with-target "text.extraction.main.ddl.lmd"
        from-file "${basepath}/extraction/text/text.extraction.main.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${text.extraction.asis.activator}"=="true"

        callprocess as "calling kvp extraction ddl"
        with-target "kvp.extraction.ddl"
        from-file "${basepath}/extraction/kvp/kvp.extraction.main.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${kvp.extraction.asis.activator}"=="true"

        callprocess as "calling table extraction info ddl"
        with-target "table.extraction.main.ddl"
        from-file "${basepath}/extraction/table/table.extraction.main.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${table.extraction.asis.krypton.activator}"=="true"

        callprocess as "calling checkbox extraction ddl"
        with-target "checkbox.extraction.ddl"
        from-file "${basepath}/extraction/checkbox/checkbox.extraction.main.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${checkbox.extraction.asis.activator}"=="true"

    }
    catch{

        }
    finally{
    }

}
