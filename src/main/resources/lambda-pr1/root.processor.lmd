process "root.processor"
{
try {

        assign as "init_process_id" source "intics_zio_db_conn" using {"
                SELECT ${process-id} as process_id;
        "} on-condition if "true"=="true"

        assign as "pipeline" source "intics_zio_db_conn" using {"
                SELECT '${pipeline.build.number.placeholder}' as build_number;
        "} on-condition if "true"=="true"

        transform as  "Update the plugin Name audit table for root pipeline id" on "intics_zio_db_conn" using {"

                CREATE TABLE IF NOT EXISTS audit.pipeline_plugin_audit (
                        id bigserial NOT NULL,
                        transaction_id VARCHAR NULL,
                        pipeline_name VARCHAR NULL,
                        start_time TIMESTAMP NOT NULL,
                        end_time TIMESTAMP NOT NULL,
                        context VARCHAR NULL,
                        tenant_id INT8 NULL,
                        rootpipeline_id INT8 NULL
                );
        "} on-condition if "true" == "true"

        pipelineEventActionAudit as "Plugin Name audit"
        resource-conn "intics_zio_db_conn"
        using {"
                SELECT 1
        "} on-condition if "true"=="true"

        multitude as "multitude execution for the ddl and instance usage "
        on "${multitude.pre.vqa.option}" using
        {
                callprocess as "calling root processor ddl"
                with-target "root.processor.ddl"
                from-file "${basepath}/root.processor.ddl.lmd"
                using "intics_zio_db_conn"
                for-every {"
                        SELECT 1;
                "} on-condition if "${root.processor.ddl.activator}"=="true"

                callprocess as "calling instance usage"
                with-target "instance.usage.main"
                from-file "${basepath}/instanceUsage/instance.usage.main.lmd"
                using "intics_zio_db_conn"
                for-every {"
                        SELECT 1;
                "} on-condition if "${instance.usage.main.activator}"=="true"

        } on-condition if "true"=="true" fielding 2

        transform as "Update the pipeline info table for root pipeline id" on "intics_zio_db_conn" using
        {"
                CREATE TABLE IF NOT EXISTS info.pipeline_info (
                id int8 NOT NULL GENERATED BY DEFAULT AS IDENTITY( INCREMENT BY 1 MINVALUE 1 MAXVALUE 9223372036854775807 START 1 CACHE 1 NO CYCLE),
                created_on timestamp NULL,
                created_user_id int8 NULL,
                last_updated_on timestamp NULL,
                last_updated_user_id int8 NULL,
                status varchar NULL,
                version int4 NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL,
                transaction_id varchar NULL,
                CONSTRAINT pipeline_info_pkey PRIMARY KEY (id)
                );

                UPDATE info.pipeline_info
                SET root_pipeline_id=${root-ref-id}
                WHERE transaction_id='${transaction_id}' and tenant_id=${tenant_id};

        "} on-condition if "${ingestion.main.caller.activator}"=="true"


        assign as "pipeline_bus_mode" source "intics_zio_db_conn" using
        {"
                select  (case when '${paper.itemization.start.action}'='true' AND '${preprocess.main.caller.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as paper_itemizer;
                select  (case when '${auto.rotation.start.action}'='true' AND '${preprocess.main.caller.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as auto_rotation;
                select  (case when '${template.detection.start.action}'='true' AND '${preprocess.main.caller.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as template_detection;
                select  (case when '${text.extraction.start.action}'='true' AND '${preprocess.main.caller.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as text_extraction;
        "}on-condition if "true"=="true"

        coproStart as "Calling paper itemization copro start action" for "PAPER_ITEMIZATION"
        copro-server-url "${copro.paper.itemization.admin.start.url}"
        export-command "${copro.paper.itemization.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
                ${paperItemizationStartCommand}

        "} on-condition if "${pipeline_bus_mode.paper_itemizer}"=="true"


        coproStart as "Calling auto rotation copro start action" for "AUTO_ROTATION"
        copro-server-url "${copro.auto.rotation.admin.start.url}"
        export-command "${copro.auto.rotation.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
                ${autoRotationStartCommand}

        "} on-condition if "${pipeline_bus_mode.auto_rotation}"=="true"

        coproStart as "Calling template detection copro start action" for "TEMPLATE_DETECTION"
        copro-server-url "${copro.template.detection.admin.start.url}"
        export-command "${copro.template.detection.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
                ${templateDetectionStartCommand}

        "} on-condition if "${pipeline_bus_mode.template_detection}"=="true"

        coproStart as "Calling text extraction copro start action" for "TEXT_EXTRACTION"
        copro-server-url "${copro.text.extraction.admin.start.url}"
        export-command "${copro.text.extraction.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
                ${textExtractionStartCommand}

        "} on-condition if "${pipeline_bus_mode.text_extraction}"=="true"


        coproStart as "Calling noise Model copro start action" for "NOISE_MODEL"
        copro-server-url "${copro.noise.model.admin.start.url}"
        export-command "${copro.noisemodel.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
                ${noiseModelStartCommand}

        "}on-condition if "${pipeline_bus_mode.noise_model}" == "true"

        callprocess as "calling ingestion main caller"
        with-target "ingestion.main.caller"
        from-file "${basepath}/ingestion/ingestion.main.caller.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${ingestion.main.caller.activator}"=="true"

        callprocess as "calling root payload ddl"
        with-target "root.payload.ddl"
        from-file "${basepath}/root.payload.ddl.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${root.payload.ddl.activator}"=="true"

        callprocess as "Calling batch processor ddl"
        with-target "batch.process.ddl"
        from-file "${basepath}/batchProcess/batch.process.ddl.lmd"
        using "intics_zio_db_conn"
        for-every{"
                select 1;
        "}on-condition if "true"=="true"

        callprocess as "Calling noise detection ddl"
        with-target "noise.detection.ddl"
        from-file "${basepath}/noiseDetection/noise.detection.ddl.lmd"
        using "intics_zio_db_conn"
        for-every{"
                select 1;
        "}on-condition if "${noise.model.caller.activator}"=="true"

        callprocess as "Calling batch processor"
        with-target "batch.processor"
        from-file "${basepath}/batchProcess/batch.processor.lmd"
        using "intics_zio_db_conn"
        for-every{"
                select distinct batch_id,group_id
                from batching.sub_batching_process_payload_queue
                where status='STAGED' and group_id='${gen_group_id.group_id}' and tenant_id = '${tenant_id}';
        "}on-condition if "true"=="true" on-parallel-fielding "${batch.processor.parallel.execution.count}"

        callprocess as "calling data.coverage.lookup.main caller"
        with-target "data.coverage.lookup.main"
        from-file "${basepath}/datalookup/data.coverage.lookup.main.lmd"
        using "intics_zio_db_conn"
        for-every {"
                    SELECT 1;
        "} on-condition if "${coveragereport.processor.activator}"=="true"


        callprocess as "calling outbound.json.comparison.main caller"
        with-target "outbound.json.comparison.main"
        from-file "${basepath}/datalookup/outboundComparsion/outbound.json.comparison.main.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${kafka.production.activator}"=="true"



        zipBatch as "zip batch action"
        group-id "${gen_group_id.group_id}"
        output-dir "${gen_directory.current_directory}"
        on-resource-conn "intics_zio_db_conn"
        using  {
        }  on-condition if "${zip.file.batch.generation}"=="true"


        callprocess as "outbound csv generator from prediction"
        with-target "outbound.decrypted.csv.generate"
        from-file "${basepath}/productOutbound/outbound.decrypted.csv.generate.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${outbound.csv.generator.activator}"=="true"

        assign as "multipart_activator" source "intics_zio_db_conn" using
        {"
                SELECT  (CASE WHEN '${multipart.file.upload.activator}'='true' AND '${origin_type}'='WORKSPACE' then 'true' else 'false' END) AS workspace;
                SELECT  (CASE WHEN '${multipart.file.upload.activator}'='true' AND '${origin_type}'='TRANSACTION' then 'true' else 'false' END) AS pipeline_transaction;
        "} on-condition if "true"=="true"


        callprocess as "calling multipart delete lambda"
        with-target "post.processing.multipart.delete"
        from-file "${basepath}/responsebuilder/post.processing.multipart.delete.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${multipart.file.delete.activator}"=="true"


        assign as "timeline_audit" source "intics_zio_db_conn" using {"
                select root_pipeline_id as root_pipeline_id from audit.pipeline_execution_audit pea
                order by created_date desc limit 1;
                SELECT nextval('ingestion.pipeline_audit_num') AS pipeline_audit_id;
        "} on-condition if "true"=="false"

        transform as "creating sequence for inbound_id and group id" on "intics_zio_db_conn" using
        {"

                INSERT INTO ingestion.pipeline_level_audit
                (id, root_pipeline_id, pipeline_id, pipeline_name, time_diff, tenant_id)
                select '${timeline_audit.pipeline_audit_id}',pesa.root_pipeline_id,pesa.pipeline_id,pea.pipeline_name,
                age(MAX(pesa.created_date), MIN(pesa.created_date)) as time_diff, ${tenant_id}
                from audit.pipeline_execution_status_audit pesa
                inner join audit.pipeline_execution_audit pea on pea.pipeline_id = pesa.pipeline_id
                and pea.root_pipeline_id = pesa.root_pipeline_id
                inner join audit.action_execution_audit aea on aea.root_pipeline_id= pesa.root_pipeline_id
                and aea.pipeline_id = pesa.pipeline_id
                where pesa.root_pipeline_id='${timeline_audit.root_pipeline_id}'
                group by pesa.root_pipeline_id,pesa.pipeline_id,pea.pipeline_name
                order by time_diff desc;

        "} on-condition if "true"=="false"

        assign as "loadbalancer_queue" source "intics_zio_db_conn" using
        {"
                select COALESCE(array_agg(a.file_name), '{}'::text[]) as completed_files from
                outbound.outbound_payload_queue_archive opqa
                join ${temp_schema_name}.source_of_origin_${init_process_id.process_id} soo on soo.origin_id = opqa.origin_id
                join info.asset a on a.file_id = soo.file_id
                where opqa.root_pipeline_id = ${gen_id.root_pipeline_id};

                select COALESCE(array_agg(a.file_name), '{}'::text[]) as failed_files from
                outbound.outbound_payload_error_queue opqa
                join ${temp_schema_name}.source_of_origin_${init_process_id.process_id} soo on soo.origin_id = opqa.origin_id
                join info.asset a on a.file_id = soo.file_id
                where opqa.root_pipeline_id = ${gen_id.root_pipeline_id};

        "} on-condition if "${loadbalancer.queue.update.activator}" == "true"

        transform as "insert into load balancer update info table" on "intics_zio_db_conn" using
        {"

                INSERT INTO outbound.load_balancer_queue_update_info
                (tenant_id, root_pipeline_id, transaction_id, load_balancer_batch_id, endpoint_id,
                completed_files, failed_files)
                VALUES(${tenant_id}, ${gen_id.root_pipeline_id}, '${transaction_id}', ${load_balancer_batch_id}, ${endpoint_id},
        '${loadbalancer_queue.completed_files}', '${loadbalancer_queue.failed_files}');

        "}  on-condition if "${loadbalancer.queue.update.activator}" == "true"

        loadBalancerQueueUpdate as "loadBalancer Queue Update action"
        resource-conn "intics_zio_db_conn"
        load-balancer-ip "${load_balancer_sftp_host}"
        load-balancer-port "${load_balancer_port}"
        using {"

                SELECT id, tenant_id, transaction_id, load_balancer_batch_id, endpoint_id, completed_files, failed_files
                FROM outbound.load_balancer_queue_update_info
                where root_pipeline_id = ${gen_id.root_pipeline_id};

        "} on-condition if "${loadbalancer.queue.update.activator}" == "true"

        transform as "insert into pipeline summary audit " on "intics_zio_db_conn" using
        {"

                INSERT INTO macro.process_failed_status_audit
                (origin_id, failed_on_stage, process_failes_on, total_no_of_pages, message, root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, failed_on_stage, process_failes_on, total_no_of_pages, message, root_pipeline_id, '${tenant_id}', batch_id
                FROM ${temp_schema_name}.process_failed_status_${init_process_id.process_id};


                INSERT INTO macro.temp_error_document_detail_audit
                (origin_id, group_id, process_failed_on, status, stage, message, root_pipeline_id, batch_id)
                SELECT origin_id, group_id, process_failed_on, status, stage, message, root_pipeline_id, batch_id
                FROM ${temp_schema_name}.temp_error_document_detail_${init_process_id.process_id};

        "} on-condition if "true"=="true"


}
catch{

}
finally{


        callprocess as "calling pipeline cleanup file  "
        with-target "pipeline.cleanup.dml"
        from-file "${basepath}/cleanup/pipeline.cleanup.dml.lmd"
        using "intics_zio_db_conn"
        for-every
        {"
                select 1
        "} on-condition if "false"=="true"

        callprocess as "calling file cleanup for the pipeline"
        with-target "pipeline.folder.cleanup"
        from-file "${basepath}/sanitaryHub/folder/pipeline.folder.cleanup.lmd"
        using "intics_zio_db_conn"
        for-every
        {"
                select 1;
        "} on-condition if "${folder.cleanup.activator}"=="true"

       transform as "update transaction table to completed if origin mode is transaction" on "intics_zio_db_conn" using
        {"

                UPDATE info.transaction
                SET transaction_status='COMPLETED' , last_updated_on=now(), time_taken=EXTRACT(EPOCH FROM (now() - created_on))
                WHERE transaction_id='${transaction_id}' and tenant_id=${tenant_id};

        "} on-condition if "${origin_type}"=="TRANSACTION"

}
}