process "agentic.paper.filter.main"
{
	try{

        transform as "Insert into chrono-clash file wise input table using the common time interval for legacy agentic paper filter" on "intics_zio_db_conn" using {"
            INSERT INTO ${temp_schema_name}.agentic_legacy_filter_chrono_clash_input_${init_process_id.process_id}
            (root_pipeline_id, created_on, updated_on, batch_id, group_id, origin_id, tenant_id, time_frame, stage, status, transaction_id, downloaded_time, remaining_time)
            SELECT apfpq.root_pipeline_id, now(), now(), apfpq.batch_id, apfpq.group_id, apfpq.origin_id, apfpq.tenant_id,
            ${chronoclash.threshold.time} AS time_frame,
            'AGENTIC_PAPER_FILTER' AS stage,
            CASE
                WHEN now() - soo.file_downloaded_time >= (${chronoclash.threshold.time} * interval '1 minute')
                     AND '${chronoclash.activator}' = 'true' AND POSITION('AGENTIC_PAPER_FILTER_LEGACY' IN '${chronoclash.stage.controller}') > 0
                THEN 'ABORTED'
                ELSE 'IN_PROGRESS'
            END AS status,
            soo.transaction_id,
            soo.file_downloaded_time as downloaded_time,
            ((${chronoclash.threshold.time} * interval '1 minute') - (now() - soo.file_downloaded_time)) as remaining_time
            FROM paper_filter.agentic_paper_filter_payload_queue apfpq
            JOIN ${temp_schema_name}.downloaded_asset_source_details_${init_process_id.process_id} soo on soo.root_pipeline_id = apfpq.root_pipeline_id and soo.origin_id = apfpq.origin_id
            WHERE apfpq.batch_id='${batch_id}' and apfpq.tenant_id =${tenant_id} and apfpq.stage ='AGENTIC_PAPER_FILTER' and apfpq.status = 'STAGED';
        "} on-condition if "${chronoclash.specific.time.interval.enabler}" == "false"

        transform as "Insert into chrono-clash file wise input table using the specific time interval for legacy agentic paper filter" on "intics_zio_db_conn" using {"
            INSERT INTO ${temp_schema_name}.agentic_legacy_filter_chrono_clash_input_${init_process_id.process_id}
            (root_pipeline_id, created_on, updated_on, batch_id, group_id, origin_id, tenant_id, time_frame, stage, status, transaction_id, downloaded_time, remaining_time)
            SELECT apfpq.root_pipeline_id, now(), now(), apfpq.batch_id, apfpq.group_id, apfpq.origin_id, apfpq.tenant_id,
            CASE
                WHEN (CURRENT_TIME BETWEEN scti.start_time_frame::time AND scti.end_time_frame::time)
                THEN scti.time_frame
                ELSE ${chronoclash.threshold.time}
            END AS time_frame,
            'AGENTIC_PAPER_FILTER' AS stage,
            CASE
                WHEN now() - soo.file_downloaded_time >= ((time_frame) * interval '1 minute') AND '${chronoclash.activator}' = 'true' AND POSITION('AGENTIC_PAPER_FILTER_LEGACY' IN '${chronoclash.stage.controller}') > 0
                THEN 'ABORTED'
                ELSE 'IN_PROGRESS'
            END AS status,
            soo.transaction_id,
            soo.file_downloaded_time as downloaded_time,
            ((time_frame * interval '1 minute') - (now() - soo.file_downloaded_time)) as remaining_time
            FROM paper_filter.agentic_paper_filter_payload_queue apfpq
            JOIN ${temp_schema_name}.downloaded_asset_source_details_${init_process_id.process_id} soo on soo.root_pipeline_id = apfpq.root_pipeline_id and soo.origin_id = apfpq.origin_id
            JOIN config.spw_chrono_clash_time_interval scti on scti.tenant_id = apfpq.tenant_id and scti.instance = '${root-pipeline-name}' and CURRENT_TIME BETWEEN scti.start_time_frame::time AND scti.end_time_frame::time
            WHERE apfpq.batch_id='${batch_id}' and apfpq.tenant_id =${tenant_id} and apfpq.stage ='AGENTIC_PAPER_FILTER' and apfpq.status = 'STAGED';
        "} on-condition if "${chronoclash.specific.time.interval.enabler}" == "true"

 	 transform as "Update to IN PROGRESS in agentic paper filter payload queue" on "intics_zio_db_conn" using
     {"
          UPDATE paper_filter.agentic_paper_filter_payload_queue as apfpq
          SET status=a.status, consumed_on_ts = now(), consumer_process_id = '${process-id}'
          FROM ${temp_schema_name}.agentic_legacy_filter_chrono_clash_input_${init_process_id.process_id} a
          WHERE a.origin_id = apfpq.origin_id and apfpq.batch_id ='${batch_id}' and apfpq.status='STAGED' and apfpq.group_id='${group_id}' and apfpq.tenant_id = ${tenant_id};

            UPDATE paper_filter.sub_batch_agentic_paper_filter_payload_queue as apfpq
            SET status=a.status, consumed_on_ts =  now(), consumer_process_id = '${process-id}'
            FROM ${temp_schema_name}.agentic_legacy_filter_chrono_clash_input_${init_process_id.process_id} a
            WHERE a.origin_id = apfpq.origin_id and apfpq.batch_id ='${batch_id}' and apfpq.sub_batch_id ='${payload.sub_batch_id}' and apfpq.status='STAGED' and apfpq.group_id='${group_id}' and apfpq.tenant_id = ${tenant_id};


            update ingestion.pipeline_queue_status_audit as apfpq
            set status = a.status, consumed_on_ts=now(), consumer_process_id = '${process-id}'
            FROM ${temp_schema_name}.agentic_legacy_filter_chrono_clash_input_${init_process_id.process_id} a
            where a.origin_id = apfpq.origin_id and apfpq.group_id=${group_id} and apfpq.batch_id='${batch_id}' and apfpq.tenant_id =${tenant_id} and apfpq.stage ='AGENTIC_PAPER_FILTER' and apfpq.status='STAGED';


            UPDATE batching.sub_batching_process_payload_queue as sbppq
            SET status = a.status, stage='AGENTIC_PAPER_FILTER'
            FROM ${temp_schema_name}.agentic_legacy_filter_chrono_clash_input_${init_process_id.process_id} a
            WHERE a.origin_id = sbppq.origin_id and sbppq.group_id='${group_id}' and sbppq.tenant_id='${tenant_id}' and sbppq.batch_id ='${batch_id}';

            INSERT INTO paper_filter.agentic_paper_filter_pipeline_audit
            (process_id, origin_id,group_id, created_on, status, stage, message,root_pipeline_id, tenant_id, batch_id)
            SELECT apfpq.producer_process_id, apfpq.origin_id, apfpq.group_id,now(), 'STARTED', 'AGENTIC_PAPER_FILTER', 'agentic paper filter started for group_id ${group_id}', apfpq.root_pipeline_id, ${tenant_id}, apfpq.batch_id
            FROM paper_filter.agentic_paper_filter_payload_queue apfpq
            JOIN ${temp_schema_name}.agentic_legacy_filter_chrono_clash_input_${init_process_id.process_id} a ON a.origin_id = apfpq.origin_id AND a.tenant_id = apfpq.tenant_id
            WHERE apfpq.status = a.status and apfpq.group_id='${group_id}' and apfpq.tenant_id = ${tenant_id} and apfpq.batch_id = '${batch_id}';

     "}  on-condition if "true"=="true"


        transform as "Insert into agentic paper filter input table" on "intics_zio_db_conn" using
        {"
            INSERT INTO ${temp_schema_name}.agentic_paper_filter_input_data_${init_process_id.process_id} (
            process_id, tenant_id, template_id, group_id, origin_id, paper_no,
            file_path, root_pipeline_id, template_name, batch_id, created_on,
            user_prompt, system_prompt
            )
            SELECT
            a.root_pipeline_id as process_id , a.tenant_id, a.channel_id as template_id, a.group_id, a.origin_id, a.paper_no,
             a2.file_path as file_path, b.root_pipeline_id, a.template_name,
            b.batch_id, now() as created_on, r.base_prompt as user_prompt, r.system_prompt as system_prompt
            FROM paper_filter.agentic_paper_filter_payload_queue b
            JOIN ${temp_schema_name}.source_of_truth_${init_process_id.process_id} a
                ON a.origin_id = b.origin_id AND a.tenant_id = b.tenant_id AND a.batch_id = b.batch_id
            join ${temp_schema_name}.asset_${init_process_id.process_id} a2 on a.asset_id =a2.asset_id  and a.tenant_id=a2.tenant_id
            LEFT JOIN sor_meta.radon_prompt_table r
                ON r.tenant_id = a.tenant_id
            WHERE b.status = 'IN_PROGRESS'
            AND a.group_id = ${group_id}
            AND a.tenant_id = ${tenant_id}
            AND b.batch_id = '${batch_id}'
            AND r.process = 'AGENTIC_PAPER_FILTER'
            AND r.use_case = 'PAPER_FILTER'
            AND r.status ='ACTIVE'
            AND r.version = '${agentic.paper.filter.prompt.version.value}'
            AND r.prompt_type = 'DOCUMENT'
            AND r.document_type = '${document_type}'
            AND a.paper_no BETWEEN ${payload.lower_bound_paper_no} AND ${payload.upper_bound_paper_no};
        "} on-condition if "${agentic.paper.filter.activator}"=="true"

          transform as "Insert into agentic paper filter output table for the default entry" on "intics_zio_db_conn" using
              {"
                 INSERT INTO ${temp_schema_name}.agentic_paper_filter_output_${init_process_id.process_id}
                 (process_id, tenant_id, template_id, group_id, batch_id, origin_id, paper_no, file_path,
                 file_name, status, stage, message, template_name, is_blank_page, created_on, last_updated_on,
                 root_pipeline_id, model_name, model_version, request, response, endpoint, container_name,
                 container_value)
                 SELECT b.consumer_process_id, a.tenant_id, '', a.group_id, a.batch_id, a.origin_id,
                 MIN(a.paper_no) AS paper_no, a2.file_path as file_path, '' AS file_name, 'COMPLETED' AS status, 'AGENTIC_PAPER_FILTER' AS stage,
                 'Agentic Paper filter default entry is completed' AS message, a.template_name, 'no' AS is_blank_page, NOW() AS created_on, NOW() AS
                 last_updated_on, a.root_pipeline_id, 'DEFAULT' AS model_name, 1 AS model_version, '' AS request,
                 '' AS response, '' AS endpoint, s.sor_container_name, CASE WHEN s.status = 'ACTIVE'
                 THEN true ELSE false END AS container_value
                 FROM  paper_filter.agentic_paper_filter_payload_queue b
                 JOIN ${temp_schema_name}.source_of_truth_${init_process_id.process_id} a
                 ON a.origin_id = b.origin_id AND a.tenant_id = b.tenant_id
                 JOIN ${temp_schema_name}.asset_${init_process_id.process_id} a2 ON a.asset_id = a2.asset_id
                 AND a.tenant_id = a2.tenant_id
                 JOIN sor_meta.sor_container s ON s.status IN ('ACTIVE') AND s.tenant_id = a2.tenant_id
                 WHERE a.root_pipeline_id = ${init_process_id.process_id} AND a.tenant_id = ${tenant_id}
                 AND a.batch_id = '${batch_id}' AND s.sor_container_name ='FAX_DETAILS'
                 AND s.container_priority = 'MANDATORY' AND s.status IN ('ACTIVE')
                 GROUP BY b.consumer_process_id, a.tenant_id, a.group_id, a.batch_id, a.origin_id,
                  a.template_name, a.root_pipeline_id, s.sor_container_name, s.status, a2.file_path;
              "} on-condition if "${agentic.paper.filter.activator}"=="true"

	   agenticPaperFilter as "container based agentic paper filter using radon for group_id ${group_id} for batch id ${batch_id}"
       resource-conn "intics_zio_db_conn"
       result-table "${temp_schema_name}.agentic_paper_filter_output_${init_process_id.process_id}"
       copro-url "${copro.agentic.paper.filter.url}"
       process-id "${init_process_id.process_id}"

       using {"
              SELECT a.process_id, a.tenant_id, a.template_id, a.group_id, a.origin_id, a.paper_no, a.file_path, a.root_pipeline_id, a.template_name, a.batch_id, a.created_on, a.user_prompt, a.system_prompt
              FROM ${temp_schema_name}.agentic_paper_filter_input_data_${init_process_id.process_id} a
              WHERE a.tenant_id = ${tenant_id} AND a.batch_id = '${batch_id}' AND a.group_id = ${gen_group_id.group_id} and a.paper_no BETWEEN ${payload.lower_bound_paper_no} AND ${payload.upper_bound_paper_no};

       "} on-condition if "${agentic.paper.filter.activator}"=="true" on-parallel-fielding "${agentic.paper.filter.krypton.API.count}"



        callprocess as "calling Agentic paper filter process"
        with-target "agentic.paper.filter.processor"
        from-file "${basepath}/agenticPaperFilter/agentic.paper.filter.processor.lmd"
        using "intics_zio_db_conn"
        for-every
            {"
            SELECT 1;
            "} on-condition if "${agentic.paper.filter.activator}"=="true"
        }
    	catch{
            transform as "Failed in agentic paper filter main caller" on "intics_zio_db_conn" using
            {"
                INSERT INTO paper_filter.agentic_paper_filter_pipeline_audit
                (process_id, group_id, created_on, status, stage, message,root_pipeline_id, tenant_id, batch_id )
                VALUES('${init_process_id.process_id}', '${gen_group_id.group_id}', now(), 'FAILED', 'AGENTIC_PAPER_FILTER', 'failed in agentic paper filter main caller','${gen_id.root_pipeline_id}', ${tenant_id}, '${batch_id}');

                UPDATE paper_filter.sub_batch_agentic_paper_filter_payload_queue
                SET status='FAILED', consumed_on_ts =  now(), consumer_process_id = '${process-id}'
                WHERE batch_id ='${batch_id}' and sub_batch_id ='${payload.sub_batch_id}' and status='IN_PROGRESS' and group_id='${group_id}' and tenant_id = ${tenant_id};

            "}on-condition if "true"=="true"

            transform as "Update to FAILED in agentic paper filter payload queue" on "intics_zio_db_conn" using
             {"
                    UPDATE paper_filter.agentic_paper_filter_payload_queue a
                    SET status='FAILED',  stage='AGENTIC_PAPER_FILTER'
                    WHERE a.group_id='${group_id}'  and a.tenant_id='${tenant_id}'
                    and a.batch_id ='${batch_id}' and a.status='IN_PROGRESS';

                    update ingestion.pipeline_queue_status_audit as a
                    set status = 'FAILED' , consumed_on_ts=now(), consumer_process_id = '${process-id}'
                    where  a.group_id=${group_id}
                    and a.batch_id='${batch_id}' and a.tenant_id =${tenant_id} and a.stage ='AGENTIC_PAPER_FILTER' and status='IN_PROGRESS';

             "}  on-condition if "true"=="true"
	}
	finally{

		 transform as "completed in agentic paper filter main caller" on "intics_zio_db_conn" using
        {"
           INSERT INTO paper_filter.agentic_paper_filter_pipeline_audit
               (process_id, group_id, created_on, status, stage, message,root_pipeline_id, tenant_id, batch_id)
               VALUES('${init_process_id.process_id}', '${gen_group_id.group_id}', now(), 'COMPLETED', 'AGENTIC_PAPER_FILTER', 'completed in agentic paper filter main caller','${gen_id.root_pipeline_id}', ${tenant_id}, '${batch_id}');
        "}on-condition if "true"=="true"

         transform as "update chronoclash audit form temporary tables" on "intics_zio_db_conn" using
         {"
                UPDATE chrono_clash.chrono_clash_audit as cca
                SET updated_on=now(), stage='AGENTIC_PAPER_FILTER', status=ppq.status, remaining_time=((a.time_frame * interval '1 minute') - (now() - a.downloaded_time))
                FROM ${temp_schema_name}.agentic_legacy_filter_chrono_clash_input_${init_process_id.process_id} a
                JOIN paper_filter.agentic_paper_filter_payload_queue ppq ON ppq.origin_id = a.origin_id AND ppq.tenant_id = a.tenant_id
                WHERE cca.origin_id = a.origin_id and a.group_id=${group_id} and a.tenant_id = ${tenant_id} and a.batch_id ='${batch_id}';


         "}  on-condition if "${chronoclash.activator}"=="true"

	}
}