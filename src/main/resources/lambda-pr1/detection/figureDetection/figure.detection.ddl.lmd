process "figure.detection.ddl"
{
try{
        transform as "create figure_detection ddl" on "intics_zio_db_conn" using
        {"

                CREATE TABLE if not exists figure_detection.figure_detection_payload_queue_archive
                (
                producer_process_id INT8 NOT NULL,
                consumer_process_id INT8 NULL,
                group_id INT4 NOT NULL,
                origin_id VARCHAR NOT NULL,
                created_on timestamp NOT NULL,
                status VARCHAR NOT NULL,
                stage  VARCHAR NOT NULL,
                consumed_on_ts timestamp NULL,
                root_pipeline_id INT8 NULL,
                tenant_id INT8 NULL,
                batch_id VARCHAR NULL,
                CONSTRAINT figure_detection_payload_queue_archive_pk PRIMARY KEY (group_id,origin_id,tenant_id)
                );

                CREATE TABLE if not exists figure_detection.figure_detection_payload_error_queue
                (
                producer_process_id INT8 NOT NULL,
                consumer_process_id INT8 NULL,
                origin_id VARCHAR NOT NULL,
                group_id INT4 NULL,
                created_on timestamp NOT NULL,
                status VARCHAR NOT NULL,
                stage VARCHAR NOT NULL,
                message VARCHAR NULL,
                consumed_on_ts timestamp NULL,
                root_pipeline_id INT8 NULL,
                tenant_id INT8 NULL,
                batch_id VARCHAR NULL,
                CONSTRAINT figure_detection_payload_error_queue_pk PRIMARY KEY (producer_process_id, origin_id,tenant_id)
                );

                CREATE TABLE IF NOT EXISTS ${temp_schema_name}.figure_detection_input_${init_process_id.process_id} (
                        id BIGSERIAL NOT NULL,
                        origin_id varchar NULL,
                        input_file_path varchar NULL,
                        paper_no INT4 NULL,
                        threshold FLOAT8 NULL,
                        root_pipeline_id INT8 NULL,
                        tenant_id INT8 NULL,
                        group_id INT4 NULL,
                        process_id INT4 NULL,
                        process TEXT NULL,
                        batch_id VARCHAR NULL
                );

                CREATE TABLE IF NOT EXISTS figure_detection.figure_detection_input_audit (
                    id BIGSERIAL NOT NULL,
                    origin_id varchar NULL,
                    input_file_path varchar NULL,
                    paper_no INT4 NULL,
                    threshold FLOAT8 NULL,
                    root_pipeline_id INT8 NULL,
                    tenant_id INT8 NULL,
                    group_id INT4 NULL,
                    process_id INT4 NULL,
                    process TEXT NULL,
                    batch_id VARCHAR NULL
                );



                create table if not exists figure_detection.figure_detection_result(
                id BIGSERIAL NOT NULL,
                created_on timestamp NOT NULL,
                created_user_id varchar NOT NULL,
                last_updated_on timestamp NULL,
                last_updated_user_id varchar NULL,
                origin_id varchar NOT NULL,
                paper_no INT4 NOT NULL,
                encode TEXT NULL,
                group_id INT4 NULL,
                file_path VARCHAR NULL,
                tenant_id INT8 NULL,
                process_id INT8 NULL,
                root_pipeline_id INT8 NULL,
                process VARCHAR NULL,
                status varchar NULL,
                stage varchar NULL,
                message TEXT NULL,
                model_name VARCHAR NULL,
                model_version VARCHAR NULL,
                batch_id VARCHAR NULL,
                request text NULL,
                response text NULL,
                endpoint varchar NULL,
                CONSTRAINT figure_detection_result_pk PRIMARY KEY (id)
                );

                CREATE TABLE IF NOT EXISTS figure_detection.figure_detection_pipeline_audit (
                id BIGSERIAL NOT NULL,
                process_id bigint NULL,
                origin_id VARCHAR NULL,
                group_id VARCHAR NULL,
                created_on VARCHAR NULL,
                status VARCHAR NULL,
                stage VARCHAR NULL,
                message VARCHAR NULL,
                root_pipeline_id INT8 NULL,
                tenant_id INT8 NULL,
                batch_id VARCHAR NULL
                );
        "} on-condition if "true"=="true"
}

catch{
}

finally{
}
}