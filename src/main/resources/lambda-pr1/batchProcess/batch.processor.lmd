process "batch.processor"
{
try {

        transform as "Batch insert for preprocess and outbound payload queue" on "intics_zio_db_conn" using
        {"

                UPDATE batching.sub_batching_process_payload_queue
                SET status='IN_PROGRESS', consumed_on_ts = now(), consumer_process_id = '${process-id}'
                WHERE status='STAGED' and group_id='${gen_group_id.group_id}' and batch_id ='${batch_id}' and tenant_id = ${tenant_id};

                INSERT INTO preprocess.preprocess_payload_queue
                ( producer_process_id, origin_id,group_id, batch_id, created_on, status, stage,root_pipeline_id, tenant_id)
                select producer_process_id,origin_id,group_id, batch_id,now(), 'STAGED', 'PREPROCESS',root_pipeline_id, tenant_id
                from batching.sub_batching_process_payload_queue
                where batch_id ='${batch_id}' and group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id};

                INSERT INTO ingestion.pipeline_queue_status_audit
                (producer_process_id, consumer_process_id, origin_id,batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, origin_type)
                select producer_process_id, consumer_process_id, origin_id, batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, '${origin_type}'
                from preprocess.preprocess_payload_queue
                where group_id='${gen_group_id.group_id}' and batch_id='${batch_id}' and tenant_id =${tenant_id};

                INSERT INTO outbound.outbound_payload_queue
                (producer_process_id, origin_id, group_id, batch_id, created_on, status, stage,root_pipeline_id, tenant_id)
                select producer_process_id,origin_id,group_id, batch_id,now(), 'STAGED', 'OUTBOUND',root_pipeline_id, ${tenant_id}
                from batching.sub_batching_process_payload_queue
                where batch_id ='${batch_id}' and group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and '${origin_type}'='TRANSACTION' and '${response.builder.activator}'='true';

                INSERT INTO ingestion.pipeline_queue_status_audit
                (producer_process_id, consumer_process_id, origin_id,batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, origin_type)
                select producer_process_id, consumer_process_id, origin_id, batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, '${origin_type}'
                from outbound.outbound_payload_queue
                where group_id='${gen_group_id.group_id}' and batch_id='${batch_id}' and tenant_id =${tenant_id} and '${origin_type}'='TRANSACTION' and '${response.builder.activator}'='true';


                INSERT INTO control_data.control_data_payload_queue
                (producer_process_id, origin_id, group_id, batch_id, created_on, status, stage, root_pipeline_id, tenant_id)
                SELECT producer_process_id, origin_id, group_id, batch_id, now(),'STAGED', 'CONTROL_DATA', root_pipeline_id, ${tenant_id}
                from batching.sub_batching_process_payload_queue
                where batch_id ='${batch_id}' and group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and '${origin_type}'='TRANSACTION';

                INSERT INTO alchemy_migration.alchemy_migration_payload_queue
                (producer_process_id, origin_id, group_id, created_on, status, stage, root_pipeline_id,tenant_id, batch_id)
                SELECT producer_process_id, origin_id, group_id, cast(created_on as TIMESTAMP), 'STAGED', 'ALCHEMY_MIGRATION', root_pipeline_id, ${tenant_id}, batch_id
                from batching.sub_batching_process_payload_queue
                where batch_id ='${batch_id}' and group_id=${gen_group_id.group_id} and tenant_id = ${tenant_id} and '${origin_type}'='TRANSACTION' and '${alchemy.migration.activator}'='true';

                INSERT INTO ingestion.pipeline_queue_status_audit
                (producer_process_id, consumer_process_id, origin_id,batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, origin_type)
                select producer_process_id, consumer_process_id, origin_id, batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, '${origin_type}'
                from alchemy_migration.alchemy_migration_payload_queue
                where group_id=${gen_group_id.group_id} and batch_id='${batch_id}' and tenant_id =${tenant_id} and '${origin_type}'='TRANSACTION' and '${alchemy.migration.activator}'='true';

                INSERT INTO product_outbound.product_outbound_payload_queue
                (producer_process_id, origin_id, group_id, created_on, status, stage, root_pipeline_id,tenant_id,batch_id)
                SELECT producer_process_id, origin_id, group_id, cast(created_on as TIMESTAMP), 'STAGED', 'PRODUCT_OUTBOUND', root_pipeline_id,tenant_id,batch_id
                from batching.sub_batching_process_payload_queue
                where batch_id ='${batch_id}' and group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and '${origin_type}'='TRANSACTION' and '${product.response.builder.activator}'='true';

                INSERT INTO ingestion.pipeline_queue_status_audit
                (producer_process_id, consumer_process_id, origin_id,batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, origin_type)
                select producer_process_id, consumer_process_id, origin_id, batch_id, group_id, created_on, status, stage, consumed_on_ts::timestamp , root_pipeline_id, tenant_id, '${origin_type}'
                from product_outbound.product_outbound_payload_queue
                where group_id='${gen_group_id.group_id}' and batch_id='${batch_id}' and tenant_id =${tenant_id} and '${origin_type}'='TRANSACTION' and '${product.response.builder.activator}'='true';

        "} on-condition if "${ingestion.main.caller.activator}"=="true"

            transform as "Batch insert for DocEyeCue payload queue" on "intics_zio_db_conn" using
        {"
            INSERT INTO doc_eyecue.doc_eyecue_payload_queue (
                producer_process_id,
                consumer_process_id,
                origin_id,
                group_id,
                batch_id,
                tenant_id,
                root_pipeline_id,
                transaction_id,
                source,
                status,
                stage,
                created_on,
                last_updated_on,
                consumed_on_ts
            )
            SELECT
                sbpq.producer_process_id,
                NULL AS consumer_process_id,
                sbpq.origin_id,
                sbpq.group_id,
                sbpq.batch_id,
                sbpq.tenant_id,
                soo.root_pipeline_id,
                idfd.transaction_id,
                ifd.source,
                'STAGED',
                'DOC_EYE_CUE',
                NOW(),
                NULL,
                NULL
            FROM batching.sub_batching_process_payload_queue sbpq
            INNER JOIN ${temp_schema_name}.source_of_origin_${init_process_id.process_id} soo
                ON sbpq.root_pipeline_id = soo.root_pipeline_id
               AND sbpq.origin_id = soo.origin_id
               AND sbpq.batch_id = soo.batch_id
               AND sbpq.tenant_id = soo.tenant_id
            INNER JOIN ${temp_schema_name}.asset_${init_process_id.process_id} a
                ON soo.asset_id = a.asset_id
            INNER JOIN inbound_config.ingestion_downloaded_file_details idfd
                ON a.file_name = idfd.file_name
               AND soo.transaction_id = idfd.transaction_id
            INNER JOIN inbound_config.ingestion_file_details ifd
                ON idfd.inbound_transaction_id = ifd.inbound_transaction_id
            WHERE sbpq.group_id = '${gen_group_id.group_id}'
              AND sbpq.batch_id = '${batch_id}'
              AND sbpq.tenant_id = ${tenant_id}
              AND ifd.source = 'Filenet';

            INSERT INTO doc_eyecue.doc_eyecue_pipeline_audit
                (origin_id, group_id, tenant_id, process_id, created_on, status, stage, message, root_pipeline_id, batch_id)
            SELECT
                sbpq.origin_id,
                sbpq.group_id,
                sbpq.tenant_id,
                ${init_process_id.process_id},
                NOW(),
                'FAILED',
                'DOC_EYE_CUE',
                CASE
                    WHEN ifd.source IS NULL THEN 'Source file is not from Filenet'
                    WHEN ifd.source <> 'Filenet' THEN concat('Source file is not from Filenet. Found source: ', ifd.source)
                    ELSE 'Unknown condition – skipped from payload queue'
                END,
                soo.root_pipeline_id,
                sbpq.batch_id
            FROM batching.sub_batching_process_payload_queue sbpq
            INNER JOIN ${temp_schema_name}.source_of_origin_${init_process_id.process_id} soo
                ON sbpq.root_pipeline_id = soo.root_pipeline_id
               AND sbpq.origin_id = soo.origin_id
               AND sbpq.batch_id = soo.batch_id
               AND sbpq.tenant_id = soo.tenant_id
            INNER JOIN ${temp_schema_name}.asset_${init_process_id.process_id} a
                ON soo.asset_id = a.asset_id
            LEFT JOIN inbound_config.ingestion_downloaded_file_details idfd
                ON a.file_name = idfd.file_name
               AND soo.transaction_id = idfd.transaction_id
            LEFT JOIN inbound_config.ingestion_file_details ifd
                ON idfd.inbound_transaction_id = ifd.inbound_transaction_id
            WHERE sbpq.group_id = '${gen_group_id.group_id}'
              AND sbpq.batch_id = '${batch_id}'
              AND sbpq.tenant_id = ${tenant_id}
              AND (
                    ifd.source IS NULL
                    OR ifd.source <> 'Filenet'
                  );
        "} on-condition if "${doc.eyecue.activator}"=="true"


        transform as "Batch insert for Asis pipeline" on "intics_zio_db_conn" using
        {"

                INSERT INTO text_extraction.text_extraction_payload_queue
                (producer_process_id, origin_id, group_id, created_on, status, stage, root_pipeline_id,tenant_id,batch_id)
                SELECT producer_process_id, origin_id, group_id, cast(created_on as TIMESTAMP), 'STAGED', 'TEXT_EXTRACTION', root_pipeline_id,'${tenant_id}','${batch_id}'
                from batching.sub_batching_process_payload_queue
                where batch_id ='${batch_id}' and group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and '${origin_type}'='TRANSACTION' and '${text.extraction.asis.activator}'='true';

                INSERT INTO kvp_extraction.kvp_extraction_payload_queue
                (producer_process_id, origin_id, group_id, created_on, status, stage, root_pipeline_id,tenant_id,batch_id)
                SELECT producer_process_id, origin_id, group_id, cast(created_on as TIMESTAMP), 'STAGED', 'KVP_EXTRACTION', root_pipeline_id,'${tenant_id}','${batch_id}'
                from batching.sub_batching_process_payload_queue
                where batch_id ='${batch_id}' and group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and '${origin_type}'='TRANSACTION' and '${kvp.extraction.asis.activator}'='true';

                INSERT INTO table_extraction_info.table_extraction_payload_queue
                (producer_process_id, origin_id, group_id, created_on, status, stage, root_pipeline_id,tenant_id,batch_id)
                SELECT producer_process_id, origin_id, group_id, cast(created_on as TIMESTAMP), 'STAGED', 'TABLE_EXTRACTION', root_pipeline_id,'${tenant_id}','${batch_id}'
                from batching.sub_batching_process_payload_queue
                where batch_id ='${batch_id}' and group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and '${origin_type}'='TRANSACTION' and '${table.extraction.asis.krypton.activator}'='true';

                INSERT INTO outbound_transform_asis.outbound_transform_asis_payload_queue
                (producer_process_id, origin_id, group_id, created_on, status, stage, root_pipeline_id,tenant_id,batch_id)
                SELECT producer_process_id, origin_id, group_id, cast(created_on as TIMESTAMP), 'STAGED', 'OUTBOUND_TRANSFORM_ASIS', root_pipeline_id,'${tenant_id}','${batch_id}'
                from batching.sub_batching_process_payload_queue
                where batch_id ='${batch_id}' and group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and '${origin_type}'='TRANSACTION' and '${outbound.asis.transform.activator}'='true';


                INSERT INTO outbound_asis.outbound_asis_payload_queue
                (producer_process_id, origin_id, group_id, created_on, status, stage, root_pipeline_id,tenant_id,batch_id)
                SELECT producer_process_id, origin_id, group_id, cast(created_on as TIMESTAMP), 'STAGED', 'OUTBOUND_ASIS', root_pipeline_id,'${tenant_id}','${batch_id}'
                from batching.sub_batching_process_payload_queue
                where batch_id ='${batch_id}' and group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and '${origin_type}'='TRANSACTION' and '${outbound.asis.builder.activator}'='true';


                 INSERT INTO ingestion.pipeline_queue_status_audit
                (producer_process_id, consumer_process_id, origin_id,batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, origin_type)
                select producer_process_id, consumer_process_id, origin_id, batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, '${origin_type}'
                from text_extraction.text_extraction_payload_queue
                where group_id='${gen_group_id.group_id}' and batch_id='${batch_id}' and tenant_id =${tenant_id};

                INSERT INTO ingestion.pipeline_queue_status_audit
                (producer_process_id, consumer_process_id, origin_id,batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, origin_type)
                select producer_process_id, consumer_process_id, origin_id, batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, '${origin_type}'
                from kvp_extraction.kvp_extraction_payload_queue
                where group_id='${gen_group_id.group_id}' and batch_id='${batch_id}' and tenant_id =${tenant_id};

                INSERT INTO ingestion.pipeline_queue_status_audit
                (producer_process_id, consumer_process_id, origin_id,batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, origin_type)
                select producer_process_id, consumer_process_id, origin_id, batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, '${origin_type}'
                from checkbox_extraction.checkbox_extraction_payload_queue
                where group_id='${gen_group_id.group_id}' and batch_id='${batch_id}' and tenant_id =${tenant_id};

                INSERT INTO ingestion.pipeline_queue_status_audit
                (producer_process_id, consumer_process_id, origin_id,batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, origin_type)
                select producer_process_id, consumer_process_id, origin_id, batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, '${origin_type}'
                from table_extraction_info.table_extraction_payload_queue
                where group_id='${gen_group_id.group_id}' and batch_id='${batch_id}' and tenant_id =${tenant_id};

                INSERT INTO ingestion.pipeline_queue_status_audit
                (producer_process_id, consumer_process_id, origin_id,batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, origin_type)
                select producer_process_id, consumer_process_id, origin_id, batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, '${origin_type}'
                from outbound_transform_asis.outbound_transform_asis_payload_queue
                where group_id='${gen_group_id.group_id}' and batch_id='${batch_id}' and tenant_id =${tenant_id};

                INSERT INTO ingestion.pipeline_queue_status_audit
                (producer_process_id, consumer_process_id, origin_id,batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, origin_type)
                select producer_process_id, consumer_process_id, origin_id, batch_id, group_id, created_on, status, stage, consumed_on_ts, root_pipeline_id, tenant_id, '${origin_type}'
                from outbound_asis.outbound_asis_payload_queue
                where group_id='${gen_group_id.group_id}' and batch_id='${batch_id}' and tenant_id =${tenant_id};

        "} on-condition if "false"=="true"


        assign as "pipeline_bus_mode" source "intics_zio_db_conn" using
        {"
                select  (case when '${noise.model.start.action}'='true' AND '${noise.model.caller.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as noise_model;
                select  (case when '${zero.shot.start.action}'='true' AND '${root.filter.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as zero_shot;
                select  (case when '${phrase.match.start.action}'='true' AND '${root.filter.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as phrase_match;

                select  (case when '${paper.classification.start.action}'='true' AND '${paper.classification.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as paper_classificationr;
                select  (case when '${qr.extraction.start.action}'='true' AND '${qr.extraction.processor.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as qr_extraction;
                select  (case when '${ut.model.start.action}'='true' AND '${ut.model.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as ut_model;


                select  (case when '${handwritten.start.action}'='true' AND '${sor.transaction.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as vqa_handwritten;
                select  (case when '${printed.start.action}'='true' AND '${sor.transaction.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as vqa_printed;
                select  (case when '${validation.start.action}'='true' AND '${sor.transaction.activator}'='true'  AND '${pipeline.bus.mode}'='true' then 'true' else 'false' end) as validation;

                select  (case when '${merger.start.action}'='true' AND '${response.builder.activator}'='true'  then 'true' else 'false' end) as merger_start;
                select  (case when '${merger.stop.action}'='true' AND '${response.builder.activator}'='true' then 'true' else 'false' end) as merger_stop;

        "}on-condition if "true"=="true"



        coproStart as "Calling zero shot classifier copro start action" for "ZERO_SHOT_CLASSIFIER"
        copro-server-url "${copro.zero.shot.admin.start.url}"
        export-command "${copro.zero.shot.admin.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
             ${zeroShotStartCommand}

        "} on-condition if "${pipeline_bus_mode.zero_shot}"=="true"

        coproStart as "Calling phrase match copro start action" for "PHRASE_MATCH"
        copro-server-url "${copro.phrase.match.admin.start.url}"
        export-command "${copro.phrase.match.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
                ${phraseMatchStartCommand}

        "} on-condition if "${pipeline_bus_mode.phrase_match}"=="true"

        callprocess as "Insert into synonym and question tables"
        with-target "template.questions.onboarding"
        from-file "${basepath}/preprocess/template.questions.onboarding.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "true"=="true"

        spawn as "DocEyeCue spawn caller spawn process enabled"
        with-target "spawn.doceyecue.process"
        from-file "${basepath}/batchProcess/spawn.doceyecue.process.lmd"
        on-condition if "${doc.eyecue.spawn.activator}"=="true"

        callprocess as "DocEyeCue spawn caller spawn process disabled"
        with-target "spawn.doceyecue.process"
        from-file "${basepath}/batchProcess/spawn.doceyecue.process.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${doc.eyecue.spawn.activator}"=="false"

        callprocess as "calling optimized preprocess main caller"
        with-target "preprocess.main.caller"
        from-file "${basepath}/preprocess/preprocess.main.caller.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT 1;
        "} on-condition if "${preprocess.main.caller.activator}"=="true"


                        callprocess as "calling text extraction main caller"
                        with-target "text.extraction.main.caller"
                        from-file "${basepath}/extraction/text/text.extraction.main.caller.lmd"
                        using "intics_zio_db_conn"
                        for-every {"
                                SELECT 1;
                        "} on-condition if "${text.extraction.asis.activator}"=="true"

                        callprocess as "calling KVP extraction main caller"
                        with-target "kvp.extraction.main.caller"
                        from-file "${basepath}/extraction/kvp/kvp.extraction.main.caller.lmd"
                        using "intics_zio_db_conn"
                        for-every {"
                                SELECT 1;
                        "} on-condition if "${kvp.extraction.asis.activator}"=="true"

                        callprocess as "calling table extraction main caller"
                        with-target "table.extraction.main.caller"
                        from-file "${basepath}/extraction/table/table.extraction.main.caller.lmd"
                        using "intics_zio_db_conn"
                        for-every {"
                                SELECT 1;
                        "} on-condition if "${table.extraction.asis.krypton.activator}"=="true"

                        callprocess as "calling checkbox extraction main caller"
                        with-target "checkbox.extraction.main.caller"
                        from-file "${basepath}/extraction/checkbox/checkbox.extraction.main.caller.lmd"
                        using "intics_zio_db_conn"
                        for-every {"
                                SELECT 1;
                        "} on-condition if "${checkbox.extraction.asis.activator}"=="true"



                        callprocess as "calling outbound response insert caller"
                        with-target "outbound.response.insert"
                        from-file "${basepath}/extraction/outbound/outbound.response.insert.lmd"
                        using "intics_zio_db_conn"
                        for-every {"
                                SELECT 1;
                        "} on-condition if "${outbound.asis.transform.activator}"=="true"


                        callprocess as "calling outbound.transform.main "
                        with-target "outbound.transform.main.lmd"
                        from-file "${basepath}/extraction/outboundTransform/outbound.transform.main.lmd"
                        using "intics_zio_db_conn"
                        for-every {"
                                SELECT 1;
                        "} on-condition if "${outbound.asis.transform.activator}"=="true"

                        callprocess as "calling outbound.builder.main "
                        with-target "outbound.builder.main.lmd"
                        from-file "${basepath}/extraction/outboundAsis/outbound.builder.main.lmd"
                        using "intics_zio_db_conn"
                        for-every {"
                                SELECT 1;
                        "} on-condition if "${outbound.asis.builder.activator}"=="true"


        coproStart as "Calling noise Model copro start action" for "NOISE_MODEL"
        copro-server-url "${copro.noise.model.admin.start.url}"
        export-command "${copro.noisemodel.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
                ${noiseModelStartCommand}

        "}on-condition if "${pipeline_bus_mode.noise_model}" == "true"


        coproStart as "Calling paper classification copro start action" for "PAPER_CLASSIFICATION"
        copro-server-url "${copro.paper.classification.admin.start.url}"
        export-command "${copro.paper.classification.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
                ${paperClassificationStartCommand}

        "}on-condition if "${pipeline_bus_mode.paper_classificationr}"=="true"

        coproStart as "Calling QR extraction copro start action" for "QR_EXTRACTION"
        copro-server-url "${copro.qr.extraction.admin.start.url}"
        export-command "${copro.qr.extraction.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
                ${qrExtractionStartCommand}

        "}on-condition if "${pipeline_bus_mode.qr_extraction}"=="true"


        coproStart as "Calling Urgency triage Model copro start action" for "UT_MODEL"
        copro-server-url "${copro.ut.model.admin.start.url}"
        export-command "${copro.utmodel.export}"
        process-id "${init_process_id.process_id}"  resource-conn "intics_zio_db_conn"
        using
        {"
                ${utModelStartCommand}

