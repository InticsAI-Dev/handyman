        "} on-condition if "${coveragereport.processor.activator}"=="none"

        callprocess as "calling custom product outbound main"
        with-target "product.outbound.main"
        from-file "${basepath}/productOutbound/product.outbound.main.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT DISTINCT group_id
                from  product_outbound.product_outbound_payload_queue
                where status='STAGED' AND tenant_id = ${tenant_id} and  group_id = '${gen_group_id.group_id}';
        "} on-condition if "${product.response.builder.activator}"=="true"


        transform as "Batch process update to completed " on "intics_zio_db_conn" using
        {"
        UPDATE batching.sub_batching_process_payload_queue a
        SET status='FAILED'
        WHERE a.status='FAILED' and a.group_id='${group_id}' and a.batch_id='${batch_id}'
         and a.batch_id ='${batch_id}' and a.tenant_id = ${tenant_id};

        "} on-condition if "true"=="true"

}
catch{

        transform as "Batch process update to failed " on "intics_zio_db_conn" using
         {"
                UPDATE batching.sub_batching_process_payload_queue
                SET status='FAILED'
                WHERE status='IN_PROGRESS' and group_id='${gen_group_id.group_id}' and batch_id ='${batch_id}' and tenant_id = ${tenant_id};
        "} on-condition if "true"=="true"

        }
        finally{

        transform as "move to archive after completed" on "intics_zio_db_conn" using
        {"

                INSERT INTO ${temp_schema_name}.summary_audit_files_${init_process_id.process_id}
                (process_id ,module_name,macro_process,completed_count,failed_count,min_created_on,max_created_on,time_taken, tenant_id, batch_id)
                SELECT ${init_process_id.process_id} , 'OUTBOUND' ,'OUTBOUND',coalesce (sum(CASE WHEN status='COMPLETED' THEN 1 ELSE 0 END),0) ,coalesce (sum(CASE WHEN status='FAILED' THEN 1 ELSE 0 END),0),min(consumed_on_ts) as min_created_on,now() as max_created_on , EXTRACT(epoch FROM (now()-min(consumed_on_ts))), '${tenant_id}','${batch_id}'
                FROM outbound.outbound_payload_queue
                WHERE group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';

                INSERT INTO audit.pipeline_summary_audit
                (process_id, created_on, module_name, macro_process, files_processed_count,files_failed_count,start_time,end_time, time_taken, group_id, root_pipeline_id, created_user_id, template_id, tenant_id,average_time, batch_id)
                SELECT msaf.process_id ,now(),msaf.module_name ,msaf.macro_process ,msaf.completed_count,msaf.failed_count,msaf.min_created_on,msaf.max_created_on, EXTRACT(epoch FROM (msaf.max_created_on-msaf.min_created_on)),
                '${gen_group_id.group_id}','${root-ref-id}','${created_user_id}','${document_id}','${tenant_id}',
                (CASE WHEN (msaf.completed_count+msaf.failed_count)=0 THEN msaf.time_taken WHEN (msaf.time_taken/(msaf.completed_count+msaf.failed_count))=0 THEN msaf.time_taken ELSE (msaf.time_taken/(msaf.completed_count+msaf.failed_count)) END), msaf.batch_id
                FROM ${temp_schema_name}.summary_audit_files_${init_process_id.process_id} msaf
                WHERE msaf.module_name='OUTBOUND' AND msaf.macro_process='OUTBOUND' and msaf.tenant_id = ${tenant_id} and batch_id ='${batch_id}';

                update ingestion.pipeline_queue_status_audit as a
                set status = 'FAILED' , consumed_on_ts=now(), consumer_process_id = '${process-id}'
                where  a.group_id=${group_id}
                and a.batch_id='${batch_id}' and a.tenant_id =${tenant_id} and a.stage <> 'PRODUCT_OUTBOUND' and a.status='IN_PROGRESS' ;

                update ingestion.pipeline_queue_status_audit as a
                set status = 'COMPLETED' , consumed_on_ts=now(), consumer_process_id = '${process-id}'
                where  a.group_id=${group_id}
                and a.batch_id='${batch_id}' and a.tenant_id =${tenant_id} and a.stage ='PRODUCT_OUTBOUND' and a.status='IN_PROGRESS' ;

                INSERT INTO outbound.outbound_payload_queue_archive
                (producer_process_id, consumer_process_id, origin_id,group_id, created_on, status, stage, consumed_on_ts,root_pipeline_id, tenant_id, batch_id)
                SELECT producer_process_id, consumer_process_id, origin_id, group_id, created_on, status, stage,consumed_on_ts,root_pipeline_id, ${tenant_id}, batch_id
                FROM outbound.outbound_payload_queue
                where status='COMPLETED' and stage='OUTBOUND' and group_id = '${gen_group_id.group_id}' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';

                Delete from outbound.outbound_payload_queue
                where status='COMPLETED' and stage='OUTBOUND' and group_id = '${gen_group_id.group_id}' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';
        "} on-condition if "${response.builder.activator}"=="true"

         transform as "Move to archive after failed" on "intics_zio_db_conn" using {"
                INSERT INTO outbound.outbound_payload_error_queue
                (producer_process_id, consumer_process_id, origin_id,group_id, created_on, status, stage, message, consumed_on_ts,root_pipeline_id, tenant_id, batch_id)
                SELECT producer_process_id, consumer_process_id,origin_id, group_id, created_on, status, stage, 'outbound Processor failed for group_id ${group_id} and origin_id ${origin_id}',
                consumed_on_ts,root_pipeline_id, ${tenant_id},batch_id
                FROM outbound.outbound_payload_queue where status='FAILED' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';

                Delete from outbound.outbound_payload_queue
                where status='FAILED' and stage='OUTBOUND' and group_id = '${gen_group_id.group_id}' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';

         "} on-condition if "${response.builder.activator}"=="true"

        transform as "move to preprocess archive after completed from batching payload" on "intics_zio_db_conn" using
        {"
        INSERT INTO batching.batching_process_payload_queue_archive
        (producer_process_id, consumer_process_id, group_id,batch_id , origin_id, created_on, status, stage, consumed_on_ts,root_pipeline_id, tenant_id)
        SELECT producer_process_id, consumer_process_id, '${group_id}', batch_id ,origin_id, now(), status, stage, consumed_on_ts,root_pipeline_id, ${tenant_id}
        FROM batching.sub_batching_process_payload_queue
        where status='COMPLETED' and group_id='${gen_group_id.group_id}' and  batch_id ='${batch_id}' and tenant_id = ${tenant_id};


        INSERT INTO batching.batching_process_payload_error_queue
        (producer_process_id, consumer_process_id,group_id, batch_id,origin_id, created_on, status, stage, message, consumed_on_ts,root_pipeline_id, tenant_id)
        SELECT  producer_process_id, consumer_process_id,'${group_id}', batch_id, origin_id, now(),status,stage,'error in batch processing for batch_id ${batch_id}',consumed_on_ts,root_pipeline_id, ${tenant_id}
        FROM batching.sub_batching_process_payload_queue
        where status = 'FAILED' and group_id='${gen_group_id.group_id}' and batch_id ='${batch_id}' and tenant_id = ${tenant_id};

        DELETE FROM batching.sub_batching_process_payload_queue
        WHERE status='FAILED' and group_id='${gen_group_id.group_id}' and batch_id ='${batch_id}' and tenant_id = ${tenant_id};

        INSERT INTO batching.batching_process_payload_error_queue
        (producer_process_id, consumer_process_id,group_id, batch_id,origin_id, created_on, status, stage, message, consumed_on_ts,root_pipeline_id, tenant_id)
        SELECT  producer_process_id, consumer_process_id,'${group_id}', batch_id, origin_id, now(),status,stage,'deep_sift stage aborted batch_id=${batch_id} | root_pipeline_id=${root_pipeline_id} | group_id=${group_id} | transaction_id=${transaction_id} | reason=execution time exceeded the threshold limit',consumed_on_ts,root_pipeline_id, ${tenant_id}
        FROM batching.sub_batching_process_payload_queue
        where status = 'ABORTED' and group_id='${gen_group_id.group_id}' and batch_id ='${batch_id}' and tenant_id = ${tenant_id};

        DELETE FROM batching.sub_batching_process_payload_queue
        WHERE status='ABORTED' and group_id='${gen_group_id.group_id}' and batch_id ='${batch_id}' and tenant_id = ${tenant_id};

        DELETE FROM batching.batching_process_payload_queue
        WHERE group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and batch_id ='${batch_id}';
        "} on-condition if "true"=="true"

        transform as "delete from sub batching after completed from batching payload" on "intics_zio_db_conn" using
        {"

        DELETE FROM batching.sub_batching_process_payload_queue
        WHERE status='COMPLETED' and group_id='${gen_group_id.group_id}' and batch_id ='${batch_id}' and tenant_id = ${tenant_id};

        DELETE FROM batching.sub_batching_process_payload_queue
        WHERE status='FAILED' and group_id='${gen_group_id.group_id}' and batch_id ='${batch_id}' and tenant_id = ${tenant_id};
        DELETE FROM batching.batching_process_payload_queue
        WHERE group_id='${gen_group_id.group_id}' and tenant_id = ${tenant_id} and batch_id ='${batch_id}' ;

        "} on-condition if "true"=="none"


        transform as "Drop table extraction temporary tables" on "intics_zio_db_conn" using
        {"

                DROP TABLE IF EXISTS  ${temp_schema_name}.table_extraction_temp_table_${process-id};
                DROP TABLE IF EXISTS ${temp_schema_name}.table_extraction_line_items_${process-id};
        "} on-condition if "${table.extraction.activator}"=="true"


        transform as "Drop table extraction temporary tables" on "intics_zio_db_conn" using
        {"

                DROP TABLE IF EXISTS  ${temp_schema_name}.currency_detection_payload_input_table_${init_process_id.process_id};
        "} on-condition if "${currency.detection.processor.activator}"=="true"

        transform as "move to archive after completed" on "intics_zio_db_conn" using
        {"
                INSERT INTO outbound.outbound_payload_queue_archive
                (producer_process_id, consumer_process_id, origin_id,group_id, created_on, status, stage, consumed_on_ts,root_pipeline_id, tenant_id)
                SELECT producer_process_id, consumer_process_id, origin_id, group_id, created_on, status, stage,consumed_on_ts,root_pipeline_id, '${tenant_id}'
                FROM outbound.outbound_payload_queue
                where status='COMPLETED' and stage='OUTBOUND' and group_id = '${gen_group_id.group_id}' and tenant_id = '${tenant_id}' and batch_id='${batch_id}';

                Delete from outbound.outbound_payload_queue
                where status='COMPLETED' and stage='OUTBOUND' and group_id = '${gen_group_id.group_id}' and tenant_id = '${tenant_id}' and batch_id='${batch_id}';
                "} on-condition if "${response.builder.activator}"=="true"

                transform as "move to archive after failed" on "intics_zio_db_conn" using {"
                INSERT INTO outbound.outbound_payload_error_queue
                (producer_process_id, consumer_process_id, origin_id,group_id, created_on, status, stage, message, consumed_on_ts,root_pipeline_id, tenant_id)
                SELECT producer_process_id, consumer_process_id,origin_id, group_id, created_on, status, stage, 'outbound Processor failed for group_id ${group_id} and origin_id ${origin_id}',
                consumed_on_ts,root_pipeline_id, ${tenant_id}
                FROM outbound.outbound_payload_queue where status='FAILED' and tenant_id = ${tenant_id} and batch_id='${batch_id}';

                Delete from outbound.outbound_payload_queue
                where status='FAILED' and stage='OUTBOUND' and group_id = '${gen_group_id.group_id}' and tenant_id = ${tenant_id} and batch_id='${batch_id}';
        "} on-condition if "${response.builder.activator}"=="true"
}

}