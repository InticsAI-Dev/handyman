           transform as "Insert into pipeline directory info" on "intics_zio_db_conn" using
           {"
           INSERT INTO ingestion.pipeline_directory_info
           (target_directory_path, tenant_id, group_id, root_pipeline_id, created_on, updated_on, created_user_id, last_updated_user_id,
            transaction_id, formatted_date, current_directory, zip_directory, process_name, status)
           select '${target_directory_path}',${tenant_id},${gen_group_id.group_id},${root-ref-id},now(),now(),'${created_user_id}','${last_updated_user_id}',
           '${transaction_id}','${gen_id.formatted_date}','${gen_directory.zip_directory}','${gen_directory.zip_directory}','RESPONSE_ARTIFACT','STAGED';

           "} on-condition if "true"=="true"

        coproStop as "Calling merger copro stop action" for "MERGER"
        copro-server-url "${copro.merger.admin.stop.url}"
