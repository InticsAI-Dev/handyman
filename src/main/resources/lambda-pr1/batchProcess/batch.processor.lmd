        with-target "alchemy.migration.main"
        from-file "${basepath}/alchemy_migration/alchemy.migration.main.lmd"
        using "intics_zio_db_conn"
        for-every {"
                SELECT distinct group_id,batch_id
                from  alchemy_migration.alchemy_migration_payload_queue
                where status='STAGED' AND tenant_id = ${tenant_id} and  group_id =${gen_group_id.group_id};
        "} on-condition if "${alchemy.migration.activator}"=="true"


        callprocess as "calling coverage report main caller"
        with-target "coverage.processor"
        from-file "${basepath}/coverageReport/coverage.processor.lmd"
        using "intics_zio_db_conn"
        for-every {"
