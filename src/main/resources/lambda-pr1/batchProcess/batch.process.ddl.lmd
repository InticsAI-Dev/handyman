                );
                CREATE INDEX if not exists idx_popq_status_group_origin ON alchemy_migration.alchemy_migration_payload_queue (group_id,status, tenant_id, batch_id);



                CREATE SCHEMA IF NOT EXISTS control_data;
                CREATE TABLE IF NOT EXISTS control_data.control_data_payload_queue (
