process "batch.process.ddl"
{
try {

        transform as "Batch processing ddl " on "intics_zio_db_conn" using {"

                CREATE TABLE IF NOT EXISTS  batching.batching_process_payload_error_queue (
                producer_process_id int8 NOT NULL,
                consumer_process_id int8 NULL,
                batch_id varchar not null,
                group_id int4 NOT NULL,
                origin_id varchar NOT NULL,
                created_on timestamp NOT NULL,
                status varchar NOT NULL,
                stage varchar NOT NULL,
                message varchar NULL,
                consumed_on_ts timestamp NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL,
                CONSTRAINT batching_process_payload_error_queue_pk PRIMARY KEY (origin_id,tenant_id)
                );

                CREATE TABLE IF NOT EXISTS  batching.batching_process_payload_queue_archive (
                producer_process_id int8 NOT NULL,
                consumer_process_id int8 NULL,
                batch_id varchar not null,
                group_id int4 NOT NULL,
                origin_id varchar NOT NULL,
                created_on timestamp NOT NULL,
