                endpoint varchar null,
                CONSTRAINT qr_extraction_result_pk PRIMARY KEY (id)
                );

                CREATE TABLE IF NOT EXISTS sor_grouping.sor_grouping_payload_queue_archive (
                producer_process_id int8 NOT NULL,
