                score_id bigserial NOT NULL,
                origin_id varchar NULL,
                batch_id varchar not null,
                paper_no int4 NULL,
                sor_item_name varchar NULL,
                weight_score float8 NULL,
                predicted_value text NULL,
                b_box varchar NULL,
                confidence_score int8 NULL,
                root_pipeline_id int8 NULL,
                frequency int8 NULL,
                cummulative_score int8 NULL,
                filter_score int8 null,
                question_id int8 null,
                synonym_id int8 null,
                tenant_id int8 NULL,
                model_registry varchar NULL
                );

                CREATE TABLE IF NOT EXISTS  voting.cummulative_max_filter_score_audit (
                score_id int8 NULL,
                origin_id varchar NULL,
                batch_id varchar not null,
                paper_no int4 NULL,
                sor_item_name varchar NULL,
                cummulative_score int8 NULL,
                max_filter_score int8 NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL
                );

                CREATE TABLE IF NOT EXISTS voting.score_count_audit (
                origin_id varchar NULL,
                sor_item_name varchar NULL,
                batch_id varchar not null,
                max_cummulative_score int8 NULL,
                score_count int8 NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL
                );

                CREATE TABLE IF NOT EXISTS control_data.control_data_payload_queue (
                producer_process_id int8 NOT NULL,
                consumer_process_id int8 NULL,
                batch_id varchar not null,
                origin_id varchar NOT NULL,
                group_id int4 NULL,
                created_on timestamp NULL,
                consumed_on_ts timestamp NULL,
                status varchar NULL,
                stage varchar NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL,
                CONSTRAINT control_data_payload_queue_pk PRIMARY KEY (producer_process_id, origin_id)
                );

                CREATE TABLE IF NOT EXISTS ${temp_schema_name}.grouping_chrono_clash_input_${init_process_id.process_id} (
                    root_pipeline_id int8 NOT NULL,
                    created_on timestamp NULL,
                    updated_on timestamp NULL,
                    batch_id varchar NOT NULL,
                    group_id int4 NULL,
                    origin_id varchar NOT NULL,
                    tenant_id int8 NOT NULL,
                    time_frame int4 NULL,
                    stage varchar NULL,
                    status varchar NULL,
                    transaction_id varchar NOT NULL,
                    downloaded_time timestamp NULL,
                    remaining_time interval NULL,
                    CONSTRAINT grouping_chrono_clash_input_${init_process_id.process_id}_pk PRIMARY KEY (origin_id,tenant_id,root_pipeline_id,transaction_id)
                );

        "} on-condition if "true"=="true"

            transform as "sor grouping ddl completed" on "intics_zio_db_conn" using {"
                INSERT INTO sor_grouping.sor_grouping_pipeline_audit
                ( created_on, user_id, group_id, tenant_id, status, stage, message, root_pipeline_id)
                VALUES( now(), '${created_user_id}', '${gen_group_id.group_id}', '${tenant_id}', 'COMPLETED',
                'SOR_GROUPING', 'Completed creating ddl for sor grouping', '${gen_id.root_pipeline_id}');
            "} on-condition if "true"=="true"

	}
	catch{
            transform as "sor grouping ddl failed" on "intics_zio_db_conn" using {"
                INSERT INTO sor_grouping.sor_grouping_pipeline_audit
                ( created_on, user_id, group_id, tenant_id, status, stage, message, root_pipeline_id)
                VALUES( now(), '${created_user_id}', '${gen_group_id.group_id}', '${tenant_id}', 'FAILED',
                'SOR_GROUPING', 'Failed in creating ddl for sor grouping', '${gen_id.root_pipeline_id}');
            "} on-condition if "true"=="true"
	}
	finally{

	}
}