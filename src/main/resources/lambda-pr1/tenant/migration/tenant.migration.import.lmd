process "tenant.migration.import"
{

try{

            transform as "create consolidated table for the question " on "intics_zio_db_conn" using {"

                    create table macro.import_csv_data_qn_${process-id} as
                    select d.document_type ,ai.template_name ,sc.sor_container_name,te.truth_entity_name,te.sip_type ,si.sor_item_name ,st.synonym ,sq.question
                    from sor_meta.document d
                    join sor_meta.asset_info ai on d.document_type =ai.document_type and d.tenant_id =ai.tenant_id
                    join sor_meta.sor_container sc on sc.document_type =d.document_type and sc.tenant_id =d.tenant_id
                    JOIN sor_meta.truth_entity te on te.sor_container_id =sc.sor_container_id
                    join sor_meta.sor_tsynonym st on st.truth_entity_id =te.truth_entity_id
                    join sor_meta.sor_item si on st.sor_item_id =si.sor_item_id
                    join sor_meta.sor_question sq on sq.synonym_id =st.synonym_id;

            "} on-condition if "true"=="false"


            transform as "insert into document in sor_meta" on "intics_zio_db_conn" using {"

                    delete from ${import_table_name} where document_type='';

            "} on-condition if "true"=="true"

            transform as "insert into document in sor_meta" on "intics_zio_db_conn" using {"


                    INSERT INTO sor_meta.document
                    (document_type, document_name, tenant_id, created_on, created_user_id, last_updated_on, last_updated_user_id, status, version)
                    select a.document_type ,a.document_type,     ${tenant_id},now(),${tenant_id},now(),${tenant_id},'ACTIVE',1
                    from ${import_table_name} a
                    group by a.document_type ;

            "} on-condition if "${meta_mapping}"=="QUESTION"

            transform as "insert into asset_info in sor_meta" on "intics_zio_db_conn" using {"

                    INSERT INTO sor_meta.asset_info
                    (template_name, document_type, model_registry_id, tenant_id,created_on, created_user_id, last_updated_on, last_updated_user_id, status, version)
                    select a.template_name ,a.document_type ,0,${tenant_id},now(),${tenant_id},now(),${tenant_id},'ACTIVE',1
                    from ${import_table_name} a
                    group by a.document_type ,a.template_name ;

            "} on-condition if "${meta_mapping}"=="QUESTION"

            transform as "insert into sor_container in sor_meta" on "intics_zio_db_conn" using {"

                    INSERT INTO sor_meta.sor_container
                    ( sor_container_name, voting_out,document_type, tenant_id,created_on, created_user_id, last_updated_on, last_updated_user_id, status, version)
                    select a.sor_container_name ,0,a.document_type , ${tenant_id},now(),${tenant_id},now(),${tenant_id},'ACTIVE',1
                    from ${import_table_name} a
                    join sor_meta.document d on d.document_type =a.document_type and d.tenant_id =${tenant_id}
                    group by a.sor_container_name ,a.document_type ;

            "} on-condition if "${meta_mapping}"=="QUESTION"

            transform as "insert into sor_item in sor_meta" on "intics_zio_db_conn" using {"

                    INSERT INTO sor_meta.sor_item
                    ( sor_item_name, sor_container_id, table_aggregate_function, tenant_id,created_on, created_user_id, last_updated_on, last_updated_user_id, status, version)
                    select a.sor_item_name ,b.sor_container_id ,'SUM',  ${tenant_id},now(),${tenant_id},now(),${tenant_id},'ACTIVE',1
                    from ${import_table_name} a
                    join sor_meta.asset_info d on d.document_type =a.document_type and d.tenant_id =${tenant_id}
                    join sor_meta.sor_container b on a.sor_container_name =b.sor_container_name and a.document_type =b.document_type and b.tenant_id =${tenant_id};

            "} on-condition if "${meta_mapping}"=="QUESTION"

            transform as "insert into truth_entity in sor_meta" on "intics_zio_db_conn" using {"


                    INSERT INTO sor_meta.truth_entity
                    ( truth_entity_name, asset_id, sor_container_id, sip_type ,   tenant_id,created_on, created_user_id, last_updated_on, last_updated_user_id, status, version)
                    select a.truth_entity_name ,d.asset_id ,b.sor_container_id ,a.sip_type,    ${tenant_id},now(),${tenant_id},now(),${tenant_id},'ACTIVE',1
                    from ${import_table_name} a
                    join sor_meta.asset_info d on d.document_type =a.document_type and d.tenant_id =${tenant_id}
                    join sor_meta.sor_container b on a.sor_container_name =b.sor_container_name and a.document_type =b.document_type and b.tenant_id =${tenant_id}
                    group by a.truth_entity_name ,d.asset_id ,b.sor_container_id ,a.sip_type;

            "} on-condition if "${meta_mapping}"=="QUESTION"

            transform as "insert into truth_entity_placeholder in sor_meta" on "intics_zio_db_conn" using {"

                    INSERT INTO sor_meta.truth_entity_placeholder
                    (truth_entity_placeholder_value, truth_entity_id, sor_container_id, created_on, created_user_id, last_updated_on, last_updated_user_id, tenant_id,status, version)
                    select a.truth_entity_placeholder_value
                    ,te.truth_entity_id,b.sor_container_id ,now(),${tenant_id},now(),${tenant_id},${tenant_id},'ACTIVE',1
                    from ${import_table_name} a
                    join sor_meta.asset_info d on d.document_type =a.document_type and d.tenant_id =${tenant_id}
                    join sor_meta.sor_container b on a.sor_container_name =b.sor_container_name and a.document_type =b.document_type and b.tenant_id =${tenant_id}
                    left join sor_meta.truth_entity te on  te.sor_container_id =b.sor_container_id and d.asset_id =te.asset_id and a.truth_entity_name =te.truth_entity_name
                    group by a.truth_entity_placeholder_value,b.sor_container_id,te.truth_entity_id ;

            "} on-condition if "${meta_mapping}"=="PLACEHOLDER"


            transform as "insert into sor_tsynonym in sor_meta" on "intics_zio_db_conn" using {"

                    INSERT INTO sor_meta.sor_tsynonym
                    ( synonym, sor_item_id, truth_entity_id, sor_container_id, weights, feature, priority_idx, category, tenant_id,created_on, created_user_id, last_updated_on, last_updated_user_id, status, version)
                    select a.synonym
                    ,si.sor_item_id ,te.truth_entity_id,b.sor_container_id ,150 ,'KIE',1,'',${tenant_id},now(),${tenant_id},now(),${tenant_id},'ACTIVE',1
                    from ${import_table_name} a
                    join sor_meta.asset_info d on d.document_type =a.document_type and d.tenant_id =${tenant_id}
                    join sor_meta.sor_container b on a.sor_container_name =b.sor_container_name and a.document_type =b.document_type and b.tenant_id =${tenant_id}
                    join sor_meta.sor_item si on si.sor_item_name = a.sor_item_name and si.tenant_id =${tenant_id} and b.sor_container_id = si.sor_container_id
                    left join sor_meta.truth_entity te on  te.sor_container_id =b.sor_container_id and d.asset_id =te.asset_id and a.truth_entity_name =te.truth_entity_name
                    group by a.synonym ,si.sor_item_id ,b.sor_container_id,te.truth_entity_id ;

            "} on-condition if "${meta_mapping}"=="QUESTION"

            transform as "insert into sor_question in sor_meta" on "intics_zio_db_conn" using {"


                    INSERT INTO sor_meta.sor_question
                    ( synonym_id, question, weights, category,  priority_idx, model_registry_id, added_by, tenant_id,created_on, created_user_id, last_updated_on, last_updated_user_id, status, version)
                    select b.synonym_id ,a.question ,150,'PRIMARY',1,1,'',${tenant_id},now(),${tenant_id},now(),${tenant_id},'ACTIVE',1
                    from ${import_table_name} a
                    join sor_meta.sor_tsynonym b on b.synonym =a.synonym and b.tenant_id =${tenant_id};


            "} on-condition if "${meta_mapping}"=="QUESTION"


}
catch{}
finally{

            transform as "insert into audit table for question audit" on "intics_zio_db_conn" using {"

                INSERT INTO meta_bootstraping.imported_csv_data_question_audit
                (document_type, template_name, sor_container_name, truth_entity_name, sip_type, sor_item_name, synonym, question,tenant_id,root_pipeline_id)
                SELECT document_type, template_name, sor_container_name, truth_entity_name, sip_type, sor_item_name, synonym, question,${tenant_id},${process-id}
                FROM ${import_table_name};

                drop table ${import_table_name};
            "} on-condition if "${meta_mapping}"=="QUESTION"

            transform as "insert into audit table for placeholder" on "intics_zio_db_conn" using {"

                INSERT INTO meta_bootstraping.imported_csv_data_placeholder_audit
                (document_type, template_name, sor_container_name, truth_entity_name, truth_entity_placeholder_value,tenant_id,root_pipeline_id)
                SELECT document_type, template_name, sor_container_name, truth_entity_name, truth_entity_placeholder_value,${tenant_id},${process-id}
                FROM ${import_table_name};

                DROP TABLE ${import_table_name};

            "} on-condition if "${meta_mapping}"=="PLACEHOLDER"



}
}