process "currency.detection.ddl"
{
try{

transform as "create audit table for currency detection model" on "intics_zio_db_conn" using {"

		     CREATE TABLE IF NOT EXISTS currency_detection.currency_detection_pipeline_audit (
                               id bigserial NOT NULL,
            		           process_id bigint NULL,
            		           origin_id varchar NULL,
            		           group_id varchar NULL,
            		           created_on varchar NULL,
            		           status varchar NULL,
            		           stage varchar NULL,
            		           message varchar NULL,
            		           root_pipeline_id int8 NULL,
            		           tenant_id int8 NULL,
            		           batch_id varchar NULL
                            );

		 "} on-condition if "true"=="true"


         transform as "create ddl for currency detection output table" on "intics_zio_db_conn" using
        {"

             CREATE TABLE IF NOT EXISTS currency_detection.currency_detection_result (
                             	id bigserial NOT NULL,
                             	process_id int8 null,
                             	tenant_id int8 NULL,
                             	template_id varchar null,
                             	group_id int4  NULL,
                             	paper_no int4  NULL,
                             	origin_id varchar  NULL,
                             	input_file_path varchar NULL,
                             	detected_value varchar null,
                                detected_ascii_value varchar null,
                             	confidence_score numeric(10, 2) NULL,
                             	status varchar NULL,
                             	stage varchar NULL,
                             	message varchar NULL,
                             	created_on timestamp NULL,
                             	root_pipeline_id int8 NULL,
                             	model_name varchar NULL,
                                 model_version varchar NULL,
                                 batch_id varchar NULL,
                                request text NULL,
                                response text NULL,
                                endpoint varchar NULL
                             );

        "} on-condition if "true"=="true"


        transform as "Create currency detection payload table" on "intics_zio_db_conn" using
        {"
                CREATE TABLE IF NOT EXISTS currency_detection.currency_detection_payload_queue_archive (
                    producer_process_id int8 NOT NULL,
                    consumer_process_id int8 NULL,
                    origin_id varchar NOT NULL,
                    group_id int4 NULL,
                    created_on timestamp NULL,
                    last_updated_on timestamp NULL,
                    consumed_on_ts varchar NULL,
                    status varchar NULL,
                    stage varchar NULL,
                    root_pipeline_id int8 NULL,
                    tenant_id int8 NULL,
                     batch_id varchar NULL,
                    CONSTRAINT currency_detection_payload_queue_archive_pk PRIMARY KEY (producer_process_id, origin_id,tenant_id)
                );

                CREATE TABLE IF NOT EXISTS currency_detection.currency_detection_payload_error_queue (
                     producer_process_id int8 NOT NULL,
                     consumer_process_id int8 NULL,
                     origin_id varchar NOT NULL,
                     created_on timestamp NOT NULL,
                     last_updated_on timestamp NULL,
                     group_id int4 not null,
                     status varchar NOT NULL,
                     stage  varchar NOT NULL,
                     message varchar NULL,
                     consumed_on_ts timestamp NULL,
                     root_pipeline_id int8 NULL,
                     tenant_id int8 NULL,
                      batch_id varchar NULL,
                     CONSTRAINT currency_detection_payload_error_queue_pk PRIMARY KEY (producer_process_id, origin_id,tenant_id)
                );
                 create table if not exists ${temp_schema_name}.currency_detection_payload_input_table_${init_process_id.process_id}(
                            origin_id varchar null,
                            preprocessed_file_id varchar null,
                            paper_no int8 null,
                            input_file_path varchar null,
                            created_user_id varchar NULL,
                            last_updated_user_id varchar NULL,
                            tenant_id int8 NULL,
                            template_id varchar NULL,
                            process_id int8 null,
                            model_registry_id int8 null,
                            group_id int8 null,
                            root_pipeline_id int8 null,
                             batch_id varchar NULL
                            );

                            create table if not exists macro.currency_detection_payload_input_table_audit(
                            origin_id varchar null,
                            preprocessed_file_id varchar null,
                            paper_no int8 null,
                            input_file_path varchar null,
                            created_user_id varchar NULL,
                            last_updated_user_id varchar NULL,
                            tenant_id int8 NULL,
                            template_id varchar NULL,
                            process_id int8 null,
                            model_registry_id int8 null,
                            group_id int8 null,
                            root_pipeline_id int8 null,
                             batch_id varchar NULL
                            );

                            CREATE TABLE IF NOT EXISTS ${temp_schema_name}.summary_audit_papers_${process-id} (
                            module_name text NULL,
                            macro_process text NULL,
                            completed_count int8 NULL,
                            failed_count int8 NULL,
                            min_created_on timestamp NULL,
                            max_created_on timestamp NULL,
                            time_taken int8 NULL,
                            process_id int8 NOT NULL,
                            root_pipeline_id int8 NULL,
                            tenant_id int8 NULL,
                             batch_id varchar NULL
                            );

        "} on-condition if "true"=="true"

        transform as "completed currency detection DDL process " on "intics_zio_db_conn" using {"
                    INSERT INTO currency_detection.currency_detection_pipeline_audit
                    (process_id,group_id, created_on, status, stage, message,root_pipeline_id, tenant_id, batch_id)
                    values( ${init_process_id.process_id},'${gen_group_id.group_id}', now(),
                    'COMPLETED', 'CURRENCY_DETECTION',' currency detection ddl creation FAILED for process_id ${init_process_id.process_id}','${gen_id.root_pipeline_id}', ${tenant_id} ,'${batch_id}');

        "} on-condition if "true"=="true"
}
catch{
transform as "failed in currency detection DDL caller " on "intics_zio_db_conn" using {"
                    INSERT INTO currency_detection.currency_detection_pipeline_audit
                    (process_id,group_id, created_on, status, stage, message, root_pipeline_id, tenant_id, batch_id)
                    values( ${init_process_id.process_id},'${gen_group_id.group_id}', now(),
                    'FAILED', 'CURRENCY_DETECTION',' currency detection ddl creation FAILED for process_id ${init_process_id.process_id}','${gen_id.root_pipeline_id}', ${tenant_id},'${batch_id}');

            "} on-condition if "true"=="true"
}
finally{

}
}