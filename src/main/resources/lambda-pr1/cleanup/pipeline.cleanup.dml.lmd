        transform as "Drop table for Agentic paper filter " on "intics_zio_db_conn" using {"


                INSERT INTO paper_filter.agentic_paper_level_score_audit
                (origin_id, paper_no, root_pipeline_id, batch_id, tenant_id, group_id, is_candidate_paper, paper_level_score)
                select origin_id, paper_no, root_pipeline_id, batch_id, tenant_id, group_id, is_candidate_paper, paper_level_score
                from ${temp_schema_name}.agentic_paper_level_score_${init_process_id.process_id};

                INSERT INTO paper_filter.agentic_entity_level_score_audit
                (origin_id, paper_no, root_pipeline_id, batch_id, tenant_id, group_id, sor_container_id, container_name, container_value,is_candidate_paper,file_path)
                select origin_id, paper_no, root_pipeline_id, batch_id, tenant_id, group_id, sor_container_id, container_name, container_value,is_candidate_paper,file_path
                from ${temp_schema_name}.agentic_entity_level_score_${init_process_id.process_id};

                insert into paper_filter.paper_filter_max_score_papers_audit
                (origin_id, paper_no,root_pipeline_id, batch_id, group_id, tenant_id)
                SELECT origin_id, paper_no,root_pipeline_id, batch_id, group_id, tenant_id
                FROM ${temp_schema_name}.agentic_paper_level_score_${init_process_id.process_id} a
                WHERE (a.origin_id, a.root_pipeline_id, a.batch_id, a.tenant_id, a.group_id, a.paper_level_score) IN
                (SELECT origin_id, root_pipeline_id, batch_id, tenant_id, group_id, MAX(paper_level_score)
                FROM ${temp_schema_name}.agentic_paper_level_score_${init_process_id.process_id}
                GROUP BY origin_id, root_pipeline_id, batch_id, tenant_id, group_id);


                insert into paper_filter.paper_filter_only_false_containers_audit
                (origin_id,sor_container_id,container_name,root_pipeline_id, batch_id, group_id,tenant_id)
                SELECT ps.origin_id, sc.sor_container_id, ps.container_name, ps.root_pipeline_id, ps.batch_id, ps.group_id,ps.tenant_id
                FROM  ${temp_schema_name}.agentic_paper_filter_output_${init_process_id.process_id} ps
                INNER JOIN sor_meta.sor_container sc ON sc.sor_container_name = ps.container_name AND sc.tenant_id = ps.tenant_id
                WHERE group_id = '${group_id}'
                and batch_id='${batch_id}'
                and  sc.tenant_id=${tenant_id}
                and sc.document_type='${document_type}'
                GROUP BY sc.sor_container_id,ps.origin_id,ps.container_name,ps.root_pipeline_id, ps.batch_id, ps.group_id,ps.tenant_id
                HAVING COUNT(DISTINCT CASE WHEN container_value = 'true' THEN paper_no END) = 0;


                INSERT INTO paper_filter.agentic_paper_filter_input_data_audit (process_id, tenant_id, template_id,
                group_id, origin_id, paper_no, file_path, root_pipeline_id, template_name, batch_id, created_on, user_prompt,
                system_prompt) SELECT process_id, tenant_id, template_id, group_id, origin_id, paper_no, file_path,
                root_pipeline_id, template_name, batch_id, created_on, user_prompt, system_prompt
                FROM ${temp_schema_name}.agentic_paper_filter_input_data_${init_process_id.process_id};


                INSERT INTO paper_filter.agentic_paper_filter_output_audit
                (process_id, tenant_id, template_id, group_id, batch_id, origin_id, paper_no, file_path, file_name,
                extracted_text, status, stage, message, template_name, is_blank_page, created_on, last_updated_on,
                root_pipeline_id, model_name, model_version, container_name, container_value,container_id,prompt_type)
                SELECT process_id, tenant_id, template_id, group_id, batch_id, origin_id, paper_no, file_path, file_name,
                extracted_text, status, stage, message, template_name, is_blank_page, created_on, last_updated_on,
                root_pipeline_id, model_name, model_version, container_name, container_value,container_id,prompt_type
                FROM ${temp_schema_name}.agentic_paper_filter_output_${init_process_id.process_id};

                INSERT INTO paper_filter.agentic_container_filter_base_table_audit
                (origin_id, paper_no, container_name, container_value, root_pipeline_id, batch_id, tenant_id, group_id, sor_container_id)
                select a.origin_id, a.paper_no, a.container_name, a.container_value, a.root_pipeline_id, a.batch_id, a.tenant_id, a.group_id, sc.sor_container_id
                from ${temp_schema_name}.agentic_paper_filter_output_${init_process_id.process_id} a
                JOIN sor_meta.sor_container sc on a.container_name=sc.sor_container_name AND a.tenant_id=sc.tenant_id
                where sc.document_type='${document_type}';

                DROP TABLE IF EXISTS ${temp_schema_name}.agentic_container_filter_base_table_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.agentic_paper_level_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.agentic_entity_level_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.agentic_paper_filter_input_data_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.agentic_paper_filter_output_${init_process_id.process_id};

        "} on-condition if "${agentic.paper.filter.activator}"=="true"


        transform as "Drop table for sor validation" on "intics_zio_db_conn" using {"

                DROP TABLE IF EXISTS ${temp_schema_name}.ocr_text_comparison_input_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.ocr_text_comparison_result_${init_process_id.process_id};

        "} on-condition if "${sor.validation.main.activator}"=="true"


        transform as "Drop table for cpt-code multi value sor-item " on "intics_zio_db_conn" using {"

                insert into macro.multi_value_sor_item_audit
                ( tenant_id, aggregated_score, masked_score, origin_id,
                paper_no, predicted_value, rank, sor_item_attribution_id, sor_item_name, document_id,b_box,group_id, root_pipeline_id,vqa_score,question_id,synonym_id, model_registry, batch_id, frequency)
                select  tenant_id, aggregated_score, masked_score, origin_id,
                paper_no, predicted_value, rank, sor_item_attribution_id, sor_item_name, document_id,b_box,group_id, root_pipeline_id,vqa_score,question_id,synonym_id, model_registry, batch_id, frequency
                from ${temp_schema_name}.multi_value_sor_item_${init_process_id.process_id};

                insert into macro.max_conf_table_audit
                (origin_id ,sor_item_name, b_box, vqa_score, root_pipeline_id, batch_id,tenant_id)
                select origin_id ,sor_item_name, b_box, vqa_score,root_pipeline_id, batch_id,tenant_id
                from ${temp_schema_name}.max_conf_table_${init_process_id.process_id};

                insert into macro.multi_value_sor_item_page_clean_up_audit
                (tenant_id, aggregated_score, masked_score, origin_id,
                paper_no, predicted_value, rank, sor_item_attribution_id, sor_item_name, document_id,b_box,group_id,
                root_pipeline_id,vqa_score,question_id,synonym_id, model_registry, batch_id, frequency)
                select tenant_id, aggregated_score, masked_score, origin_id,
                paper_no, predicted_value, rank, sor_item_attribution_id, sor_item_name, document_id,b_box,group_id,
                root_pipeline_id,vqa_score,question_id,synonym_id, model_registry, batch_id, frequency
                from ${temp_schema_name}.multi_value_sor_item_page_clean_up_${init_process_id.process_id};


                DROP TABLE IF EXISTS ${temp_schema_name}.multi_value_sor_item_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.max_conf_table_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.multi_value_sor_item_page_clean_up_${init_process_id.process_id};

        "} on-condition if "${voting.multi.value.line.item.activator}"=="true"

        transform as "Temp table drop for Eye Cue" on "intics_zio_db_conn" using {"
               INSERT INTO doc_eyecue.doc_eyecue_input_table_audit
               (origin_id, batch_id, process_id, group_id, tenant_id, template_id, root_pipeline_id, input_file_path, created_on, document_id, file_name)
               select origin_id, batch_id, process_id, group_id, tenant_id, template_id, root_pipeline_id, input_file_path, created_on, document_id, file_name
                FROM ${temp_schema_name}.doc_eyecue_input_table_${init_process_id.process_id}
                where tenant_id='${tenant_id}' and group_id='${group_id}';

                DROP TABLE IF EXISTS ${temp_schema_name}.doc_eyecue_pipeline_result_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.doc_eyecue_input_table_${init_process_id.process_id};
        "} on-condition if "${doc.eyecue.activator}" == "true"

        transform as "drop deep sift data in temporary tables" on "intics_zio_db_conn" using
        {"
                INSERT INTO deep_sift.deep_sift_input_audit (
                origin_id, group_id, input_file_path, created_on, created_by, root_pipeline_id,
                tenant_id, batch_id, paper_no, source_document_type,
                model_id, model_name, base_prompt, system_prompt
                )
                SELECT
                origin_id, group_id, input_file_path, created_on, created_by, root_pipeline_id,
                tenant_id, batch_id, paper_no, source_document_type,
                model_id, model_name, base_prompt, system_prompt
                FROM ${temp_schema_name}.deep_sift_input_${init_process_id.process_id}
                where tenant_id='${tenant_id}' and group_id='${group_id}' and batch_id='${batch_id}';

                INSERT INTO deep_sift.deep_sift_output_audit (
                origin_id, group_id, input_file_path, created_on, created_by, root_pipeline_id,
                tenant_id, batch_id, extracted_text, paper_no, source_document_type,
                model_id, model_name, timetaken_ms, status, request, response, endpoint
                )
                SELECT
                origin_id, group_id, input_file_path, created_on, created_by, root_pipeline_id,
                tenant_id, batch_id, extracted_text, paper_no, source_document_type,
                model_id, model_name, timetaken_ms, status, request, response, endpoint
                FROM ${temp_schema_name}.deep_sift_output_${init_process_id.process_id}
                where tenant_id='${tenant_id}' and group_id='${group_id}' and batch_id='${batch_id}';

                INSERT INTO deep_sift.deep_search_input_audit (
                origin_id,
                group_id,
                created_on,
                created_by,
                extracted_text,
                root_pipeline_id,
                tenant_id,
                batch_id,
                paper_no,
                source_document_type,
                sor_container_id,
                sor_container_name,
                sor_item_id,
                sor_item_name,
                search_id,
                search_name,
                keywords
                )
                SELECT
                origin_id,
                group_id,
                created_on,
                created_by,
                extracted_text,
                root_pipeline_id,
                tenant_id,
                batch_id,
                paper_no,
                source_document_type,
                sor_container_id,
                sor_container_name,
                sor_item_id,
                sor_item_name,
                search_id,
                search_name,
                keywords
                FROM ${temp_schema_name}.deep_search_input_${init_process_id.process_id}
                where tenant_id='${tenant_id}' and group_id='${group_id}' and batch_id='${batch_id}';

                INSERT INTO deep_sift.deep_search_output_audit (
                origin_id,
                group_id,
                created_on,
                created_by,
                root_pipeline_id,
                tenant_id,
                batch_id,
                paper_no,
                source_document_type,
                sor_container_id,
                sor_container_name,
                sor_item_id,
                sor_item_name,
                search_id,
                search_name,
                search_output,
                timetaken_ms,
                status
                )
                SELECT
                origin_id,
                group_id,
                created_on,
                created_by,
                root_pipeline_id,
                tenant_id,
                batch_id,
                paper_no,
                source_document_type,
                sor_container_id,
                sor_container_name,
                sor_item_id,
                sor_item_name,
                search_id,
                search_name,
                search_output,
                timetaken_ms,
                status
                FROM ${temp_schema_name}.deep_search_output_${init_process_id.process_id}
                where tenant_id='${tenant_id}' and group_id='${group_id}' and batch_id='${batch_id}';

                INSERT INTO deep_sift.final_deep_search_audit (
                origin_id, group_id, created_on, created_by, root_pipeline_id, tenant_id, batch_id,
                source_document_type, sor_container_id, sor_container_name, sor_item_id, sor_item_name,
                search_id, comma_separated_search_outputs, min_paper_no)
                SELECT origin_id, group_id, created_on, created_by, root_pipeline_id, tenant_id, batch_id,
                source_document_type, sor_container_id, sor_container_name, sor_item_id, sor_item_name,
                search_id, comma_separated_search_outputs, min_paper_no
                FROM ${temp_schema_name}.final_deep_search_${init_process_id.process_id}
                where tenant_id= ${tenant_id} and group_id='${group_id}' and batch_id='${batch_id}';

                DROP TABLE IF EXISTS ${temp_schema_name}.deep_sift_input_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.deep_sift_output_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.deep_search_input_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.deep_search_output_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.final_deep_search_${init_process_id.process_id};
        "} on-condition if "${deep.sift.extraction.activator}"=="true"
}
catch{

}
finally{

        transform as "update transaction table to completed if origin mode is transaction" on "intics_zio_db_conn" using
        {"

                UPDATE info.transaction
                SET transaction_status='COMPLETED' , last_updated_on=now(), time_taken=EXTRACT(EPOCH FROM (now() - created_on))
                WHERE transaction_id='${transaction_id}' and tenant_id=${tenant_id};

        "} on-condition if "${origin_type}"=="TRANSACTION"


        assign as "gen_id" source "intics_zio_db_conn" using
        {"
                select reference_id
                from inbound_config.ingestion_downloaded_file_details
                where transaction_id='${transaction_id}';

        "} on-condition if "${origin_type}"=="TRANSACTION"

        assign as "reference" source "intics_zio_db_conn" using
        {"
                select count(*) as total_count
                from inbound_config.filenet_queue fq
                join inbound_config.ingestion_file_details ifd on fq.reference_id=ifd.reference_id and fq.tenant_id =ifd.tenant_id
                join inbound_config.ingestion_downloaded_file_details idfd
                on idfd.inbound_transaction_id = ifd.inbound_transaction_id
                and idfd.tenant_id = ifd.tenant_id
                where idfd.reference_id=fq.reference_id and fq.tenant_id='${tenant_id}' AND fq.reference_id = '${gen_id.reference_id}';

                select count(*) as comp_count
                from inbound_config.filenet_queue fq
                join inbound_config.ingestion_file_details ifd on fq.reference_id=ifd.reference_id and fq.tenant_id =ifd.tenant_id
                join inbound_config.ingestion_downloaded_file_details idfd
                on idfd.inbound_transaction_id = ifd.inbound_transaction_id
                and idfd.tenant_id = ifd.tenant_id
                join info.transaction t on t.transaction_id =idfd.transaction_id and t.tenant_id=idfd.tenant_id
                where idfd.reference_id=fq.reference_id and t.transaction_status='COMPLETED' AND fq.tenant_id='${tenant_id}' AND fq.reference_id = '${gen_id.reference_id}';

                select count(*) as fail_count
                from inbound_config.filenet_queue fq
                join inbound_config.ingestion_file_details ifd on fq.reference_id=ifd.reference_id and fq.tenant_id =ifd.tenant_id
                join inbound_config.ingestion_downloaded_file_details idfd
                on idfd.inbound_transaction_id = ifd.inbound_transaction_id
                and idfd.tenant_id = ifd.tenant_id
                join info.transaction t on t.transaction_id =idfd.transaction_id and t.tenant_id=idfd.tenant_id
                where idfd.reference_id=fq.reference_id and t.transaction_status='FAILED' AND fq.tenant_id='${tenant_id}' AND fq.reference_id = '${gen_id.reference_id}';

        "} on-condition if "${origin_type}"=="TRANSACTION"


        transform as "update to completed for inbound_config.filenet_queue table" on "intics_zio_db_conn" using
        {"
                update inbound_config.filenet_queue fq
                    set status = (case when '${reference.total_count}'='${reference.comp_count}' then 'COMPLETED'
                            when '${reference.total_count}'='${reference.fail_count}' then 'FAILED'
                            WHEN '${reference.total_count}'::int8=('${reference.fail_count}'::int8+'${reference.comp_count}'::int8) then 'FAILED'
                            else  fq.status
                            end)
                where fq.reference_id = '${gen_id.reference_id}' and fq.tenant_id ='${tenant_id}';

        "} on-condition if "${origin_type}"=="TRANSACTION"
}

}
