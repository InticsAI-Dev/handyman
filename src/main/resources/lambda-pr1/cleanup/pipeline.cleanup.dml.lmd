                DROP TABLE IF EXISTS ${temp_schema_name}.after_filtered_llm_json_parser_output_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.llm_json_parser_label_input_${init_process_id.process_id};
