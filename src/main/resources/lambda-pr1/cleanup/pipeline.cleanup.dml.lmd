process "pipeline.cleanup.dml"
{
try{


        assign as "sor_transaction" source "intics_zio_db_conn" using
        {"
                select (case when '${sor.transaction.activator}'='true' or '${sor.transaction.nextgen.activator}'='true' then 'true' else 'false' end) as activator
        "}on-condition if "true"=="true"

        assign as "bbox" source "intics_zio_db_conn" using
        {"
                select  (case when '${sor.transaction.nextgen.bbox.outbound.activator}'='true' AND '${sor.transaction.radon.kvp.bbox.activator}'='true' then 'true' else 'false' end) as radon_bbox_activator;
                select  (case when '${sor.transaction.legacy.bbox.outbound.activator}'='true' AND '${sor.transaction.radon.kvp.bbox.activator}'='true' then 'true' else 'false' end) as legacy_bbox_activator;
        "}on-condition if "true"=="true"

        transform as "Move data from downloaded_asset_source_details temp table to main table" on "intics_zio_db_conn" using
        {"
                INSERT INTO info.downloaded_asset_source_details
                (origin_id, asset_id, document_id, file_downloaded_time, inbound_transaction_id, downloaded_file_path, request_txn_id, file_id, file_name, file_size, total_pages, file_path, height, width, file_checksum, file_extension, transaction_id, group_id, root_pipeline_id, batch_id, tenant_id, reference_id)
                SELECT origin_id, asset_id, document_id, file_downloaded_time, inbound_transaction_id, downloaded_file_path, request_txn_id, file_id, file_name, file_size, total_pages, file_path, height, width, file_checksum, file_extension, transaction_id, group_id, root_pipeline_id, batch_id, tenant_id, reference_id
                FROM ${temp_schema_name}.downloaded_asset_source_details_${init_process_id.process_id};

                DROP TABLE IF EXISTS ${temp_schema_name}.downloaded_asset_source_details_${init_process_id.process_id};
        "} on-condition if "true"=="true"

        transform as "insert into audit tables for ingestion with process_id ${init_process_id.process_id}" on "intics_zio_db_conn" using
        {"
                INSERT INTO macro.batch_split_id_generation_audit
                (file_id, file_name, decoded_file_name, file_checksum, file_path, file_extension, file_size, status, version, root_pipeline_id, tenant_id,channel_id, created_user_id, created_on, last_updated_user_id, last_updated_on, height, width, dpi, row_count, split_count)
                SELECT file_id, file_name, decoded_file_name, file_checksum, file_path, file_extension, file_size, status, version, '${gen_id.root_pipeline_id}', tenant_id,channel_id, created_user_id, created_on, last_updated_user_id, last_updated_on, height, width, dpi, row_count, split_count
                FROM ${temp_schema_name}.batch_split_id_generation_${init_process_id.process_id};


                INSERT INTO ingestion.final_sanitizer_summary_audit
                (row_count, correct_row_count, error_row_count, comments, created_at,process_id,root_pipeline_id, tenant_id)
                SELECT row_count, correct_row_count, error_row_count, comments, created_at,'${init_process_id.process_id}','${gen_id.root_pipeline_id}', '${tenant_id}'
                FROM ${temp_schema_name}.sanitizer_summary_origin_audit_${init_process_id.process_id};

                INSERT INTO macro.file_details_origin_audit
                (file_id, process_id, file_checksum, file_extension, file_name, decoded_file_name, file_path, file_size, root_pipeline_id, tenant_id,encode, height, width, dpi, batch_id)
                SELECT file_id, process_id, file_checksum, file_extension, file_name, decoded_file_name, file_path, file_size,'${gen_id.root_pipeline_id}', '${tenant_id}',encode, height, width, dpi, batch_id
                FROM ${temp_schema_name}.file_details_origin_${init_process_id.process_id};

                DROP TABLE IF EXISTS ${temp_schema_name}.source_of_origin_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.asset_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.sanitizer_summary_origin_audit_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.file_details_origin_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.batch_split_id_generation_${init_process_id.process_id};


        "} on-condition if "${ingestion.main.caller.activator}"=="true"

        transform as "Delete from  temporary tables for preprocess with process_id ${init_process_id.process_id}" on "intics_zio_db_conn" using
        {"
                INSERT INTO preprocess.final_sanitizer_summary_audit
                (row_count, correct_row_count, error_row_count, comments, created_at,process_id,root_pipeline_id, tenant_id, batch_id)
                SELECT row_count, correct_row_count, error_row_count, comments, created_at,'${init_process_id.process_id}','${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.sanitizer_summary_truth_audit_${init_process_id.process_id};

                INSERT INTO template_detection.b_template_response_group_audit
                (origin_id, tenant_id, paper_no, template_name, occurance_count, batch_id, root_pipeline_id)
                SELECT origin_id, tenant_id, paper_no, template_name, occurance_count, batch_id, root_pipeline_id
                FROM ${temp_schema_name}.b_template_response_group_${init_process_id.process_id};

                INSERT INTO template_detection.c_template_max_occurance_audit
                (origin_id, template_name, tenant_id, paper_no, occurance_count, batch_id, root_pipeline_id)
                SELECT origin_id, template_name, tenant_id, paper_no, occurance_count, batch_id, root_pipeline_id
                FROM ${temp_schema_name}.c_template_max_occurance_${init_process_id.process_id};

                INSERT INTO template_detection.d_template_name_match_audit
                (paper_no, tenant_id, origin_id, template_name, batch_id)
                SELECT paper_no, tenant_id, origin_id, template_name, batch_id
                FROM ${temp_schema_name}.d_template_name_match_${init_process_id.process_id};

                INSERT INTO template_detection.e_template_name_fuzzy_match_audit
                (origin_id, tenant_id, predicted_template_name, template_name, fuzzy_score, batch_id, root_pipeline_id, document_type)
                SELECT origin_id, tenant_id, predicted_template_name, template_name, fuzzy_score, batch_id, root_pipeline_id,document_type
                FROM ${temp_schema_name}.e_template_name_fuzzy_match_${init_process_id.process_id};

                INSERT INTO template_detection.f_template_name_max_fuzzy_match_audit
                (origin_id, tenant_id, max, batch_id)
                SELECT origin_id, tenant_id, max, batch_id
                FROM ${temp_schema_name}.f_template_name_max_fuzzy_match_${init_process_id.process_id};

                INSERT INTO template_detection.g_final_template_match_audit
                (origin_id, tenant_id, template_name, fuzzy_score, batch_id)
                SELECT origin_id, tenant_id, template_name, fuzzy_score, batch_id
                FROM ${temp_schema_name}.g_final_template_match_${init_process_id.process_id};

                INSERT INTO template_detection.template_detection_result_audit
                (process_id, origin_id, group_id, template_name, score, tenant_id, template_id, created_on, root_pipeline_id, batch_id)
                SELECT process_id, origin_id, group_id, template_name, score, tenant_id, template_id, created_on, root_pipeline_id, batch_id
                FROM ${temp_schema_name}.template_detection_result_${init_process_id.process_id};

                INSERT INTO template_detection.a_template_detection_response_audit
                (process_id, origin_id, paper_no, group_id, batch_id, processed_file_path, question, predictedAttribution_value, score, bboxes, image_width, image_height, image_DPI, extracted_image_unit, tenant_id, template_id, status, stage, message, created_on, last_updated_on, root_pipeline_id, model_name, model_version, model_registry_id, request, response, endpoint)
                SELECT process_id, origin_id, paper_no, group_id, batch_id, processed_file_path, question, predictedAttribution_value, score, bboxes, image_width, image_height, image_DPI, extracted_image_unit, tenant_id, template_id, status, stage, message, created_on, last_updated_on, root_pipeline_id, model_name, model_version, model_registry_id, request, response, endpoint
                FROM ${temp_schema_name}.a_template_detection_response_${init_process_id.process_id};


                INSERT INTO macro.file_details_truth_audit
                (file_id, process_id, root_pipeline_id, tenant_id, batch_id, file_checksum, file_extension, file_name, decoded_file_name, file_path, file_size, height, width, dpi, encode)
                select file_id, process_id, '${gen_id.root_pipeline_id}', tenant_id, batch_id, file_checksum, file_extension, file_name, decoded_file_name, file_path, file_size, height, width, dpi, encode
                from ${temp_schema_name}.file_details_truth_${init_process_id.process_id};

        "} on-condition if "${preprocess.main.caller.activator}"=="true"

        transform as "DROP TABLE QUERIES to clean up the temp tables" on "intics_zio_db_conn" using
        {"

                DROP TABLE IF EXISTS ${temp_schema_name}.model_score_result_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.zero_shot_classifier_filtering_result_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.paper_filter_zsc_pm_input_aggregate_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.paper_filter_zsc_pm_input_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.synonym_level_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.potential_triage_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.potential_synonyms_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.potential_paper_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.potential_feature_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.batching_potential_feature_queue_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.phrase_match_filtering_result_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.paper_level_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.entity_level_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.agg_doc_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.agg_phrase_match_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.agg_zero_shot_classifier_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.max_doc_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.max_entity_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.max_phrase_match_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.max_zero_shot_classifier_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.model_level_score_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.zero_shot_classifier_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.phrase_match_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.paper_filter_score_${init_process_id.process_id};

        "} on-condition if "${root.filter.activator}"=="true"


        transform as "move to audit for pipeline summary audit" on "intics_zio_db_conn" using
        {"

                INSERT INTO macro.summary_audit_files_archive
                (module_name, macro_process, completed_count, failed_count, min_created_on, max_created_on, time_taken, process_id, root_pipeline_id, tenant_id, batch_id)
                SELECT module_name, macro_process, completed_count, failed_count, min_created_on, max_created_on, time_taken, process_id, '${gen_id.root_pipeline_id}', '${tenant_id}', batch_id
                FROM ${temp_schema_name}.summary_audit_files_${init_process_id.process_id};

                INSERT INTO macro.summary_audit_papers_archive
                (module_name, macro_process, completed_count, failed_count, min_created_on, max_created_on, time_taken, process_id, root_pipeline_id, tenant_id, batch_id)
                SELECT module_name, macro_process, completed_count, failed_count, min_created_on, max_created_on, time_taken, process_id, '${gen_id.root_pipeline_id}', '${tenant_id}', batch_id
                FROM ${temp_schema_name}.summary_audit_papers_${init_process_id.process_id};

        "} on-condition if "true"=="true"

        transform as "Move temporary tables data for sor transaction with process id ${init_process_id.process_id}" on "intics_zio_db_conn" using
        {"

                INSERT INTO sor_transaction.final_sanitizer_summary_audit
                (row_count, correct_row_count, error_row_count, created_at,process_id,root_pipeline_id, tenant_id)
                SELECT  row_count, correct_row_count, error_row_count, created_at,'${init_process_id.process_id}','${gen_id.root_pipeline_id}', ${tenant_id}
                FROM ${temp_schema_name}.sanitizer_summary_${init_process_id.process_id};

                INSERT INTO macro.sor_transaction_tqa_audit
                (tqa_id, template_name, truth_entity, sor_item_name, group_id, synonym, question, question_id,weights, synonym_id, origin_id, paper_no, file_path, root_pipeline_id, document_type,tenant_id,model_name, model_version, model_registry, batch_id)
                SELECT tqa_id, template_name, truth_entity, sor_item_name, group_id, synonym, question, question_id,weights, synonym_id, origin_id, paper_no, file_path, root_pipeline_id, document_type, ${tenant_id},model_name, model_version, model_registry, batch_id
                FROM ${temp_schema_name}.sor_transaction_tqa_${init_process_id.process_id};

                INSERT INTO macro.sor_transaction_tqa_grouping_duplicates_a_audit
                (tqa_id, template_name, truth_entity, sor_item_name, group_id, synonym, question, question_id, weights, synonym_id, origin_id, paper_no, file_path, root_pipeline_id, document_type, tenant_id, batch_id)
                SELECT a.tqa_id, a.template_name, a.truth_entity, a.sor_item_name, a.group_id, a.synonym, a.question,
                a.question_id, a.weights, a.synonym_id, a.origin_id, a.paper_no, a.file_path, '${gen_id.root_pipeline_id}', a.document_type, a.tenant_id, batch_id
                FROM
                ${temp_schema_name}.sor_transaction_tqa_grouping_duplicates_a_${init_process_id.process_id} a;

                INSERT INTO macro.sor_transaction_tqa_grouping_duplicates_b_audit
                (max_question_id, question, file_path,root_pipeline_id,document_type,truth_entity,sor_item_name,synonym, batch_id)
                SELECT max_question_id, question, file_path,'${gen_id.root_pipeline_id}',document_type,truth_entity,sor_item_name,synonym, batch_id
                FROM ${temp_schema_name}.sor_transaction_tqa_grouping_duplicates_b_${init_process_id.process_id};

                INSERT INTO macro.sor_transaction_final_tqa_audit
                (questions,sor_item_name,question_id, synonym_id, weights, file_path, paper_type, model_registry,model_registry_id, tenant_id, origin_id,group_id, paper_no, category, root_pipeline_id, batch_id)
                SELECT questions,sor_item_name,question_id, synonym_id, weights, file_path, paper_type, model_registry,model_registry_id, tenant_id, origin_id,group_id, paper_no, category, '${gen_id.root_pipeline_id}', batch_id
                FROM ${temp_schema_name}.sor_transaction_final_tqa_${init_process_id.process_id};

        "} on-condition if "${sor_transaction.activator}"=="true"



        transform as "Move temporary tables data into main audit table in voting" on "intics_zio_db_conn" using
        {"
                INSERT INTO macro.a_agg_input_table_audit
                (origin_id, paper_no, sor_item_name, predicted_value, vqa_score,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, paper_no, sor_item_name, predicted_value, vqa_score, '${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.a_agg_input_table_${init_process_id.process_id};

                INSERT INTO macro.b1_scalar_max_score_multi_occur_audit
                (origin_id, paper_no, sor_item_name, occur_count, vqa_score,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, paper_no, sor_item_name, occur_count, vqa_score, '${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.b1_scalar_max_score_multi_occur_${init_process_id.process_id};

                INSERT INTO macro.b2_scalar_max_score_single_occur_audit
                (origin_id, paper_no, sor_item_name, occur_count, vqa_score,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, paper_no, sor_item_name, occur_count, vqa_score, '${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.b2_scalar_max_score_single_occur_${init_process_id.process_id};

                INSERT INTO macro.c_multi_occur_freq_for_scalar_audit
                (origin_id, paper_no, sor_item_name, predicted_value, freq, vqa_score,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, paper_no, sor_item_name, predicted_value, freq, vqa_score, '${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM  ${temp_schema_name}.c_multi_occur_freq_for_scalar_${init_process_id.process_id};

                INSERT INTO macro.d_max_freq_from_multi_occur_audit
                (origin_id, paper_no, sor_item_name, freq,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, paper_no, sor_item_name, freq, '${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM  ${temp_schema_name}.d_max_freq_from_multi_occur_${init_process_id.process_id};

                INSERT INTO macro.e_final_result_for_freq_audit
                (origin_id, paper_no, sor_item_name, predicted_value, freq, vqa_score,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, paper_no, sor_item_name, predicted_value, freq, vqa_score, '${gen_id.root_pipeline_id}', ${tenant_id},batch_id
                FROM  ${temp_schema_name}.e_final_result_for_freq_${init_process_id.process_id};

                INSERT INTO macro.f1_single_freq_occur_audit
                (origin_id, paper_no, sor_item_name, vqa_score, freq, predicted_value,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, paper_no, sor_item_name, vqa_score, freq, predicted_value, '${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM  ${temp_schema_name}.f1_single_freq_occur_${init_process_id.process_id};

                INSERT INTO macro.f2_group_concat_based_on_freq_audit
                (origin_id, paper_no, sor_item_name, vqa_score, freq, predicted_value,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, paper_no, sor_item_name, vqa_score, freq, predicted_value, '${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM  ${temp_schema_name}.f2_group_concat_based_on_freq_${init_process_id.process_id};

                INSERT INTO macro.final_valuation_result_audit
                (origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, freq,root_pipeline_id,question_id,synonym_id, tenant_id, batch_id)
                SELECT origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, freq, '${gen_id.root_pipeline_id}',question_id,synonym_id, ${tenant_id}, batch_id
                FROM  ${temp_schema_name}.final_valuation_result_${init_process_id.process_id};

                INSERT INTO macro.voting_out_agg_summary_audit
                (origin_id, sor_item_name, total_questions,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, sor_item_name, total_questions, '${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.voting_out_agg_summary_${init_process_id.process_id};

                INSERT INTO macro.voting_out_empty_entries_audit
                (origin_id, sor_item_name, question, predicted_value, voting_out,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, sor_item_name, question, predicted_value, voting_out, '${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.voting_out_empty_entries_${init_process_id.process_id};

                INSERT INTO macro.voting_out_empty_entry_summary_audit
                (origin_id, sor_item_name, empty_prediction_values, voting_out_threshold,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, sor_item_name, empty_prediction_values, voting_out_threshold,'${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.voting_out_empty_entry_summary_${init_process_id.process_id};

                INSERT INTO macro.voting_out_empty_summary_percentage_audit
                (origin_id, sor_item_name, total_questions, empty_prediction_values, empty_percentage, voting_out_threshold, voting_out_empty_flag,root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, sor_item_name, total_questions, empty_prediction_values, empty_percentage, voting_out_threshold, voting_out_empty_flag,'${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.voting_out_empty_summary_percentage_${init_process_id.process_id};

                INSERT INTO macro.sor_item_based_max_value_audit
                (origin_id, paper_no, sor_item_name, max_score, root_pipeline_id,tenant_id, batch_id)
                SELECT origin_id, paper_no, sor_item_name, max_score ,'${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.sor_item_based_max_value_${init_process_id.process_id};

                INSERT INTO macro.a_agg_occur_max_audit
                (group_id, origin_id, paper_no, sor_item_name, predicted_value, max_score, tenant_id, occur_count, batch_id, root_pipeline_id)
                select group_id, origin_id, paper_no, sor_item_name, predicted_value, max_score, tenant_id, occur_count, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.a_agg_occur_max_${init_process_id.process_id};

                INSERT INTO macro.b2_scalar_max_score_multi_occur_freq_audit
                (origin_id, paper_no, sor_item_name, tenant_id, vqa_score, occur_count, batch_id, root_pipeline_id)
                select origin_id, paper_no, sor_item_name, tenant_id, vqa_score, occur_count, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.b2_scalar_max_score_multi_occur_freq_${init_process_id.process_id};

                INSERT INTO macro.b_max_occur_item_audit
                (group_id, origin_id, paper_no, sor_item_name, tenant_id, occur_count, batch_id, root_pipeline_id)
                select group_id, origin_id, paper_no, sor_item_name, tenant_id, occur_count, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.b_max_occur_item_${init_process_id.process_id};

                INSERT INTO voting.final_valuation_result_audit
                (origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, freq, question_id, synonym_id, tenant_id, model_registry, batch_id, root_pipeline_id)
                select origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, freq, question_id, synonym_id, tenant_id, model_registry, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.final_valuation_result_${init_process_id.process_id};

                INSERT INTO voting.c3_scalar_max_score_multi_line_audit
                (origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, occur_count, question_id, synonym_id, tenant_id, model_registry, batch_id, root_pipeline_id)
                select origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, occur_count, question_id, synonym_id, tenant_id, model_registry, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.c3_scalar_max_score_multi_line_${init_process_id.process_id};

                INSERT INTO voting.c2_scalar_max_score_multi_occur_freq_audit
                (origin_id, paper_no, sor_item_name, tenant_id, vqa_score, occur_count, batch_id, root_pipeline_id)
                select origin_id, paper_no, sor_item_name, tenant_id, vqa_score, occur_count, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.c2_scalar_max_score_multi_occur_freq_${init_process_id.process_id};

                INSERT INTO voting.c1_rank_based_valuation_result_audit
                (origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, freq, question_id, synonym_id, tenant_id, model_registry, batch_id, root_pipeline_id)
                select origin_id, paper_no, sor_item_name, b_box, rnk, predicted_value, vqa_score, freq, question_id, synonym_id, tenant_id, model_registry, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.c1_rank_based_valuation_result_${init_process_id.process_id};

                INSERT INTO voting.b3_scalar_multi_line_single_occur_audit
                (origin_id, paper_no, sor_item_name, occur_count, vqa_score, tenant_id, sv_occur_count, batch_id, root_pipeline_id)
                select origin_id, paper_no, sor_item_name, occur_count, vqa_score, tenant_id, sv_occur_count, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.b3_scalar_multi_line_single_occur_${init_process_id.process_id};

                INSERT INTO voting.b2_scalar_single_line_single_occur_audit
                (origin_id, paper_no, sor_item_name, occur_count, max_vqa_score, tenant_id, sv_occur_count, batch_id, root_pipeline_id)
                select origin_id, paper_no, sor_item_name, occur_count, max_vqa_score, tenant_id, sv_occur_count, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.b2_scalar_single_line_single_occur_${init_process_id.process_id};

                INSERT INTO voting.b1_scalar_multi_line_multi_occur_audit
                (origin_id, paper_no, sor_item_name, occur_count, tenant_id, sv_occur_count, batch_id, root_pipeline_id)
                select origin_id, paper_no, sor_item_name, occur_count, tenant_id, sv_occur_count, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.b1_scalar_multi_line_multi_occur_${init_process_id.process_id};

                INSERT INTO voting.a3_agg_input_table_audit
                (origin_id, paper_no, sor_item_name, predicted_value, vqa_score, tenant_id, occur_count, batch_id, root_pipeline_id)
                select origin_id, paper_no, sor_item_name, predicted_value, vqa_score, tenant_id, occur_count, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.a3_agg_input_table_${init_process_id.process_id};

                INSERT INTO voting.a2_max_occur_item_audit
                (group_id, origin_id, paper_no, sor_item_name, tenant_id, occur_count, batch_id, root_pipeline_id)
                select group_id, origin_id, paper_no, sor_item_name, tenant_id, occur_count, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.a2_max_occur_item_${init_process_id.process_id};

                INSERT INTO voting.a1_agg_occur_count_audit
                (group_id, origin_id, paper_no, sor_item_name, predicted_value, max_score, tenant_id, occur_count, batch_id, root_pipeline_id)
                select  group_id, origin_id, paper_no, sor_item_name, predicted_value, max_score, tenant_id, occur_count, batch_id, '${gen_id.root_pipeline_id}'
                from ${temp_schema_name}.a1_agg_occur_count_${init_process_id.process_id};


        "} on-condition if "${voting.v3.activator}"=="true"

        transform as "Move data from temporary table to main audit tables" on "intics_zio_db_conn" using
        {"

                INSERT INTO voting.paper_unnest_audit
                (origin_id, pahub_id, paper_number, root_pipeline_id, tenant_id, batch_id)
                SELECT  origin_id, pahub_id, paper_number, root_pipeline_id, ${tenant_id}, batch_id
                FROM ${temp_schema_name}.paper_unnest_${init_process_id.process_id};

                INSERT INTO voting.name_score_audit
                (origin_id, paper_no, sor_item_name, weight_score, predicted_value, b_box, confidence_score, root_pipeline_id, frequency, cummulative_score, filter_score,question_id,synonym_id, tenant_id, batch_id)
                SELECT  origin_id, paper_no, sor_item_name, weight_score, predicted_value, b_box, confidence_score, '${gen_id.root_pipeline_id}', frequency, cummulative_score, filter_score,question_id,synonym_id, ${tenant_id}, batch_id
                FROM ${temp_schema_name}.name_score_${init_process_id.process_id};

                INSERT INTO voting.cummulative_score_audit
                (origin_id, sor_item_name, max_cummulative_score, root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, sor_item_name, max_cummulative_score ,'${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.cummulative_score_${init_process_id.process_id};

                INSERT INTO voting.score_count_audit
                (origin_id, sor_item_name, max_cummulative_score, score_count, root_pipeline_id, tenant_id, batch_id)
                SELECT origin_id, sor_item_name, max_cummulative_score, score_count ,'${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.score_count_${init_process_id.process_id};

                INSERT INTO voting.cummulative_final_audit
                (min_score_id, origin_id, sor_item_name, cummulative_score, root_pipeline_id, tenant_id, batch_id)
                SELECT min_score_id, origin_id, sor_item_name, cummulative_score,'${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.cummulative_final_${init_process_id.process_id};


                INSERT INTO voting.cummulative_max_filter_score_audit
                (score_id, origin_id, paper_no, sor_item_name, cummulative_score, max_filter_score, root_pipeline_id, tenant_id, batch_id)
                SELECT score_id, origin_id, paper_no, sor_item_name, cummulative_score, max_filter_score,'${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.cummulative_max_filter_score_${init_process_id.process_id};


                INSERT INTO voting.voting_phase_2_result_audit
                (min_score_id, origin_id, paper_no, sor_item_name, weight_score, predicted_value, b_box, confidence_score, frequency, cummulative_score,root_pipeline_id,question_id,synonym_id, tenant_id, batch_id)
                SELECT min_score_id, origin_id, paper_no, sor_item_name, weight_score, predicted_value, b_box, confidence_score, frequency, cummulative_score,'${gen_id.root_pipeline_id}',question_id,synonym_id, ${tenant_id}, batch_id
                FROM ${temp_schema_name}.voting_phase_2_${init_process_id.process_id}_result;

                INSERT INTO sor_grouping.eoc_result_audit
                (pahub_id, origin_id, group_id, source_of_pahub, paper_no, created_on, status, stage, message, root_pipeline_id, tenant_id, batch_id)
                SELECT pahub_id, origin_id, group_id, source_of_pahub, paper_no, created_on, status, stage, message,'${gen_id.root_pipeline_id}', ${tenant_id}, batch_id
                FROM ${temp_schema_name}.eoc_result_${init_process_id.process_id};

                INSERT INTO voting.cumulative_patient_name_audit
                (patient_first_name_b_box, patient_last_name_b_box, patient_first_name_confidence_score, patient_last_name_confidence_score, patient_first_name, patient_last_name, patient_first_name_filter_score, patient_last_name_filter_score, group_id, patient_first_name_maximum_score, patient_last_name_maximum_score, origin_id, paper_no, root_pipeline_id, tenant_id, model_registry, batch_id)
                SELECT patient_first_name_b_box, patient_last_name_b_box, patient_first_name_confidence_score, patient_last_name_confidence_score, patient_first_name, patient_last_name, patient_first_name_filter_score, patient_last_name_filter_score, group_id, patient_first_name_maximum_score, patient_last_name_maximum_score, origin_id, paper_no, '${gen_id.root_pipeline_id}', tenant_id, model_registry, batch_id
                FROM ${temp_schema_name}.cumulative_patient_name_${init_process_id.process_id};

                INSERT INTO voting.cumulative_prescriber_name_audit
                (prescriber_first_name_b_box, prescriber_last_name_b_box, prescriber_first_name_confidence_score, prescriber_last_name_confidence_score, prescriber_first_name, prescriber_last_name, prescriber_first_name_filter_score, prescriber_last_name_filter_score, group_id, prescriber_first_name_maximum_score, prescriber_last_name_maximum_score, origin_id, paper_no, root_pipeline_id, tenant_id, batch_id)
                SELECT prescriber_first_name_b_box, prescriber_last_name_b_box, prescriber_first_name_confidence_score, prescriber_last_name_confidence_score, prescriber_first_name, prescriber_last_name, prescriber_first_name_filter_score, prescriber_last_name_filter_score, group_id, prescriber_first_name_maximum_score, prescriber_last_name_maximum_score, origin_id, paper_no, '${gen_id.root_pipeline_id}', tenant_id, batch_id
                FROM ${temp_schema_name}.cumulative_prescriber_name_${init_process_id.process_id};

                INSERT INTO voting.cumulative_provider_name_audit
                (provider_first_name_b_box, provider_last_name_b_box, provider_first_name_confidence_score, provider_last_name_confidence_score, provider_first_name, provider_last_name, provider_first_name_filter_score, provider_last_name_filter_score, group_id, provider_first_name_maximum_score, provider_last_name_maximum_score, origin_id, paper_no, root_pipeline_id, tenant_id, batch_id)
                SELECT provider_first_name_b_box, provider_last_name_b_box, provider_first_name_confidence_score, provider_last_name_confidence_score, provider_first_name, provider_last_name, provider_first_name_filter_score, provider_last_name_filter_score, group_id, provider_first_name_maximum_score, provider_last_name_maximum_score, origin_id, paper_no, '${gen_id.root_pipeline_id}', tenant_id, batch_id
                FROM ${temp_schema_name}.cumulative_provider_name_${init_process_id.process_id};

                INSERT INTO voting.cumulative_result_p2p_result_table_audit
                (b_box, confidence_score, extracted_value, filter_score, group_id, maximum_score, origin_id, paper_no, root_pipeline_id, sor_item_name, tenant_id, model_registry, batch_id)
                SELECT b_box, confidence_score, extracted_value, filter_score, group_id, maximum_score, origin_id, paper_no, '${gen_id.root_pipeline_id}', sor_item_name, tenant_id, model_registry, batch_id
                FROM ${temp_schema_name}.cumulative_result_p2p_result_table_${init_process_id.process_id};

                INSERT INTO voting.p2p_result_temp_table_audit
                (b_box, confidence_score, extracted_value, filter_score, group_id, maximum_score, origin_id, paper_no, root_pipeline_id, sor_item_name, tenant_id, synonym_id, question_id, model_registry, batch_id)
                select b_box, confidence_score, extracted_value, filter_score, group_id, maximum_score, origin_id, paper_no, '${gen_id.root_pipeline_id}', sor_item_name, tenant_id, synonym_id, question_id, model_registry, batch_id
                from ${temp_schema_name}.p2p_result_temp_table_${init_process_id.process_id};

        "} on-condition if "${eoc.splitting.main.activator}"=="true"

        transform as "insert into audit tables for voting precedence principle" on "intics_zio_db_conn" using
        {"

                INSERT INTO macro.temp_aggregation_evaluator_audit
                (created_on, created_user_id, last_updated_on, last_updated_user_id, tenant_id,
                aggregated_score, masked_score, group_id, origin_id, paper_no, predicted_value,
                vqa_score, rank, sor_item_attribution_id, sor_item_name, document_id,
                acc_transaction_id, b_box, root_pipeline_id, frequency, question_id,
                synonym_id, model_registry, status, version, acc_transcation_id,
                model_registry_id, batch_id, category)
                SELECT created_on, created_user_id, last_updated_on, last_updated_user_id, tenant_id,
                aggregated_score, masked_score, group_id, origin_id, paper_no, predicted_value,
                vqa_score, rank, sor_item_attribution_id, sor_item_name, document_id,
                acc_transaction_id, b_box, root_pipeline_id, frequency, question_id,
                synonym_id, model_registry, status, version, acc_transcation_id,
                model_registry_id, batch_id, category
                FROM ${temp_schema_name}.temp_aggregation_evaluator_${init_process_id.process_id};


                INSERT INTO macro.sor_item_name_counts_per_file_audit
                (tenant_id, batch_id, group_id, origin_id, sor_item_name, sor_item_count)
                SELECT
                tenant_id, batch_id, group_id, origin_id, sor_item_name, sor_item_count
                FROM
                ${temp_schema_name}.sor_item_name_counts_per_file_${init_process_id.process_id};


                INSERT INTO macro.final_cumulative_results_audit
                (tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_attribution_id, sor_item_name, question_id, synonym_id, b_box, predicted_value)
                SELECT
                tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_attribution_id, sor_item_name, question_id, synonym_id, b_box, predicted_value
                FROM ${temp_schema_name}.final_cumulative_results_${init_process_id.process_id};


                INSERT INTO macro.white_listed_entries_audit
                (tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_attribution_id, sor_item_name, question_id, synonym_id, b_box, predicted_value, whitelist_key)
                SELECT
                tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_attribution_id, sor_item_name, question_id, synonym_id, b_box, predicted_value, whitelist_key
                FROM ${temp_schema_name}.white_listed_entries_${init_process_id.process_id};

                INSERT INTO macro.multi_sor_items_to_evaluate_audit
                (tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_attribution_id, sor_item_name, question_id, synonym_id, b_box, predicted_value)
                SELECT tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_attribution_id, sor_item_name, question_id, synonym_id, b_box, predicted_value
                FROM ${temp_schema_name}.multi_sor_items_to_evaluate_${init_process_id.process_id};


                INSERT INTO macro.non_empty_predicted_values_audit
                (tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_attribution_id, sor_item_name, question_id, synonym_id, b_box, predicted_value)
                SELECT tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_attribution_id, sor_item_name, question_id, synonym_id, b_box, predicted_value
                FROM ${temp_schema_name}.non_empty_predicted_values_${init_process_id.process_id};


                INSERT INTO macro.predicted_value_occurrence_counts_audit
                (tenant_id, batch_id, group_id, origin_id, sor_item_name, predicted_value, predicted_value_count)
                SELECT tenant_id, batch_id, group_id, origin_id, sor_item_name, predicted_value, predicted_value_count
                FROM ${temp_schema_name}.predicted_value_occurrence_counts_${init_process_id.process_id};


                INSERT INTO macro.single_predicted_value_items_audit
                (tenant_id, batch_id, group_id, origin_id, sor_item_name)
                SELECT tenant_id, batch_id, group_id, origin_id, sor_item_name
                FROM ${temp_schema_name}.single_predicted_value_items_${init_process_id.process_id};


                INSERT INTO macro.tied_sor_items_audit
                (tenant_id, batch_id, group_id, origin_id, sor_item_name, sor_container_id, sor_container_name)
                SELECT tenant_id, batch_id, group_id, origin_id, sor_item_name, sor_container_id, sor_container_name
                FROM ${temp_schema_name}.tied_sor_items_${init_process_id.process_id};


                INSERT INTO macro.predicted_values_joined_audit
                (tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_name, predicted_value, sor_container_id, sor_container_name)
                SELECT tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_name, predicted_value, sor_container_id, sor_container_name
                FROM ${temp_schema_name}.predicted_values_joined_${init_process_id.process_id};


                INSERT INTO macro.predicted_value_global_counts_audit
                (tenant_id, batch_id, group_id, origin_id, paper_no, predicted_value_count)
                SELECT tenant_id, batch_id, group_id, origin_id, paper_no, predicted_value_count
                FROM ${temp_schema_name}.predicted_value_global_counts_${init_process_id.process_id};


                INSERT INTO macro.most_common_sor_items_in_ties_audit
                (tenant_id, batch_id, group_id, origin_id, paper_no, sor_container_id, sor_container_name)
                SELECT tenant_id, batch_id, group_id, origin_id, paper_no, sor_container_id, sor_container_name
                FROM ${temp_schema_name}.most_common_sor_items_in_ties_${init_process_id.process_id};


                INSERT INTO macro.remaining_tied_candidates_audit
                (tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_attribution_id, sor_item_name, question_id, synonym_id, b_box, predicted_value)
                SELECT tenant_id, batch_id, group_id, origin_id, root_pipeline_id, paper_no, sor_item_attribution_id, sor_item_name, question_id, synonym_id, b_box, predicted_value
                FROM ${temp_schema_name}.remaining_tied_candidates_${init_process_id.process_id};


                INSERT INTO macro.tie_break_by_min_paper_no_audit
                (tenant_id, batch_id, group_id, origin_id, sor_item_name)
                SELECT tenant_id, batch_id, group_id, origin_id, sor_item_name
                FROM ${temp_schema_name}.tie_break_by_min_paper_no_${init_process_id.process_id};

                -- Audit insert for empty_predicted_min_paper
                INSERT INTO macro.empty_predicted_min_paper_audit
                (tenant_id, batch_id, group_id, sor_item_name, origin_id, min_paper_no)
                SELECT
                tenant_id,
                batch_id,
                group_id,
                sor_item_name,
                origin_id,
                min_paper_no
                FROM ${temp_schema_name}.empty_predicted_min_paper_${init_process_id.process_id};

                -- Audit insert for non_empty_min_paper
                INSERT INTO macro.non_empty_min_paper_audit
                (tenant_id, batch_id, group_id, sor_item_name, origin_id, min_paper_no)
                SELECT
                tenant_id,
                batch_id,
                group_id,
                sor_item_name,
                origin_id,
                min_paper_no
                FROM ${temp_schema_name}.non_empty_min_paper_${init_process_id.process_id};

                -- Audit insert for min_final_cumulative_papers
                INSERT INTO macro.min_final_cumulative_papers_audit
                (tenant_id, batch_id, group_id, origin_id, sor_item_name, min_paper_no)
                SELECT
                tenant_id,
                batch_id,
                group_id,
                origin_id,
                sor_item_name,
                min_paper_no
                FROM ${temp_schema_name}.min_final_cumulative_papers_${init_process_id.process_id};


        "} on-condition if "${eoc.splitting.main.activator}"=="true"



        transform as "Drop audit tables for voting precedence principle" on "intics_zio_db_conn" using {"

                DROP TABLE IF EXISTS ${temp_schema_name}.temp_aggregation_evaluator_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.sor_item_name_counts_per_file_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.final_cumulative_results_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.multi_sor_items_to_evaluate_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.non_empty_predicted_values_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.predicted_value_occurrence_counts_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.single_predicted_value_items_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.tied_sor_items_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.predicted_values_joined_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.predicted_value_global_counts_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.most_common_sor_items_in_ties_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.remaining_tied_candidates_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.tie_break_by_min_paper_no_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.empty_predicted_min_paper_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.non_empty_min_paper_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.min_final_cumulative_papers_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.white_listed_entries_${init_process_id.process_id};

        "} on-condition if "${eoc.splitting.main.activator}"=="true"

        transform as "drop temporary table for the pipeline execution audit" on "intics_zio_db_conn"
        using {"
                DROP TABLE IF EXISTS ${temp_schema_name}.process_failed_status_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.summary_audit_files_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.summary_audit_papers_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.temp_error_document_detail_${init_process_id.process_id};
        "}on-condition if "true"=="true"

        transform as "move temporary tables to main audit tables  in qr extraction" on "intics_zio_db_conn" using
        {"

                DROP TABLE IF EXISTS ${temp_schema_name}.qr_candidate_result_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.qr_extraction_result_${init_process_id.process_id};

        "} on-condition if "${qr.extraction.processor.activator}"=="true"


        transform as "Drop temporary tables for preprocess with process_id ${init_process_id.process_id}" on "intics_zio_db_conn" using
        {"
                DROP TABLE IF EXISTS ${temp_schema_name}.sanitizer_summary_truth_audit_${init_process_id.process_id};

                DROP TABLE IF EXISTS ${temp_schema_name}.b_template_response_group_${init_process_id.process_id} CASCADE;

                DROP TABLE IF EXISTS ${temp_schema_name}.c_template_max_occurance_${init_process_id.process_id} CASCADE;

                DROP TABLE IF EXISTS ${temp_schema_name}.d_template_name_match_${init_process_id.process_id} CASCADE;

                DROP TABLE IF EXISTS ${temp_schema_name}.e_template_name_fuzzy_match_${init_process_id.process_id} CASCADE;

                DROP TABLE IF EXISTS ${temp_schema_name}.f_template_name_max_fuzzy_match_${init_process_id.process_id} CASCADE;

                DROP TABLE IF EXISTS ${temp_schema_name}.g_final_template_match_${init_process_id.process_id} CASCADE;

                DROP TABLE IF EXISTS ${temp_schema_name}.template_detection_result_${init_process_id.process_id} CASCADE;

                DROP TABLE IF EXISTS ${temp_schema_name}.a_template_detection_response_${init_process_id.process_id} CASCADE;

                DROP TABLE IF EXISTS ${temp_schema_name}.final_template_match_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.file_details_truth_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.source_of_truth_${init_process_id.process_id};

                DROP TABLE IF EXISTS ${temp_schema_name}.paper_itemizer_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.auto_rotation_${init_process_id.process_id};
                DROP TABLE IF EXISTS ${temp_schema_name}.data_extraction_${init_process_id.process_id};

        "} on-condition if "${preprocess.main.caller.activator}"=="true"


