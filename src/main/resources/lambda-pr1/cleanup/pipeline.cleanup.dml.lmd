                select answer, paper_no, origin_id, group_id, tenant_id, root_pipeline_id, batch_id, model_registry, created_on, created_user_id, last_updated_on, last_updated_user_id, sor_container_name, extracted_image_unit, confidence, bbox, bbox_asis, is_label_matching, label_match_message, sor_container_id, sor_item_name, section_alias, sor_item_label, image_dpi, image_width, image_height, blacklisted_labels, blacklisted_sections, is_encrypted, encryption_policy, whitelisted_labels
