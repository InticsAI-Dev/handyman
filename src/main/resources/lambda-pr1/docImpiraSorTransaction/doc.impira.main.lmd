process "doc.impira.main"
{
    try{
        assign as "time_stamp_impira_transaction" source "intics_zio_db_conn" using
        {"
            SELECT now() as consumed_on_ts;
        "} on-condition if "true"=="true"

        callprocess as "calling impira transaction processor "
        with-target "doc.impira.processor"
        from-file "${basepath}/docImpiraSorTransaction/doc.impira.processor.lmd"
        using "intics_zio_db_conn"
        for-every {"
            SELECT DISTINCT group_id
            FROM doc_impira.doc_impira_payload_queue
            WHERE status='STAGED' and tenant_id = ${tenant_id} and group_id = '${gen_group_id.group_id}';
        "} on-condition if "true"=="true"

    }
    catch{
        transform as "update to failed in impira transaction audit" on "intics_zio_db_conn" using
        {"
            INSERT INTO doc_impira.doc_impira_pipeline_audit
            (group_id, created_on, created_by, user_id, tenant_id, status, stage, message)
            VALUES('${gen_group_id.group_id}', now(), '${created_user_id}', '${created_user_id}', ${tenant_id}, 'FAILED', 'MAIN_IMPIRA_TRANSACTION', 'Impira transaction failed in main caller with group_id ${gen_group_id.group_id}');
        "} on-condition if "true"=="true"

    }
    finally{
    }
}