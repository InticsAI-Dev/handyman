                 CREATE TABLE IF NOT EXISTS ${temp_schema_name}.nextgen_sor_transaction_chrono_clash_input_${init_process_id.process_id} (
                     root_pipeline_id int8 NOT NULL,
                     created_on timestamp NULL,
                     updated_on timestamp NULL,
                     batch_id varchar NOT NULL,
                     group_id int4 NULL,
                     origin_id varchar NOT NULL,
                     tenant_id int8 NOT NULL,
                     time_frame int4 NULL,
                     stage varchar NULL,
                     status varchar NULL,
                     transaction_id varchar NOT NULL,
                     downloaded_time timestamp NULL,
                     remaining_time interval NULL,
                     CONSTRAINT nextgen_sor_transaction_chrono_clash_input_${init_process_id.process_id}_pk PRIMARY KEY (origin_id,tenant_id,root_pipeline_id,transaction_id)
                 );

            "}on-condition if "true"=="true"


            transform as "DDL FOR dynamic_prompt_gen" on "intics_zio_db_conn" using
            {"
                    create schema if not exists dynamic_prompt_gen;

                    create table if not exists dynamic_prompt_gen.questionverse_summary(
                        summary_id bigserial not null,
                        created_at timestamp null,
                        total_document_type_count int8 null,
                        total_container_count int8 null,
                        total_field_count int8 null,
                        total_channel_count  int8 null,
                        total_sip_count int8 null,
                        total_filter_count int8 null,
                        total_synonym_count int8 null,
                        total_question_count int8 null,
