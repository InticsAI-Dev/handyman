                    CREATE TABLE IF NOT EXISTS ${temp_schema_name}.vqa_missing_meta_keys_${init_process_id.process_id} (
                        id bigserial not null,
                        question_id int8 NULL,
                        synonym_id int8 NULL,
                        sor_item_name varchar NULL,
