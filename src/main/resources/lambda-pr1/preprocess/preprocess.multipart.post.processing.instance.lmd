process "preprocess.multipart.post.processing"
{
    try{
        transform as "insert into audit in preprocess payload queue" on "intics_zio_db_conn" using
        {"

            INSERT INTO preprocess.preprocess_pipeline_audit
            (process_id, origin_id,group_id, created_on, status, stage, message,root_pipeline_id, tenant_id, batch_id)
            SELECT  a.producer_process_id,a.origin_id, a.group_id,now(), 'STARTED','PREPROCESS','preprocess multipart file upload for post processing ${group_id}','${gen_id.root_pipeline_id}', ${tenant_id}, a.batch_id
            FROM preprocess.preprocess_payload_queue a
            WHERE a.status='IN_PROGRESS' and a.group_id='${group_id}' and a.tenant_id = ${tenant_id} and a.batch_id='${batch_id}';

        "}  on-condition if "true"=="true"

        assign as "multipart_url_gen" source "intics_zio_db_conn" using {"
                SELECT concat('${multipart_upload_base_url}','multipart-upload') as upload_url;
        "} on-condition if "true"=="true"

        multipartUpload as "multipart file upload to cluster name ${cluster_name} and machine name ${machine_name}"
        resource-conn "intics_zio_db_conn"
        upload-url "${multipart_url_gen.upload_url}"
        using {"
            SELECT ar.processed_file_path as file_path, ar.template_id as template_id,
            ar.origin_id as origin_id, ar.paper_no as paper_no, ar.group_id as group_id,
            ar.tenant_id as tenant_id, ar.process_id as process_id,
            ar.root_pipeline_id as root_pipeline_id, ar.batch_id
            FROM ${temp_schema_name}.auto_rotation_${init_process_id.process_id} ar
            WHERE ar.status ='COMPLETED' AND ar.group_id='${group_id}' AND ar.tenant_id=${tenant_id} and ar.batch_id='${batch_id}';
        "} on-condition if "true"=="true"


        transform as "insert into pipeline audit completed" on "intics_zio_db_conn" using
        {"

            INSERT INTO preprocess.preprocess_pipeline_audit
            (process_id, origin_id,group_id, created_on, status, stage, message,root_pipeline_id, tenant_id, batch_id)
            SELECT  a.producer_process_id,a.origin_id, a.group_id,now(), 'COMPLETED','PREPROCESS','preprocess multipart file upload for post processing ${group_id}','${gen_id.root_pipeline_id}', ${tenant_id}, a.batch_id
            FROM preprocess.preprocess_payload_queue a
            WHERE a.status='IN_PROGRESS' and a.group_id='${group_id}' and a.tenant_id = ${tenant_id} and a.batch_id='${batch_id}';

        "}  on-condition if "true"=="true"
        }
        catch{

    }
    finally{

    }

}