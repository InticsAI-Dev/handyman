            using  {
            }  on-condition if "${triton.ut.unload.activator}"=="true"


            tritonModelLoadUnload as "triton unload for argon vqa"
            resource-conn "intics_zio_db_conn"
            model-url "${triton.argon.vqa.unload.url}"
            config-variable "ARGON_CONFIG_JSON"
            load-type "unload"
            using  {
            }  on-condition if "${triton.argon.vqa.unload.activator}"=="true"


            tritonModelLoadUnload as "triton unload for xenon vqa"
            resource-conn "intics_zio_db_conn"
            model-url "${triton.xenon.vqa.unload.url}"
            config-variable "XENON_CONFIG_JSON"
