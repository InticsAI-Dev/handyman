process "triton.unload.main.caller"
{
     try{

            tritonModelLoadUnload as "triton unload for paper itemizer"
            resource-conn "intics_zio_db_conn"
            model-url "${triton.paper.iterator.unload.url}"
            config-variable "PAPER_ITERATOR_CONFIG_JSON"
            load-type "unload"
            using  {
            }  on-condition if "${triton.paper.iterator.unload.activator}"=="true"


            tritonModelLoadUnload as "triton unload for auto rotator"
            resource-conn "intics_zio_db_conn"
            model-url "${triton.auto.rotator.unload.url}"
            config-variable "PAPER_ITERATOR_CONFIG_JSON"
