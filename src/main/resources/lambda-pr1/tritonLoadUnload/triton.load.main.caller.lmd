            tritonModelLoadUnload as "triton unload for template detection"
            resource-conn "intics_zio_db_conn"
            model-url "${triton.template.detection.load.url}"
            config-variable "TEMPLATE_DETECTION_CONFIG_JSON"
            load-type "load"
            using  {
            }  on-condition if "${triton.template.detection.load.activator}"=="true"


     }

    catch{
    }
    finally{
    }


}