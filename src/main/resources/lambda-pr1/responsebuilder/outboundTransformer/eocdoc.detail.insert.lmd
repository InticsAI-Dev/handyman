                select a.eoc_identifier ,a.origin_id,b.paper_no ,b.values,a.document_id,b.confidence_score,b.b_box,b.value_type, '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                from eoc_response.prescriber_detail  a
                join eoc_response.eoc_trans  b
                on a.origin_id =b.origin_id and a.eoc_identifier =b.eoc_identifier
                and b.sor_item_name='prescriber_fax'
                where a.origin_id  = '${origin_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';

                insert into eoc_response.prescriber_city
                (eoc_identifier,origin_id,page_number,value,document_id,confidence_score,bounding_box,value_type, root_pipeline_id, tenant_id,
                created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
                select a.eoc_identifier ,a.origin_id,b.paper_no ,b.values,a.document_id,b.confidence_score,b.b_box,b.value_type, '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                from eoc_response.prescriber_detail  a
                join eoc_response.eoc_trans  b
                on a.origin_id =b.origin_id and a.eoc_identifier =b.eoc_identifier
                and b.sor_item_name='prescriber_city'
                where a.origin_id  = '${origin_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';


                insert into eoc_response.prescriber_address
                (eoc_identifier,origin_id,page_number,value,document_id,confidence_score,bounding_box,value_type,root_pipeline_id, tenant_id,
                created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
                select a.eoc_identifier ,a.origin_id,b.paper_no ,b.values,a.document_id,b.confidence_score,b.b_box,b.value_type, '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                from eoc_response.prescriber_detail  a
                join eoc_response.eoc_trans b
                on a.origin_id =b.origin_id and a.eoc_identifier =b.eoc_identifier
                and b.sor_item_name='prescriber_address'
                where a.origin_id  = '${origin_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';

                insert into eoc_response.provider_name
                (eoc_identifier,origin_id,page_number,value,document_id,confidence_score,bounding_box,value_type,root_pipeline_id, tenant_id,
                created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
                select a.eoc_identifier ,a.origin_id,b.paper_no ,b.values,a.document_id,b.confidence_score,b.b_box,b.value_type, '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                from eoc_response.provider_detail  a
                join eoc_response.eoc_trans  b
                on a.origin_id =b.origin_id and a.eoc_identifier =b.eoc_identifier
                and b.sor_item_name='provider_name'
                where a.origin_id  = '${origin_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';

                insert into eoc_response.provider_address
                 (eoc_identifier,origin_id,page_number,value,document_id,confidence_score,bounding_box,value_type, root_pipeline_id,tenant_id,
                 created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
                select a.eoc_identifier ,a.origin_id,b.paper_no ,b.values,a.document_id,b.confidence_score,b.b_box,b.value_type, '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                from eoc_response.provider_detail  a
                join eoc_response.eoc_trans  b
                on a.origin_id =b.origin_id and a.eoc_identifier =b.eoc_identifier
                and b.sor_item_name='provider_address'
                where a.origin_id  = '${origin_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';

                insert into eoc_response.provider_zipcode
                 (eoc_identifier,origin_id,page_number,value,document_id,confidence_score,bounding_box,value_type,root_pipeline_id, tenant_id,
                 created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
                select a.eoc_identifier ,a.origin_id,b.paper_no ,b.values,a.document_id,b.confidence_score,b.b_box,b.value_type, '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                from eoc_response.provider_detail  a
                join eoc_response.eoc_trans  b
                on a.origin_id =b.origin_id and a.eoc_identifier =b.eoc_identifier
                and b.sor_item_name='provider_zip'
                where a.origin_id = '${origin_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';


                insert into eoc_response.provider_city
                 (eoc_identifier,origin_id,page_number,value,document_id,confidence_score,bounding_box,value_type,root_pipeline_id, tenant_id,
                 created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
                select a.eoc_identifier ,a.origin_id,b.paper_no ,b.values,a.document_id,b.confidence_score,b.b_box,b.value_type, '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                from eoc_response.provider_detail  a
                join eoc_response.eoc_trans  b
                on a.origin_id =b.origin_id and a.eoc_identifier =b.eoc_identifier
                and b.sor_item_name='provider_city'
                where a.origin_id  = '${origin_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';


                insert into eoc_response.provider_phone
                 (eoc_identifier,origin_id,page_number,value,document_id,confidence_score,bounding_box,value_type,root_pipeline_id, tenant_id,
                 created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
                select a.eoc_identifier ,a.origin_id,b.paper_no ,b.values,a.document_id,b.confidence_score,b.b_box,b.value_type, '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                from eoc_response.provider_detail  a
                join eoc_response.eoc_trans  b
                on a.origin_id =b.origin_id and a.eoc_identifier =b.eoc_identifier
                and b.sor_item_name='provider_phone'
                where a.origin_id  = '${origin_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';

                insert into eoc_response.provider_npi
                 (eoc_identifier,origin_id,page_number,value,document_id,confidence_score,bounding_box,value_type, root_pipeline_id, tenant_id,
                 created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
                select a.eoc_identifier ,a.origin_id,b.paper_no ,b.values,a.document_id,b.confidence_score,b.b_box,b.value_type, '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                from eoc_response.provider_detail  a
                join eoc_response.eoc_trans  b
                on a.origin_id =b.origin_id and a.eoc_identifier =b.eoc_identifier
                and b.sor_item_name='provider_npi'
                where a.origin_id  = '${origin_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';

                insert into eoc_response.provider_fax
                 (eoc_identifier,origin_id,page_number,value,document_id,confidence_score,bounding_box,value_type, root_pipeline_id, tenant_id,
                 created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id )
                select a.eoc_identifier ,a.origin_id,b.paper_no ,b.values,a.document_id,b.confidence_score,b.b_box,b.value_type, '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                from eoc_response.provider_detail  a
                join eoc_response.eoc_trans  b
                on a.origin_id =b.origin_id and a.eoc_identifier =b.eoc_identifier
                and b.sor_item_name='provider_fax'
                where a.origin_id  = '${origin_id}' and a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';



        "}  on-condition if "${master.data.outboundZip}"=="false"

        transform as "insert into barcode details" on "intics_zio_db_conn" using {"
            INSERT INTO eoc_response.bar_code_details
            (bounding_box, confidence_score, document_id, eoc_identifier, origin_id, page_number, value, value_type, root_pipeline_id, tenant_id,
            created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
            select a.b_box::json , a.confidence_score , b.document_id,b.eoc_identifier,a.origin_id,a.paper_no,a.extracted_value,a.qr_format,  '${gen_id.root_pipeline_id}', ${tenant_id},
            '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
            FROM qr_extraction.qr_extraction_details_bbox_info a
            join eoc_response.eoc_extraction b on a.origin_id=b.origin_id and a.paper_no=b.paper_no and a.origin_id='${origin_id}' and a.is_candidate_qr='YES';

         "} on-condition if "true"=="true"

          transform as "insert image dpi details" on "intics_zio_db_conn" using {"
                INSERT INTO eoc_response.image_dpi_information
                 (process_id, group_id, root_pipeline_id, created_on, origin_id, paper_no, image_dpi, image_width, image_height,extracted_image_unit, tenant_id, batch_id)
                 select '${process-id}',group_id,'${root-ref-id}',now(), origin_id, paper_no, image_dpi, image_width, image_height,extracted_image_unit, ${tenant_id}, '${batch_id}'
                 from sor_transaction.vqa_transaction
                 where origin_id='${origin_id}' and tenant_id = ${tenant_id} and batch_id = '${batch_id}'
                 group by origin_id,paper_no,image_dpi,image_width,image_height,group_id,extracted_image_unit;

				INSERT into eoc_response.bounding_box_details
                (origin_id, eoc_identifier, document_id, image_dpi, image_width,
                image_height, extracted_image_unit, root_pipeline_id, tenant_id, created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
                SELECT b.origin_id, b.eoc_identifier, b.document_id, a.image_dpi, a.image_width,
                a.image_height, a.extracted_image_unit,  '${gen_id.root_pipeline_id}', ${tenant_id},
                '${created_on}', '${created_user_id}', '${created_on}', ${created_user_id}, 'ACTIVE', 1, a.batch_id
                FROM eoc_response.image_dpi_information a
                join eoc_response.eoc_extraction b on a.origin_id='${origin_id}' and b.origin_id='${origin_id}'
                group by b.origin_id, b.eoc_identifier, b.document_id, a.image_dpi, a.image_width, a.image_height, a.extracted_image_unit, a.batch_id limit 1;
             "} on-condition if "true"=="true"

        transform as "insert for noise detection details" on "intics_zio_db_conn" using {"

            INSERT INTO eoc_response.noise_model_details
            (created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, tenant_id,
            origin_id, root_pipeline_id, document_id, eoc_identifier, class_value, confidence_score, batch_id)
            SELECT '${created_on}', ${created_user_id}, '${created_on}', ${created_user_id}, 'ACTIVE', 1, ${tenant_id},
            a.origin_id, a.root_pipeline_id, b.document_id, b.eoc_identifier, a.consolidated_class, max(a.consolidated_confidence_score), a.batch_id
            FROM noise_model.noise_model_output_table a
            JOIN eoc_response.eoc_extraction b ON a.origin_id = b.origin_id
            WHERE a.origin_id ='${origin_id}' and a.tenant_id = ${tenant_id} and a.consolidated_class = 'NOISY' and a.batch_id = '${batch_id}'
            group by a.origin_id, a.root_pipeline_id, b.document_id, b.eoc_identifier, a.consolidated_class, a.batch_id;

        "} on-condition if "true"=="true"

        transform as "insert for urgency triage" on "intics_zio_db_conn" using {"
            INSERT INTO eoc_response.urgency_details
            (origin_id, page_number, document_id, value, bounding_box, value_type, confidence_score, eoc_identifier, root_pipeline_id, tenant_id,
            created_on, created_user_id, last_updated_on, last_updated_user_id, status, version, batch_id)
            SELECT
                a.origin_id,
                a.paper_no,
                b.document_id,
                a.paper_type,
                CAST(a.bboxes AS JSON),
                a.document_type,
                CAST(a.confidence_score AS INT8),
                b.eoc_identifier,
                '${gen_id.root_pipeline_id}',
                ${tenant_id},
                '${created_on}',
                '${created_user_id}',
                '${created_on}',
                ${created_user_id},
                'ACTIVE',
                1,
                a.batch_id
            FROM
                urgency_triage.ut_model_result_bbox_info a
            JOIN
                eoc_response.eoc_extraction b
            ON
                a.origin_id = b.origin_id
                AND a.paper_no = b.paper_no
            WHERE
                a.origin_id = '${origin_id}'
                AND a.paper_type IN ('URGENT', 'UNABLE TO IDENTIFY', 'NON_URGENT')
                AND a.tenant_id = ${tenant_id} and a.batch_id = '${batch_id}';
        "} on-condition if "true"=="true"

        transform as "insert into eoc transform audit completed" on "intics_zio_db_conn" using
        {"
            INSERT INTO eoc_transformer.eoc_transformer_pipeline_audit
            (process_id,origin_id, created_on, group_id, status, stage, message, root_pipeline_id, tenant_id, batch_id)
            VALUES( '${init_process_id.process_id}','${origin_id}', now(), '${group_id}',  'COMPLETED',
            'EOC_TRANSFORM', 'eoc transform detail insert completed for origin id ${origin_id}',  '${gen_id.root_pipeline_id}', ${tenant_id}, '${batch_id}');

            UPDATE  eoc_transformer.eoc_transformer_payload_queue
            SET consumer_process_id='${init_process_id.process_id}', status='COMPLETED'
            WHERE origin_id='${origin_id}' AND status='IN_PROGRESS' and tenant_id = ${tenant_id} and batch_id = '${batch_id}';

                UPDATE batching.sub_batching_process_payload_queue a
                SET status='COMPLETED',  stage='EOC_TRANSFORM'
                WHERE a.group_id='${group_id}'  and a.tenant_id='${tenant_id}'
                and a.batch_id ='${batch_id}';

        "} on-condition if "true"=="true"


}

    catch {
        transform as "insert into eoc transform audit failed" on "intics_zio_db_conn" using
		{"
			INSERT INTO eoc_transformer.eoc_transformer_pipeline_audit
			(process_id,origin_id, created_on, group_id,  status, stage, message, root_pipeline_id, tenant_id, batch_id)
			VALUES( '${init_process_id.process_id}','${origin_id}', now(), '${group_id}',  'FAILED', 'EOC_TRANSFORM',
			'eoc transform detail insert failed for origin id ${origin_id}', '${gen_id.root_pipeline_id}', ${tenant_id}, '${batch_id}');

			UPDATE  eoc_transformer.eoc_transformer_payload_queue
			SET consumer_process_id='${init_process_id.process_id}', status='FAILED'
			WHERE origin_id='${origin_id}' AND status='IN_PROGRESS' and tenant_id = ${tenant_id} and batch_id = '${batch_id}';

		"}  on-condition if "true"=="true"
    }

    finally {


        transform as "insert into eoc transform audit failed" on "intics_zio_db_conn" using
        {"
        UPDATE  eoc_transformer.eoc_transformer_payload_queue
        SET consumer_process_id='${init_process_id.process_id}', status='FAILED'
        WHERE origin_id='${origin_id}' AND status='IN_PROGRESS' and tenant_id = ${tenant_id} and batch_id = '${batch_id}';
        "}  on-condition if "true"=="true"}

    }

   }