        LEFT JOIN ${COVERAGE_REPORT}.auth_discharge_date_result k ON a.docid = k.file_name and k.root_pipeline_id=${root_pipeline_id}
        LEFT JOIN ${COVERAGE_REPORT}.auth_discharge_disposition_result l ON a.docid = l.file_name and l.root_pipeline_id=${root_pipeline_id}
        LEFT JOIN ${COVERAGE_REPORT}.auth_id_result m ON a.docid = m.file_name and m.root_pipeline_id=${root_pipeline_id}
        LEFT JOIN ${COVERAGE_REPORT}.level_of_care_result n ON a.docid = n.file_name and n.root_pipeline_id=${root_pipeline_id}
        LEFT JOIN ${COVERAGE_REPORT}.notification_type_result o ON a.docid = o.file_name and o.root_pipeline_id=${root_pipeline_id}
        WHERE a.docid ='${doc_id}'  AND (
        b.file_name IS NOT NULL OR
        c.file_name IS NOT NULL OR
        d.file_name IS NOT NULL OR
        e.file_name IS NOT NULL OR
        f.file_name IS NOT NULL OR
        g.file_name IS NOT NULL OR
        h.file_name IS NOT NULL OR
        i.file_name IS NOT NULL OR
        j.file_name IS NOT NULL OR
        k.file_name IS NOT NULL OR
        l.file_name IS NOT NULL OR
        o.file_name IS NOT NULL OR
        m.file_name IS NOT NULL OR
        n.file_name IS NOT NULL)
  "} on-condition if "true"=="true"



        transform as "insert into the consolidated for additional_auth_properties" on "intics_zio_db_conn" using
        {"
        create table ${temp_schema_name}.a_additional_auth_details_result_audit_${init_process_id.process_id} as
        SELECT
            ${root_pipeline_id} as root_pipeline_id,
            ${tenant_id} as tenant_id,
            now() as created_on,
            '${origin_id}' as origin_id,
            '${file_name}' as file_name,
            a.docid,

            b.actual_value AS additional_auth_properties_actual_value,
            b.extracted_value AS additional_auth_properties_extracted_value,
            b.match_status AS additional_auth_properties_match_status,
            b.mismatch_count AS additional_auth_properties_mismatch_count,
            b.classification AS additional_auth_properties_classification

        FROM ${coverage.report.input.data.table} a
        LEFT JOIN ${COVERAGE_REPORT}.additional_auth_properties_result b
            ON a.docid = b.file_name
            AND b.root_pipeline_id = ${root_pipeline_id}
        WHERE a.docid = '${doc_id}'
          AND b.file_name IS NOT NULL;

  "} on-condition if "true"=="true"


 transform as "insert into the consolidated for responsible area" on "intics_zio_db_conn" using
        {"
        create table ${temp_schema_name}.a_responsible_area_result_${init_process_id.process_id} as
        SELECT
            ${root_pipeline_id} as root_pipeline_id,
            ${tenant_id} as tenant_id,
            now() as created_on,
            '${origin_id}' as origin_id,
            '${file_name}' as file_name,
            a.docid,

            b.actual_value AS responsible_area_actual_value,
            b.extracted_value AS responsible_area_extracted_value,
            b.match_status AS responsible_area_match_status,
            b.mismatch_count AS responsible_area_mismatch_count,
            b.classification AS responsible_area_classification

        FROM ${coverage.report.input.data.table} a
        LEFT JOIN ${COVERAGE_REPORT}.responsible_area_result b
            ON a.docid = b.file_name
            AND b.root_pipeline_id = ${root_pipeline_id}
        WHERE a.docid = '${doc_id}'
          AND b.file_name IS NOT NULL;

  "} on-condition if "true"=="true"


