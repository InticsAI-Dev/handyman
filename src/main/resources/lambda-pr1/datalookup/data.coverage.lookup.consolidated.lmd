            auth_id_mismatch_count int8 NULL,
            auth_id_classification varchar NULL,
            level_of_care_actual_value varchar NULL,
            level_of_care_extracted_value text NULL,
            level_of_care_match_status varchar NULL,
            level_of_care_mismatch_count int8 NULL,
            level_of_care_classification varchar NULL,
            notification_type_actual_value varchar NULL,
