process "data.coverage.lookup.consolidated"
{
try{

        transform as "create input and result tables for the control data pipeline" on "intics_zio_db_conn" using {"

               CREATE TABLE IF NOT EXISTS ${COVERAGE_REPORT}.a_member_details_result_audit (
