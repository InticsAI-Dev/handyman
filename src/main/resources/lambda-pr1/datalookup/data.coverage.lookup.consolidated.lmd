             servicing_provider_address_line1_actual_value, servicing_provider_address_line1_extracted_value, servicing_provider_address_line1_match_status, servicing_provider_address_line1_mismatch_count, servicing_provider_address_line1_classification,
             servicing_provider_address_line2_actual_value, servicing_provider_address_line2_extracted_value, servicing_provider_address_line2_match_status, servicing_provider_address_line2_mismatch_count, servicing_provider_address_line2_classification,
             servicing_provider_first_name_actual_value, servicing_provider_first_name_extracted_value, servicing_provider_first_name_match_status, servicing_provider_first_name_mismatch_count, servicing_provider_first_name_classification,
             servicing_provider_last_name_actual_value, servicing_provider_last_name_extracted_value, servicing_provider_last_name_match_status, servicing_provider_last_name_mismatch_count, servicing_provider_last_name_classification,
             servicing_provider_npi_actual_value, servicing_provider_npi_extracted_value, servicing_provider_npi_match_status, servicing_provider_npi_mismatch_count, servicing_provider_npi_classification,
             servicing_provider_state_actual_value, servicing_provider_state_extracted_value, servicing_provider_state_match_status, servicing_provider_state_mismatch_count, servicing_provider_state_classification,
             servicing_provider_city_actual_value, servicing_provider_city_extracted_value, servicing_provider_city_match_status, servicing_provider_city_mismatch_count, servicing_provider_city_classification,
             servicing_provider_zipcode_actual_value, servicing_provider_zipcode_extracted_value, servicing_provider_zipcode_match_status, servicing_provider_zipcode_mismatch_count, servicing_provider_zipcode_classification,
             servicing_provider_specialty_actual_value, servicing_provider_specialty_extracted_value, servicing_provider_specialty_match_status, servicing_provider_specialty_mismatch_count, servicing_provider_specialty_classification,
             servicing_provider_tin_actual_value, servicing_provider_tin_extracted_value, servicing_provider_tin_match_status, servicing_provider_tin_mismatch_count, servicing_provider_tin_classification,
             servicing_provider_full_name_actual_value, servicing_provider_full_name_extracted_value, servicing_provider_full_name_match_status, servicing_provider_full_name_mismatch_count, servicing_provider_full_name_classification
         FROM ${temp_schema_name}.a_servicing_provider_details_result_${init_process_id.process_id}
         WHERE docid='${doc_id}';

INSERT INTO ${COVERAGE_REPORT}.a_additional_auth_details_result_audit (
        root_pipeline_id, tenant_id, created_on, origin_id, file_name, docid,
        additional_auth_properties_actual_value, additional_auth_properties_extracted_value, additional_auth_properties_match_status,
        additional_auth_properties_mismatch_count, additional_auth_properties_classification
    )
    SELECT
        ${init_process_id.process_id}, ${tenant_id}, created_on, origin_id, file_name, docid,
        additional_auth_properties_actual_value, additional_auth_properties_extracted_value, additional_auth_properties_match_status,
        additional_auth_properties_mismatch_count, additional_auth_properties_classification
    FROM ${temp_schema_name}.a_additional_auth_details_result_audit_${init_process_id.process_id}
    WHERE docid = '${doc_id}';

    INSERT INTO ${COVERAGE_REPORT}.a_responsible_area_details_result_audit (
            root_pipeline_id, tenant_id, created_on, origin_id, file_name, docid,
            responsible_area_actual_value, responsible_area_extracted_value, responsible_area_match_status,
            responsible_area_mismatch_count, responsible_area_classification
        )
        SELECT
            ${init_process_id.process_id}, ${tenant_id}, created_on, origin_id, file_name, docid,
            responsible_area_actual_value, responsible_area_extracted_value, responsible_area_match_status,
            responsible_area_mismatch_count, responsible_area_classification
        FROM ${temp_schema_name}.a_responsible_area_result_${init_process_id.process_id}
        WHERE docid = '${doc_id}';
     "} on-condition if "true"=="true"

catch{

}
finally {
    transform as "Drop all the temporary tables created for all containers" on "intics_zio_db_conn" using
        {"
            DROP TABLE IF EXISTS ${temp_schema_name}.a_member_details_result_${init_process_id.process_id};
            DROP TABLE IF EXISTS ${temp_schema_name}.a_referring_provider_details_result_${init_process_id.process_id};
            DROP TABLE IF EXISTS ${temp_schema_name}.a_requested_service_details_result_${init_process_id.process_id};
            DROP TABLE IF EXISTS ${temp_schema_name}.a_servicing_facility_details_result_${init_process_id.process_id};
            DROP TABLE IF EXISTS ${temp_schema_name}.a_servicing_provider_details_result_${init_process_id.process_id};
            DROP TABLE IF EXISTS ${temp_schema_name}.a_additional_auth_details_result_audit_${init_process_id.process_id};
            DROP TABLE IF EXISTS ${temp_schema_name}.a_responsible_area_result_${init_process_id.process_id};
        "} on-condition if "true"=="true"
}
}