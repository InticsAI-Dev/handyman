        CREATE TABLE IF NOT EXISTS ${COVERAGE_REPORT}.a_additional_auth_details_result_audit(
            id bigserial NOT null,
            root_pipeline_id int8 null,
            tenant_id int8 null,
            created_on timestamp null,
            origin_id varchar null,
            file_name varchar null,
            docid varchar NULL,
            additional_auth_properties_actual_value text NULL,
            additional_auth_properties_extracted_value text NULL,
            additional_auth_properties_match_status varchar NULL,
            additional_auth_properties_mismatch_count int8 NULL,
            additional_auth_properties_classification varchar NULL,
            CONSTRAINT additional_auth_properties_result_primary PRIMARY KEY(id));


        CREATE TABLE IF NOT EXISTS ${COVERAGE_REPORT}.a_responsible_area_details_result_audit(
            id bigserial NOT null,
            root_pipeline_id int8 null,
            tenant_id int8 null,
            created_on timestamp null,
            origin_id varchar null,
            file_name varchar null,
            docid varchar NULL,
            responsible_area_actual_value text NULL,
            responsible_area_extracted_value text NULL,
            responsible_area_match_status varchar NULL,
            responsible_area_mismatch_count int8 NULL,
            responsible_area_classification varchar NULL,
            CONSTRAINT responsible_area_result_primary PRIMARY KEY(id));

        "} on-condition if "true"=="true"


        transform as "insert into the consolidated for member" on "intics_zio_db_conn" using
        {"


             create table ${temp_schema_name}.a_member_details_result_${init_process_id.process_id} as
             SELECT
                 ${root_pipeline_id} as root_pipeline_id,
                 ${tenant_id} as tenant_id,
                 now() as created_on,
                 '${origin_id}' as origin_id,
                 '${file_name}' as file_name,
                 a.docid,

                 d.actual_value AS member_zipcode_actual_value,
                 d.extracted_value AS member_zipcode_extracted_value,
                 d.match_status AS member_zipcode_match_status,
                 d.mismatch_count AS member_zipcode_mismatch_count,
                 d.classification AS member_zipcode_classification,

                 e.actual_value AS member_date_of_birth_actual_value,
                 e.extracted_value AS member_date_of_birth_extracted_value,
                 e.match_status AS member_date_of_birth_match_status,
                 e.mismatch_count AS member_date_of_birth_mismatch_count,
                 e.classification AS member_date_of_birth_classification,

                 f.actual_value AS member_first_name_actual_value,
                 f.extracted_value AS member_first_name_extracted_value,
                 f.match_status AS member_first_name_match_status,
                 f.mismatch_count AS member_first_name_mismatch_count,
                 f.classification AS member_first_name_classification,

                 g.actual_value AS member_gender_actual_value,
                 g.extracted_value AS member_gender_extracted_value,
                 g.match_status AS member_gender_match_status,
                 g.mismatch_count AS member_gender_mismatch_count,
                 g.classification AS member_gender_classification,

                 h.actual_value AS member_group_id_actual_value,
                 h.extracted_value AS member_group_id_extracted_value,
                 h.match_status AS member_group_id_match_status,
                 h.mismatch_count AS member_group_id_mismatch_count,
                 h.classification AS member_group_id_classification,

                 i.actual_value AS member_id_actual_value,
                 i.extracted_value AS member_id_extracted_value,
                 i.match_status AS member_id_match_status,
                 i.mismatch_count AS member_id_mismatch_count,
                 i.classification AS member_id_classification,

                 j.actual_value AS member_last_name_actual_value,
                 j.extracted_value AS member_last_name_extracted_value,
                 j.match_status AS member_last_name_match_status,
                 j.mismatch_count AS member_last_name_mismatch_count,
                 j.classification AS member_last_name_classification,

                 k.actual_value AS medicaid_id_actual_value,
                 k.extracted_value AS medicaid_id_extracted_value,
                 k.match_status AS medicaid_id_match_status,
                 k.mismatch_count AS medicaid_id_mismatch_count,
                 k.classification AS medicaid_id_classification,

                 l.actual_value AS member_city_actual_value,
                 l.extracted_value AS member_city_extracted_value,
                 l.match_status AS member_city_match_status,
                 l.mismatch_count AS member_city_mismatch_count,
                 l.classification AS member_city_classification,

                 m.actual_value AS member_state_actual_value,
                 m.extracted_value AS member_state_extracted_value,
                 m.match_status AS member_state_match_status,
                 m.mismatch_count AS member_state_mismatch_count,
                 m.classification AS member_state_classification,

                 n.actual_value AS member_address_line1_actual_value,
                 n.extracted_value AS member_address_line1_extracted_value,
                 n.match_status AS member_address_line1_match_status,
                 n.mismatch_count AS member_address_line1_mismatch_count,
                 n.classification AS member_address_line1_classification,

                 o.actual_value AS member_full_name_actual_value,
                 o.extracted_value AS member_full_name_extracted_value,
                 o.match_status AS member_full_name_match_status,
                 o.mismatch_count AS member_full_name_mismatch_count,
                 o.classification AS member_full_name_classification

             FROM ${coverage.report.input.data.table} a
             LEFT JOIN ${COVERAGE_REPORT}.member_zipcode_result d ON a.docid = d.file_name and d.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.member_date_of_birth_result e ON a.docid = e.file_name and e.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.member_first_name_result f ON a.docid = f.file_name and f.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.member_gender_result g ON a.docid = g.file_name and g.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.member_group_id_result h ON a.docid = h.file_name and h.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.member_id_result i ON a.docid = i.file_name and i.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.member_last_name_result j ON a.docid = j.file_name and j.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.medicaid_id_result k ON a.docid = k.file_name and k.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.member_city_result l ON a.docid = l.file_name and l.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.member_state_result m ON a.docid = m.file_name and m.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.member_address_line1_result n ON a.docid = n.file_name and n.root_pipeline_id=${root_pipeline_id}
             LEFT JOIN ${COVERAGE_REPORT}.member_full_name_result o ON a.docid = o.file_name and o.root_pipeline_id=${root_pipeline_id}
             WHERE a.docid ='${doc_id}'  AND (
                       d.file_name IS NOT NULL OR
                       e.file_name IS NOT NULL OR
                       f.file_name IS NOT NULL OR
                       g.file_name IS NOT NULL OR
                       h.file_name IS NOT NULL OR
                       i.file_name IS NOT NULL OR
                       j.file_name IS NOT NULL OR
                       k.file_name IS NOT NULL OR
                       l.file_name IS NOT NULL OR
                       m.file_name IS NOT NULL OR
                       n.file_name IS NOT NULL OR
                       o.file_name IS NOT NULL)
        "} on-condition if "true"=="true"


        transform as "insert into the consolidated for referring_provider" on "intics_zio_db_conn" using
        {"


             create table ${temp_schema_name}.a_referring_provider_details_result_${init_process_id.process_id} as
             SELECT
                 ${root_pipeline_id} as root_pipeline_id,
                 ${tenant_id} as tenant_id,
                 now() as created_on,
                 '${origin_id}' as origin_id,
                 '${file_name}' as file_name,
                 a.docid,

                 b.actual_value AS referring_provider_address_line1_actual_value,
