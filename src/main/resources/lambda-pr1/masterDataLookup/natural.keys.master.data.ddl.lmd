                    origin_id varchar NULL,
                    paper_no int4 NULL,
                    actual_value varchar NULL,
                    extracted_value text NULL,
                    similarity_score float4 NULL,
                    tenant_id int8 NULL
                    );


                    CREATE TABLE md_lookup_naturalkey.provider_name_integration (
