                    );


                    CREATE TABLE md_lookup_naturalkey.provider_sequencing_name_rank (
                    origin_id varchar NULL,
                    paper_no int4 NULL,
                    eoc_identifier varchar NULL,
                    sor_item_name varchar NULL,
                    extracted_value text NULL,
                    actual_value text NULL,
                    similarity float4 NULL,
