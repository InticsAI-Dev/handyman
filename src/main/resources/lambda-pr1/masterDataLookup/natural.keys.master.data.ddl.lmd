                    rank3_fax text NULL,
                    rank1_zip text NULL,
                    rank2_zip text NULL,
                    rank3_zip text NULL,
                    rank1_address text NULL,
                    rank2_address text NULL,
                    rank3_address text NULL
                    );


                    CREATE TABLE md_lookup_naturalkey.provider_name_rank (
                    origin_id varchar NULL,
                    paper_no int4 NULL,
                    sor_item_name varchar NULL,
                    extracted_value text NULL,
                    weight_rank int8 NULL,
                    tenant_id int8 NULL
                    );



                    CREATE TABLE md_lookup_naturalkey.provider_name_similarity_check (
                    origin_id varchar NULL,
                    paper_no int4 NULL,
