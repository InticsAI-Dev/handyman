                consumed_on_ts timestamp NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL,
                CONSTRAINT paper_classification_payload_queue_pk PRIMARY KEY (origin_id, group_id,tenant_id)
                );

                CREATE TABLE IF NOT EXISTS urgency_triage.ut_model_payload_queue (
                producer_process_id int8 NOT NULL,
                batch_id varchar NOT NULL,
                consumer_process_id int8 NULL,
                group_id int4 NOT NULL,
                origin_id varchar NOT NULL,
                created_on timestamp NULL,
                last_updated_on timestamp NULL,
                status varchar NULL,
                stage varchar NULL,
                consumed_on_ts timestamp NULL,
                root_pipeline_id int8 NULL,
                tenant_id int8 NULL,
                CONSTRAINT ut_model_payload_queue_pk PRIMARY KEY (origin_id, group_id,tenant_id)
                );


                CREATE TABLE if not exists paper.paper_filter_zsc_pm_input_aggregate_audit
                (
                        id bigserial NOT NULL,
                        tenant_id int8 NULL,
                        origin_id varchar NOT NULL,
                        paper_no int4 NOT NULL,
                        sor_item_attribution_id int4 NOT NULL,
                        truth_placeholder jsonb NOT NULL,
                        root_pipeline_id int8 NULL,
                        sub_batch_id varchar null,
                        batch_id varchar NOT NULL,
                        CONSTRAINT paper_filter_zsc_pm_input_aggregate_pkey PRIMARY KEY (id,tenant_id)
                );

                CREATE TABLE if not exists paper.paper_filter_zsc_pm_input_audit
                (
                        id bigserial NOT NULL,
                        created_on varchar NOT NULL,
                        created_user_id varchar NOT NULL,
                        last_updated_on varchar NULL,
                        last_updated_user_id varchar NULL,
                        tenant_id int8 NULL,
                        origin_id varchar NOT NULL,
                        paper_no int4 NOT NULL,
                        sor_item_attribution_id int4 NOT NULL,
                        truth_placeholders jsonb NOT NULL,
                        truth_entity varchar NOT NULL,
                        truth_entity_id int8 NOT NULL,
                        root_pipeline_id int8 NULL,
                        sub_batch_id varchar null,
                        batch_id varchar NOT NULL,
                        CONSTRAINT paper_filter_zsc_pm_input_pkey PRIMARY KEY (id,tenant_id)
                );


               CREATE TABLE IF NOT EXISTS currency_detection.currency_detection_payload_queue (
                 producer_process_id int8 NOT NULL,
                 batch_id varchar NOT NULL,
                 consumer_process_id int8 NULL,
                 group_id int4 NOT NULL,
                 origin_id varchar NOT NULL,
                 created_on timestamp NULL,
                 last_updated_on timestamp NULL,
                 status varchar NULL,
                 stage varchar NULL,
                 consumed_on_ts timestamp NULL,
                 root_pipeline_id int8 NULL,
                 tenant_id int8 NULL,
                 CONSTRAINT currency_detection_payload_queue_pk PRIMARY KEY (origin_id, group_id,tenant_id)
                );

        "} on-condition if "true"=="true"

        transform as "Final cummulative paper for the pipeline" on "intics_zio_db_conn" using {"
                CREATE TABLE IF NOT EXISTS ${temp_schema_name}.paper_filter_score_${init_process_id.process_id}  (
                        id bigserial NOT NULL,
                        origin_id varchar NULL,
                        sor_container_id int4 NULL,
                        sor_container_name varchar NULL,
                        truth_entity varchar NULL,
                        model_agg_score int8 NULL,
                        paper_no int4 NULL,
                        batch_id varchar NOT NULL,
                        tenant_id int8 NULL
                );

                CREATE TABLE IF NOT EXISTS paper.paper_filter_score_audit  (
                        id bigserial NOT NULL,
                        origin_id varchar NULL,
                        sor_container_id int4 NULL,
                        sor_container_name varchar NULL,
                        truth_entity varchar NULL,
                        model_agg_score int8 NULL,
                        paper_no int4 NULL,
                        tenant_id int8 NULL,
                        batch_id varchar NOT NULL,
                        root_pipeline_id int8 NULL
                );
        "} on-condition if "true"=="true"

        transform as "completed paper filtering ddl" on "intics_zio_db_conn" using
        {"

                INSERT INTO paper.paper_filtering_pipeline_audit
                (process_id, created_on, status, stage, message,root_pipeline_id, tenant_id)
                VALUES('${init_process_id.process_id}', now(), 'COMPLETED', 'PAPER_FILTER_DDL', 'DDL creation completed for paper filter','${gen_id.root_pipeline_id}', ${tenant_id});

        "} on-condition if "true"=="true"

        }

catch
 {
        transform as "failed in paper filtering ddl audit" on "intics_zio_db_conn" using
        {"

                INSERT INTO paper.paper_filtering_pipeline_audit
                (process_id, created_on, status, stage, message,root_pipeline_id, tenant_id)
                VALUES('${init_process_id.process_id}', now(), 'FAILED', 'PAPER_FILTER_DDL', 'DDL creation failes for paper filter','${gen_id.root_pipeline_id}', ${tenant_id});

        "} on-condition if "true"=="true"

 }

finally
{

}

}