package com.intics.script.MultiLineItem;

import org.slf4j.Logger;
import java.util.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class MedicaidMemberIdValidator {

    private Long rootPipelineId;

    private static final Pattern UM_PATTERN = Pattern.compile("^[uU][mM]\\d{8}$");
    private static final Pattern UM_INVALID_PATTERN = Pattern.compile("^[uU][mM][0-9]*$");
    private static final Pattern WITH_PARENTHESES = Pattern.compile("^([a-zA-Z0-9]+)(?:\\([^)]*\\))?$");
    private static final Pattern REGEX_ALL_ALPHA_PATTERN = Pattern.compile("^[A-Za-z]+$");

    private Logger logger;
    private List authIdCandidates;
    private List additionalAuthCandidates;

    public MedicaidMemberIdValidator(Logger logger) {
        this.logger = logger;
        this.authIdCandidates = new ArrayList();
        this.additionalAuthCandidates = new ArrayList();
    }

    /**
     * Updated to accept a List and return a List directly.
     */
    public List doCustomPredictionMapping(List inputs, Long rootPipelineId) {
        this.rootPipelineId = rootPipelineId;
        if (logger != null) logger.info("[RootPipelineID: " + rootPipelineId + "] Entered MedicaidMemberIdValidator doCustomPredictionMapping");

        if (inputs == null || inputs.isEmpty()) {
            if (logger != null) logger.error("[RootPipelineID: " + rootPipelineId + "] Input list is null or empty");
            return inputs;
        }

        // Process specific fields within the flat list
        processField(inputs, "member_id");
        processField(inputs, "medicaid_id");

        // Process Auth ID logic
        mapAuthIdAndAdditionalProperties(inputs);

        if (logger != null) logger.info("[RootPipelineID: " + rootPipelineId + "] Completed doCustomPredictionMapping");
        return inputs;
    }

    private void processField(List inputs, String fieldName) {
        for (Object obj : inputs) {
            in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput field =
                (in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput) obj;

            if (fieldName.equals(field.getSorItemName())) {
                String value = field.getAnswer() != null ? field.getAnswer().trim() : "";

                if (value.length() == 0) {
                    field.setAnswer("");
                    continue;
                }

                if (idSplitter(inputs, field, fieldName, value)) continue;

                // Single value processing
                value = cleanString(value);
                valueCheck(inputs, field, fieldName, value);
            }
        }
    }

    private boolean idSplitter(List inputs, in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput idInput, String fieldName, String value) {
        String[] parts = value.split("[/:]");
        if (parts.length > 1) {
            String firstPart = cleanString(parts[0]);
            String secondPart = cleanString(parts[1]);

            // First part check
            if (firstPart.toUpperCase().startsWith("UM")) {
                if (UM_PATTERN.matcher(firstPart).matches()) {
                    updateFieldInList(inputs, idInput, firstPart, "auth_id");
                    idInput.setAnswer("");
                } else if (UM_INVALID_PATTERN.matcher(firstPart).matches()) {
                    updateFieldInList(inputs, idInput, firstPart, "auth_id");
                } else {
                    idInput.setAnswer("");
                }
            } else {
                valueCheck(inputs, idInput, fieldName, firstPart);
                idInput.setAnswer(firstPart);
            }

            // Second part check
            if (secondPart.toUpperCase().startsWith("UM")) {
                if (UM_PATTERN.matcher(secondPart).matches()) {
                    updateFieldInList(inputs, idInput, secondPart, "auth_id");
                    authIdCandidates.add(secondPart);
                } else if (UM_INVALID_PATTERN.matcher(secondPart).matches()) {
                    updateFieldInList(inputs, idInput, secondPart, "auth_id");
                } else {
                    idInput.setAnswer("");
                }
            } else {
                updateMemberIdObj(inputs, "medicaid_id", firstPart);
            }
            return true;
        }
        return false;
    }

    private void valueCheck(List inputs, in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput medicaidIdInput, String fieldName, String value) {
        Matcher parenMatcher = WITH_PARENTHESES.matcher(value);
        if (parenMatcher.find()) {
            value = parenMatcher.group(1);
        }

        if (value.toUpperCase().startsWith("UM")) {
            if (UM_PATTERN.matcher(value).matches()) {
                updateFieldInList(inputs, medicaidIdInput, value, "auth_id");
            } else if (UM_INVALID_PATTERN.matcher(value).matches()) {
                updateFieldInList(inputs, medicaidIdInput, value, "auth_id");
            }
            medicaidIdInput.setAnswer("");
            return;
        }

        if (value.length() > 20 && !REGEX_ALL_ALPHA_PATTERN.matcher(value).matches()) {
            medicaidIdInput.setAnswer(value.substring(0, 20));
        } else if (REGEX_ALL_ALPHA_PATTERN.matcher(value).matches()) {
            medicaidIdInput.setAnswer("");
        } else {
            medicaidIdInput.setAnswer(value);
        }
    }

    private void mapAuthIdAndAdditionalProperties(List inputs) {
        // Collect candidates from existing auth_id fields
        for (Object obj : inputs) {
            in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput authIdInput =
                (in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput) obj;

            if ("auth_id".equals(authIdInput.getSorItemName())) {
                String authId = authIdInput.getAnswer() != null ? cleanString(authIdInput.getAnswer()) : null;
                if (authId != null && authId.length() != 0) {
                    if (UM_PATTERN.matcher(authId).matches()) {
                        authIdCandidates.add(authId);
                    } else if (UM_INVALID_PATTERN.matcher(authId).matches()) {
                        additionalAuthCandidates.add(authId);
                    }
                }
            }
        }

        // Apply logic to the primary auth_id and additional properties fields
        List allAdditionalAuth = new ArrayList(additionalAuthCandidates);
        String finalAuthId = "";
        String finalAdditional = "";

        if (!authIdCandidates.isEmpty()) {
            finalAuthId = (String) authIdCandidates.get(0);
            if (authIdCandidates.size() > 1) {
                for (int i = 1; i < authIdCandidates.size(); i++) {
                    allAdditionalAuth.add(authIdCandidates.get(i));
                }
            }
        }

        if (!allAdditionalAuth.isEmpty()) {
            StringBuffer sb = new StringBuffer();
            for (int i = 0; i < allAdditionalAuth.size(); i++) {
                sb.append(allAdditionalAuth.get(i));
                if (i < allAdditionalAuth.size() - 1) sb.append(",");
            }
            finalAdditional = sb.toString();
        }

        // Update the list with consolidated values
        updateStaticField(inputs, "auth_id", finalAuthId);
        updateStaticField(inputs, "additional_auth_properties", finalAdditional);
    }

    private String cleanString(String str) {
        if (str == null || str.trim().length() == 0) return "";
        str = str.trim();
        int parantheseIndex = str.indexOf('(');
        if (parantheseIndex != -1) str = str.substring(0, parantheseIndex);
        return str.replaceAll("[^a-zA-Z0-9]", "");
    }

    private void updateMemberIdObj(List inputs, String fieldName, String value) {
        for (Object obj : inputs) {
            in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput field =
                (in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput) obj;
            if (fieldName.equals(field.getSorItemName())) {
                field.setAnswer(value);
            }
        }
    }

    private void updateFieldInList(List inputs, in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput source, String value, String targetFieldName) {
        // Find the target field in the list and update it
        for (Object obj : inputs) {
            in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput field =
                (in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput) obj;
            if (targetFieldName.equals(field.getSorItemName())) {
                field.setAnswer(value);
                // Copy metadata if necessary
                field.setBBox(source.getBBox());
                field.setSectionAlias(source.getSectionAlias());
            }
        }
    }

    private void updateStaticField(List inputs, String fieldName, String value) {
        for (Object obj : inputs) {
            in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput field =
                (in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput) obj;
            if (fieldName.equals(field.getSorItemName())) {
                field.setAnswer(value);
            }
        }
    }
}