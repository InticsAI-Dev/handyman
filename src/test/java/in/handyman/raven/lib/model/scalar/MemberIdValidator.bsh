import org.slf4j.Logger;
import java.util.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class MemberIdValidator {

    private Long rootPipelineId;

    private static final Pattern UM_PATTERN = Pattern.compile("^[uU][mM]\\d{8}$");
    private static final Pattern UM_INVALID_PATTERN = Pattern.compile("^[uU][mM][0-9]*$");
    private static final Pattern WITH_PARENTHESES = Pattern.compile("^([a-zA-Z0-9]+)(?:\\([^)]*\\))?$");
    private static final Pattern REGEX_ALL_ALPHA_PATTERN = Pattern.compile("^[A-Za-z]+$");

    private Logger logger;
    private List authIdCandidates;
    private List additionalAuthCandidates;

    public MemberIdValidator(Logger logger) {
        this.logger = logger;
        this.authIdCandidates = new ArrayList();
        this.additionalAuthCandidates = new ArrayList();
    }

    /**
     * Updated to accept a List and return a List directly.
     */
    public List doCustomPredictionMapping(List predictionKeyMap, Long rootPipelineId) {
        this.rootPipelineId = rootPipelineId;
        if (logger != null) logger.info("[RootPipelineID: " + rootPipelineId + "] Entered MemberIdValidator doCustomPredictionMapping");

        if (predictionKeyMap == null || predictionKeyMap.size() == 0) {
            if (logger != null) logger.error("[RootPipelineID: " + rootPipelineId + "] Input list is null or empty");
            return predictionKeyMap;
        }

        // Process field logic (formerly Map-based, now List-based)
        processField(predictionKeyMap, "member_id");

        // Map Auth IDs and Additional Properties
        mapAuthIdAndAdditionalProperties(predictionKeyMap);

        if (logger != null) logger.info("[RootPipelineID: " + rootPipelineId + "] Completed doCustomPredictionMapping");
        return predictionKeyMap;
    }

private void processField(List predictionKeyMap, String fieldName) {
    // Create a copy of the list for iteration to avoid ConcurrentModificationException
    List iterationList = new ArrayList(predictionKeyMap);

    for (Object obj : iterationList) {
        in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput field =
            (in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput) obj;

        if (fieldName.equals(field.getSorItemName())) {
            String value = field.getAnswer() != null ? field.getAnswer().trim() : "";

            if (value.length() == 0) {
                field.setAnswer("");
                continue;
            }

            String[] parts = value.split("[/:]");
            if (parts.length > 1) {
                String firstPart = cleanString(parts[0]);
                String secondPart = cleanString(parts[1]);

                if (firstPart.toUpperCase().startsWith("UM")) {
                    if (UM_PATTERN.matcher(firstPart).matches()) {
                        // This adds to the ORIGINAL list, not the iterationList
                        objAuthIdListUpdate(predictionKeyMap, field, firstPart, "auth_id");
                    }
                    updateMemberIdObj(predictionKeyMap, "member_id", "");
                } else {
                    valueCheck(predictionKeyMap, field, fieldName, firstPart);
                    updateMemberIdObj(predictionKeyMap, "member_id", firstPart);
                }

                if (secondPart.toUpperCase().startsWith("UM")) {
                    if (UM_PATTERN.matcher(secondPart).matches() || UM_INVALID_PATTERN.matcher(secondPart).matches()) {
                        objAuthIdListUpdate(predictionKeyMap, field, secondPart, "auth_id");
                    }
                }
                // Return or break here if you only expect one member_id field
                return;
            }
            value = cleanString(value);
            valueCheck(predictionKeyMap, field, fieldName, value);
        }
    }
}

    private void updateMemberIdObj(List predictionKeyMap, String fieldName, String value) {
    in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput templateField = null;
        for (Object obj : predictionKeyMap) {
            in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput input =
                (in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput) obj;
            if (fieldName.equals(input.getSorItemName())) {
            templateField = input;
             break;
            }
        }

        if (templateField != null) {

                // Copy data and spatial metadata from the source
                templateField.setAnswer(value);
                templateField.setBBox(source.getBBox());
                templateField.setSectionAlias(source.getSectionAlias());
                templateField.setLabel(source.getLabel());

                // Add to the list outside the iteration to prevent ConcurrentModificationException
                predictionKeyMap.add(templateField);

                if (logger != null) {
                    logger.info("[RootPipelineID: " + rootPipelineId + "] Successfully cloned and added: " + targetFieldName);
                }
            } else {
                if (logger != null) {
                    logger.warn("[RootPipelineID: " + rootPipelineId + "] Target field '" + targetFieldName + "' not found in list to clone.");
                }
            }
    }
private void objAuthIdListUpdate(List predictionKeyMap, in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput source, String value, String targetFieldName) {

    in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput templateField = null;

    // 1. Find the blueprint/template for the target field
    for (Object obj : predictionKeyMap) {
        in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput current =
            (in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput) obj;

        if (targetFieldName.equals(current.getSorItemName())) {
            templateField = current;
            break; // Found the template, exit loop
        }
    }

    // 2. If we found a template, clone it and add it
    if (templateField != null) {

        // Copy framework identifiers from template
        templateField.setSorItemName(targetFieldName);

        // Copy data and spatial metadata from the source
        templateField.setAnswer(value);
        templateField.setBBox(source.getBBox());
        templateField.setSectionAlias(source.getSectionAlias());
        templateField.setLabel(source.getLabel());

        // Add to the list outside the iteration to prevent ConcurrentModificationException
        predictionKeyMap.add(templateField);

        if (logger != null) {
            logger.info("[RootPipelineID: " + rootPipelineId + "] Successfully cloned and added: " + targetFieldName);
        }
    } else {
        if (logger != null) {
            logger.warn("[RootPipelineID: " + rootPipelineId + "] Target field '" + targetFieldName + "' not found in list to clone.");
        }
    }
}

    private void valueCheck(List predictionKeyMap, in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput inputObj, String fieldName, String value) {
        Matcher parenMatcher = WITH_PARENTHESES.matcher(value);
        if (parenMatcher.find()) {
            value = parenMatcher.group(1);
        }

        if (value.toUpperCase().startsWith("UM")) {
            if (UM_PATTERN.matcher(value).matches()) {
                objAuthIdListUpdate(predictionKeyMap, inputObj, value, "auth_id");
            } else if (UM_INVALID_PATTERN.matcher(value).matches()) {
                objAuthIdListUpdate(predictionKeyMap, inputObj, value, "auth_id");
            }
            inputObj.setAnswer("");
            return;
        }

        if (value.length() > 20 && !REGEX_ALL_ALPHA_PATTERN.matcher(value).matches()) {
            inputObj.setAnswer(value.substring(0, 20));
        } else if (REGEX_ALL_ALPHA_PATTERN.matcher(value).matches()) {
            inputObj.setAnswer("");
        } else {
            inputObj.setAnswer(value);
        }
    }

    private void mapAuthIdAndAdditionalProperties(List predictionKeyMap) {
        // Collect candidates
        for (Object obj : predictionKeyMap) {
            in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput field =
                (in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput) obj;

            if ("auth_id".equals(field.getSorItemName())) {
                String authId = field.getAnswer() != null ? cleanString(field.getAnswer()) : null;
                if (authId != null && authId.length() != 0) {
                    if (UM_PATTERN.matcher(authId).matches()) {
                        authIdCandidates.add(authId);
                    } else if (UM_INVALID_PATTERN.matcher(authId).matches()) {
                        additionalAuthCandidates.add(authId);
                    }
                }
            }
        }

        List allAdditionalAuth = new ArrayList(additionalAuthCandidates);
        String finalAuthId = "";
        String finalAdditional = "";

        if (authIdCandidates.size() > 0) {
            finalAuthId = (String) authIdCandidates.get(0);
            if (authIdCandidates.size() > 1) {
                for (int i = 1; i < authIdCandidates.size(); i++) {
                    allAdditionalAuth.add(authIdCandidates.get(i));
                }
            }
        }

        if (allAdditionalAuth.size() > 0) {
            StringBuffer sb = new StringBuffer();
            for (int i = 0; i < allAdditionalAuth.size(); i++) {
                sb.append(allAdditionalAuth.get(i));
                if (i < allAdditionalAuth.size() - 1) sb.append(",");
            }
            finalAdditional = sb.toString();
        }

        // Apply back to the flat list
        updateMemberIdObj(predictionKeyMap, "auth_id", finalAuthId);
        updateMemberIdObj(predictionKeyMap, "additional_auth_properties", finalAdditional);
    }

    private String cleanString(String str) {
        if (str == null || str.trim().length() == 0) return "";
        str = str.trim();
        int parantheseIndex = str.indexOf('(');
        if (parantheseIndex != -1) str = str.substring(0, parantheseIndex);
        return str.replaceAll("[^a-zA-Z0-9]", "");
    }
}