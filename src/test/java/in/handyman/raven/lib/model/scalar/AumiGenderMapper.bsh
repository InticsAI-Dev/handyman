import org.slf4j.Logger;
import java.util.List;

public class AumiGenderMapper {

    private Logger logger;

    public AumiGenderMapper(Logger logger) {
        this.logger = logger;
    }

    /**
     * Now returns a List directly to simplify host-side processing.
     */
    public List doCustomPredictionMapping(List inputs, Long rootPipelineId) {
        String logMsg = "[RootPipelineID: " + rootPipelineId + "] Entered AumiGenderMapper doCustomPredictionMapping method";
        logger.info(logMsg);

        if (inputs == null || inputs.isEmpty()) {
            return inputs;
        }

        // Iterate through the list to find the "member_gender" item
        for (Object obj : inputs) {
            // Using Fully Qualified Name for the framework class to prevent ClassNotFound errors
            in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput field =
                (in.handyman.raven.lib.services.sor.transform.PostProcessingFieldsInput) obj;

            if ("member_gender".equals(field.getSorItemName())) {
                String rawValue = field.getAnswer(); // Changed from getExtractedValue
                String validatedGenderValue = normalizeGender(rawValue);

                field.setAnswer(validatedGenderValue); // Changed from setExtractedValue

                logger.info("[RootPipelineID: " + rootPipelineId + "] Normalized gender for "
                            + field.getSorItemName() + " from '" + rawValue + "' to '" + validatedGenderValue + "'");
            }
        }

        // Return the original modified list
        return inputs;
    }

    public String normalizeGender(String gender) {
        if (gender == null) {
            return "";
        }

        gender = gender.trim().toLowerCase();
        switch (gender) {
            case "m":
            case "male":
                return "M";
            case "f":
            case "female":
                return "F";
            default:
                return "";
        }
    }
}